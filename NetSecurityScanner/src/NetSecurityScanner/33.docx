<tr>
<td style='text-align: center; font-weight: bold;'>3</td>
<td><span class='risk-medium'>中风险</span></td>
<td>7天内</td>
<td>纳入常规维护计划</td></tr>
<tr>
<td style='text-align: center; font-weight: bold;'>4</td>
<td><span class='risk-low'>低风险</span></td>
<td>30天内</td>
<td>计划内修复，定期复查</td></tr>
</table>
