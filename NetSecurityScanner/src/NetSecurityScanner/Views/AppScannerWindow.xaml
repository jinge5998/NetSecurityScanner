<Window x:Class="NetSecurityScanner.Views.AppScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APP安全扫描"
        Width="1100" Height="850"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <!-- 风险等级颜色转换器 -->
        <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2C3E50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题区域 -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="8" Padding="20,15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="APP安全扫描" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="支持Android APK / iOS IPA / 小程序" FontSize="13" Foreground="#BDC3C7" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- 文件选择区域 -->
        <GroupBox Grid.Row="1" Header="文件选择" Style="{StaticResource StyledGroupBox}" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="应用文件:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <TextBox x:Name="FilePathTextBox" Grid.Column="1" IsReadOnly="True"
                             Text="请选择或拖拽APK/IPA/小程序文件..." Foreground="Gray"
                             FontSize="13" Padding="5" AllowDrop="True"
                             DragOver="FilePathTextBox_DragOver" Drop="FilePathTextBox_Drop"/>
                    <Button x:Name="SelectFileButton" Grid.Column="2" Content="选择文件"
                            Padding="20,8" Margin="10,0,0,0" Click="SelectFile_Click"
                            Background="#3498DB" Foreground="White" FontWeight="Bold"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,25,0">
                        <TextBlock Text="文件类型:" VerticalAlignment="Center" Foreground="#7F8C8D" Margin="0,0,5,0"/>
                        <TextBlock x:Name="FileTypeText" Text="未选择" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,25,0">
                        <TextBlock Text="文件大小:" VerticalAlignment="Center" Foreground="#7F8C8D" Margin="0,0,5,0"/>
                        <TextBlock x:Name="FileSizeText" Text="未选择" VerticalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="支持拖拽文件到上方文本框" VerticalAlignment="Center"
                               Foreground="Gray" FontSize="11" FontStyle="Italic"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- 扫描配置区域 -->
        <GroupBox Grid.Row="2" Header="扫描配置" Style="{StaticResource StyledGroupBox}" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="扫描类型:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                <ComboBox x:Name="ScanTypeComboBox" Grid.Column="1" Width="200" Padding="5" FontSize="13">
                    <ComboBoxItem Content="闪电扫描" IsSelected="True"/>
                    <ComboBoxItem Content="标准扫描"/>
                    <ComboBoxItem Content="深度扫描"/>
                    <ComboBoxItem Content="全面扫描"/>
                </ComboBox>
                <TextBlock Grid.Column="2"/>
                <Button x:Name="StartScanButton" Grid.Column="3" Content="开始扫描"
                        Padding="25,10" Margin="10,0,0,0" Click="StartScan_Click"
                        Background="#2ECC71" Foreground="White" FontWeight="Bold"/>
                <Button x:Name="StopScanButton" Grid.Column="4" Content="停止扫描"
                        Padding="25,10" Margin="10,0,0,0" Click="StopScan_Click"
                        IsEnabled="False" Background="#E74C3C" Foreground="White"/>
            </Grid>
        </GroupBox>

        <!-- 扫描进度区域 -->
        <Border Grid.Row="3" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ScanStatusText" Text="状态: 就绪" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock x:Name="ScanProgressText" Text="0%" Grid.Column="2" VerticalAlignment="Center" FontWeight="Bold"/>
                </Grid>
                <ProgressBar x:Name="ScanProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                             Foreground="#2ECC71" Background="#E9ECEF"/>
            </StackPanel>
        </Border>

        <!-- 扫描结果区域 -->
        <TabControl Grid.Row="4">
            <TabItem Header="漏洞列表">
                <DataGrid x:Name="VulnerabilityDataGrid" AutoGenerateColumns="False"
                          IsReadOnly="True" AlternatingRowBackground="#F8F9FA"
                          GridLinesVisibility="Horizontal" BorderThickness="0"
                          HeadersVisibility="Column" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserResizeRows="False">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource DataGridCellStyle}"/>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="漏洞名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="风险等级" Binding="{Binding RiskLevel}" Width="100"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="150"/>
                        <DataGridTextColumn Header="位置" Binding="{Binding Location}" Width="200"/>
                        <DataGridTextColumn Header="CVSS评分" Binding="{Binding CvssScore}" Width="100"/>
                        <DataGridTextColumn Header="修复建议" Binding="{Binding Suggestion}" Width="250"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="扫描日志">
                <TextBox x:Name="ScanLogTextBox" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" FontFamily="Consolas"
                         FontSize="12" Background="#1E1E1E" Foreground="#D4D4D4"
                         Padding="10"/>
            </TabItem>
        </TabControl>

        <!-- 底部操作区域 -->
        <Border Grid.Row="5" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ExportReportButton" Grid.Column="0" Content="导出报告"
                        Padding="20,10" Click="ExportReport_Click"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <Ellipse Width="12" Height="12" Fill="#E74C3C" Margin="0,0,5,0"/>
                        <TextBlock Text="高危:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="HighCountText" Text="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E74C3C"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <Ellipse Width="12" Height="12" Fill="#F39C12" Margin="0,0,5,0"/>
                        <TextBlock Text="中危:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="MediumCountText" Text="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#F39C12"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="12" Height="12" Fill="#3498DB" Margin="0,0,5,0"/>
                        <TextBlock Text="低危:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="LowCountText" Text="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#3498DB"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
