<Window x:Class="NetSecurityScanner.Views.WebPathTracerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="网页路径追踪 - 多层深度探测"
        Width="1050" Height="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="目标配置" Grid.Row="0" Margin="0,0,0,10" Padding="10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="目标URL:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <TextBox x:Name="TargetUrlTextBox" Grid.Column="1"
                             Text="http://" FontSize="14" Padding="5"/>
                    <Button x:Name="StartTraceButton" Grid.Column="2" Content="🔍 追踪"
                            Padding="15,8" Margin="10,0,0,0" Click="StartTrace_Click"
                            Background="#2C3E50" Foreground="White" FontWeight="Bold"/>
                    <Button x:Name="StopTraceButton" Grid.Column="3" Content="⏹ 停止"
                            Padding="15,8" Margin="10,0,0,0" Click="StopTrace_Click"
                            IsEnabled="False" Background="#E74C3C" Foreground="White"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="追踪模式:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <RadioButton x:Name="ModeQuickRadio" Content="快速" VerticalAlignment="Center"
                                 Margin="0,0,20,0" GroupName="TraceMode"/>
                    <RadioButton x:Name="ModeStandardRadio" Content="标准" IsChecked="True"
                                 VerticalAlignment="Center" Margin="0,0,20,0" GroupName="TraceMode"/>
                    <RadioButton x:Name="ModeDeepRadio" Content="深度" VerticalAlignment="Center"
                                 GroupName="TraceMode"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox x:Name="EnableSeleniumCheckBox" Content="Selenium动态检测"
                              IsChecked="True" VerticalAlignment="Center" Margin="0,0,25,0"/>
                    <CheckBox x:Name="EnableBruteCheckBox" Content="目录爆破"
                              IsChecked="True" VerticalAlignment="Center" Margin="0,0,25,0"/>
                    <CheckBox x:Name="EnableCrawlCheckBox" Content="深度爬取"
                              IsChecked="True" VerticalAlignment="Center" Margin="0,0,25,0"/>
                    <CheckBox x:Name="SameDomainOnlyCheckBox" Content="仅同域"
                              IsChecked="True" VerticalAlignment="Center"/>
                </StackPanel>

                <ProgressBar x:Name="ScanProgressBar" Height="6" Minimum="0" Maximum="100" Value="0"
                             Margin="0,0,0,5" Foreground="#2C3E50"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="并发数:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Slider x:Name="ConcurrencySlider" Minimum="1" Maximum="50" Value="10"
                            VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                            TickPlacement="BottomRight" Grid.Column="1"/>
                    <TextBlock x:Name="ConcurrencyValueText" Text="10" VerticalAlignment="Center"
                               Margin="8,0,0,0" Grid.Column="2" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3"/>
                    <TextBlock Text="爬取深度:" VerticalAlignment="Center" Margin="20,0,8,0" Grid.Column="4"/>
                    <Slider x:Name="CrawlDepthSlider" Minimum="1" Maximum="5" Value="2"
                            VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                            TickPlacement="BottomRight" Grid.Column="5"/>
                    <TextBlock x:Name="CrawlDepthValueText" Text="2" VerticalAlignment="Center"
                               Margin="8,0,0,0" Grid.Column="6" FontWeight="Bold"/>
                </Grid>

                <TextBlock x:Name="ChromeStatusText" Text="Chrome状态: 检测中..."
                           VerticalAlignment="Center" Margin="0,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <TabControl Grid.Row="1">
            <TabItem Header="📋 实时日志">
                <TextBox x:Name="LogTextBox" IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="Wrap" FontFamily="Consolas"
                         FontSize="12" Background="#1E1E1E" Foreground="#D4D4D4"
                         Padding="10"/>
            </TabItem>

            <TabItem Header="1️⃣ HTTP重定向">
                <ScrollViewer>
                    <StackPanel x:Name="Layer1Panel" Margin="10">
                        <TextBlock Text="等待探测..." Foreground="Gray"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="2️⃣ HTML/JS分析">
                <ScrollViewer>
                    <StackPanel x:Name="Layer2Panel" Margin="10">
                        <TextBlock Text="等待探测..." Foreground="Gray"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="3️⃣ 敏感文件">
                <ScrollViewer>
                    <StackPanel x:Name="Layer3Panel" Margin="10">
                        <TextBlock Text="等待探测..." Foreground="Gray"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="4️⃣ Selenium动态">
                <ScrollViewer>
                    <StackPanel x:Name="Layer4Panel" Margin="10">
                        <TextBlock Text="等待探测..." Foreground="Gray"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="5️⃣ 目录爆破">
                <ScrollViewer>
                    <StackPanel x:Name="BrutePanel" Margin="10">
                        <TextBlock Text="等待探测..." Foreground="Gray"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="6️⃣ 后缀探测">
                <ScrollViewer>
                    <StackPanel x:Name="SuffixProbePanel" Margin="10">
                        <TextBlock Text="等待探测..." Foreground="Gray"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="7️⃣ 深度爬取">
                <ScrollViewer>
                    <StackPanel x:Name="CrawlPanel" Margin="10">
                        <TextBlock Text="等待探测..." Foreground="Gray"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="🎯 汇总结果">
                <ScrollViewer>
                    <StackPanel x:Name="FinalResultPanel" Margin="10">
                        <TextBlock Text="等待探测完成..." Foreground="Gray"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center"/>
            <TextBlock Text=" | " VerticalAlignment="Center" Foreground="Gray"/>
            <TextBlock x:Name="PathCountText" Text="发现: 0条路径" VerticalAlignment="Center"/>
            <TextBlock Text=" | " VerticalAlignment="Center" Foreground="Gray"/>
            <TextBlock x:Name="ElapsedTimeText" Text="耗时: 0s" VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
