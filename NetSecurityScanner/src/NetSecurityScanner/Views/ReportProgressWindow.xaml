<Window x:Class="NetSecurityScanner.Views.Views.ReportProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在生成报告..." Height="200" Width="500"
        WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow"
        Background="#F5F5F5" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="TitleText" Text="📑 正在生成报告..." 
                  FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

        <ProgressBar Grid.Row="1" Name="ProgressBar" Height="25" 
                    Minimum="0" Maximum="100" Value="0" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="2" Name="StatusText" Text="准备中..." 
                  FontSize="13" Foreground="#7F8C8D" TextAlignment="Center"/>
    </Grid>
</Window>
