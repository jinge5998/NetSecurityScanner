<Window x:Class="NetSecurityScanner.Views.DnsResolverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔍 域名解析" Height="450" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="#3498DB" CornerRadius="4" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="🔍 域名解析工具" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="将域名解析为IP地址（支持IPv4和IPv6）" FontSize="12" Foreground="#D6EAF8" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <Label Content="域名：" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBox Name="DomainTextBox" Width="350" Height="30" FontSize="14" 
                         ToolTip="输入要解析的域名，如：example.com"/>
                <Button Name="ResolveButton" Content="解析" Width="80" Height="30" Margin="10,0,0,0"
                        Background="#3498DB" Foreground="White" FontWeight="Bold" Click="ResolveButton_Click"/>
            </StackPanel>
        </StackPanel>
        
        <GroupBox Grid.Row="2" Header="解析结果" Margin="0,0,0,15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                    <TextBlock Name="ResultCountText" Text="0 个IP地址" FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <Button Name="CopyAllButton" Content="复制全部" Width="80" Height="25" Margin="15,0,0,0"
                            Background="#27AE60" Foreground="White" Click="CopyAllButton_Click" IsEnabled="False"/>
                </StackPanel>
                
                <DataGrid Grid.Row="1" Name="ResultsDataGrid" Margin="5" 
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          IsReadOnly="True" SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8F9FA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IP地址" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80"/>
                        <DataGridTextColumn Header="地址族" Binding="{Binding AddressFamily}" Width="80"/>
                        <DataGridTemplateColumn Header="操作" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="复制" Click="CopySingle_Click" Tag="{Binding Address}"
                                            Background="#95A5A6" Foreground="White" Height="22"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                
                <TextBlock Grid.Row="1" Name="EmptyMessage" Text="输入域名并点击&quot;解析&quot;按钮获取结果" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#7F8C8D" FontStyle="Italic" Visibility="Visible"/>
            </Grid>
        </GroupBox>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="CloseButton" Content="关闭" Width="100" Height="35"
                    Background="#95A5A6" Foreground="White" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
