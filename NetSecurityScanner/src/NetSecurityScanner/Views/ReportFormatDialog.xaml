<Window x:Class="NetSecurityScanner.Views.Views.ReportFormatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📑 报告生成选项" Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="4" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📑 扫描报告生成" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Name="SubTitleText" Text="为目标生成专业扫描报告" FontSize="12" Foreground="#BDC3C7" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- 选项内容 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 报告格式选择 -->
                <GroupBox Header="📄 报告格式" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <RadioButton Name="PdfRadio" Content="📕 PDF 报告（专业排版，适合打印/归档）" 
                                    IsChecked="True" Margin="0,5" FontSize="13"/>
                        <RadioButton Name="WordRadio" Content="📘 Word 文档（可编辑，适合二次修改）" 
                                    Margin="0,5" FontSize="13"/>
                        <RadioButton Name="HtmlRadio" Content="🌐 HTML 网页（可在浏览器中查看/分享）" 
                                    Margin="0,5" FontSize="13"/>
                    </StackPanel>
                </GroupBox>

                <!-- 报告内容 -->
                <GroupBox Header="📋 报告内容" Padding="15" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" Name="ExecutiveSummaryCheck" 
                                 Content="执行摘要" IsChecked="True" Margin="5"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" Name="VulnerabilityListCheck" 
                                 Content="漏洞详细信息" IsChecked="True" Margin="5"/>

                        <CheckBox Grid.Row="1" Grid.Column="0" Name="RemediationCheck" 
                                 Content="修复建议" IsChecked="True" Margin="5"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" Name="StatisticsCheck" 
                                 Content="统计分析" IsChecked="True" Margin="5"/>

                        <CheckBox Grid.Row="2" Grid.Column="0" Name="ChartsCheck" 
                                 Content="图表展示" IsChecked="True" Margin="5"/>
                        <CheckBox Grid.Row="2" Grid.Column="1" Name="AppendixCheck" 
                                 Content="附录信息" IsChecked="True" Margin="5"/>
                    </Grid>
                </GroupBox>

                <!-- 自定义信息 -->
                <GroupBox Header="🏢 自定义信息" Padding="15" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="公司名称：" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Name="CompanyNameTextBox" 
                                Text="徐州鸿高电子科技有限公司" Padding="5" Margin="5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="报告类型：" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Name="ReportTypeTextBox" 
                                Text="网络安全扫描报告" Padding="5" Margin="5"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="密级：" VerticalAlignment="Center" Margin="0,5"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" Name="ConfidentialCombo" Margin="5" Padding="5">
                            <ComboBoxItem Content="公开"/>
                            <ComboBoxItem Content="内部"/>
                            <ComboBoxItem Content="机密" IsSelected="True"/>
                            <ComboBoxItem Content="绝密"/>
                        </ComboBox>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="报告作者：" VerticalAlignment="Center" Margin="0,5"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Name="AuthorNameTextBox" 
                                Text="NetSecurity Scanner" Padding="5" Margin="5"/>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="OkButton" Content="✅ 确定生成" Click="Ok_Click" 
                   MinWidth="120" Height="40" Margin="5" 
                   Background="#27AE60" Foreground="White" FontWeight="Bold"/>
            <Button Name="CancelButton" Content="❌ 取消" Click="Cancel_Click" 
                   MinWidth="100" Height="40" Margin="5" 
                   Background="#95A5A6" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
