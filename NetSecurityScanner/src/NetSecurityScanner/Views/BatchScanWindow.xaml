<Window x:Class="NetSecurityScanner.Views.BatchScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量扫描" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <Border Grid.Row="0" Background="#9B59B6" CornerRadius="4" Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🚀 批量扫描" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="同时扫描多个目标，支持IP段、CIDR和文件导入" FontSize="12" Foreground="#E8DAEF" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- 配置区域 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧：目标配置 -->
            <Border Grid.Column="0" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Margin="0,0,5,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="🎯 扫描目标配置" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    
                    <Label Content="目标类型：" FontWeight="SemiBold"/>
                    <ComboBox Name="BatchTargetTypeComboBox" Height="25" Margin="0,0,0,10" SelectionChanged="BatchTargetTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="IP 段范围" Tag="Range"/>
                        <ComboBoxItem Content="CIDR 网段" Tag="CIDR"/>
                        <ComboBoxItem Content="从文件导入" Tag="File"/>
                        <ComboBoxItem Content="手动输入列表" Tag="List"/>
                    </ComboBox>
                    
                    <Label Content="目标值：" FontWeight="SemiBold"/>
                    <TextBox Name="BatchTargetValueTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Margin="0,0,0,5"/>
                    <TextBlock Name="BatchTargetHintTextBlock" Text="提示：输入IP段，如 192.168.1.1-192.168.1.254" 
                               FontSize="10" Foreground="#7F8C8D" Margin="0,0,0,10"/>
                    
                    <Button Name="ImportFileButton" Content="📁 导入目标文件" Height="30" Margin="0,0,0,10" 
                            Background="#3498DB" Foreground="White" Click="ImportFileButton_Click"/>
                    
                    <StackPanel Orientation="Horizontal">
                        <Button Name="ParseTargetsButton" Content="🔍 解析目标" Width="120" Height="30" Margin="0,0,10,0"
                                Background="#27AE60" Foreground="White" Click="ParseTargetsButton_Click"/>
                        <TextBlock Name="ParsedTargetCountTextBlock" Text="已解析: 0 个目标" 
                                   VerticalAlignment="Center" Foreground="#27AE60" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            
            <!-- 右侧：扫描配置 -->
            <Border Grid.Column="1" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Margin="5,0,0,0" Padding="10">
                <StackPanel>
                    <TextBlock Text="⚙️ 扫描参数配置" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    
                    <Label Content="扫描模式：" FontWeight="SemiBold"/>
                    <ComboBox Name="BatchScanModeComboBox" Height="25" Margin="0,0,0,10" SelectedIndex="1">
                        <ComboBoxItem Content="⚡ 闪电扫描" Tag="Lightning"/>
                        <ComboBoxItem Content="🔍 标准扫描" Tag="Standard"/>
                        <ComboBoxItem Content="🔬 深度扫描" Tag="Deep"/>
                    </ComboBox>
                    
                    <Label Content="并发数：" FontWeight="SemiBold"/>
                    <Slider Name="ConcurrencySlider" Minimum="1" Maximum="50" Value="10" 
                            TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>
                    <TextBlock Name="ConcurrencyValueTextBlock" Text="10" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    
                    <Label Content="超时时间（秒）：" FontWeight="SemiBold"/>
                    <Slider Name="TimeoutSlider" Minimum="5" Maximum="60" Value="10" 
                            TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>
                    <TextBlock Name="TimeoutValueTextBlock" Text="10秒" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    
                    <CheckBox Name="AutoSaveResultsCheckBox" Content="自动保存扫描结果" IsChecked="True" Margin="0,5,0,5"/>
                    <CheckBox Name="GenerateReportCheckBox" Content="扫描完成后生成报告" IsChecked="True" Margin="0,5,0,5"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- 扫描结果区域 -->
        <Border Grid.Row="2" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- 进度条 -->
                <Border Grid.Row="0" Background="#ECF0F1" Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Name="BatchScanStatusTextBlock" Text="准备就绪" FontWeight="SemiBold" Width="300"/>
                            <TextBlock Name="BatchScanProgressTextBlock" Text="0/0" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <ProgressBar Name="BatchScanProgressBar" Height="20" Minimum="0" Maximum="100" Value="0"/>
                        <TextBlock Name="CurrentScanningTargetTextBlock" Text="当前扫描: -" FontSize="11" Foreground="#7F8C8D" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
                
                <!-- 结果表格 -->
                <DataGrid Grid.Row="1" Name="BatchScanResultsDataGrid" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#F8F9FA"
                          SelectionMode="Single"
                          Margin="5">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="50"/>
                        <DataGridTextColumn Header="目标IP" Binding="{Binding Target}" Width="120"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                        <DataGridTextColumn Header="开放端口" Binding="{Binding OpenPorts}" Width="80"/>
                        <DataGridTextColumn Header="漏洞数" Binding="{Binding VulnerabilityCount}" Width="70"/>
                        <DataGridTextColumn Header="严重" Binding="{Binding CriticalCount}" Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="高危" Binding="{Binding HighCount}" Width="50">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#E67E22"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="中危" Binding="{Binding MediumCount}" Width="50"/>
                        <DataGridTextColumn Header="扫描时长" Binding="{Binding ScanDuration}" Width="80"/>
                        <DataGridTextColumn Header="错误信息" Binding="{Binding ErrorMessage}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                
                <!-- 统计信息 -->
                <Border Grid.Row="2" Background="#F8F9FA" Padding="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊 统计: " FontWeight="Bold"/>
                        <TextBlock Name="TotalTargetsTextBlock" Text="总目标: 0" Margin="10,0"/>
                        <TextBlock Name="CompletedTargetsTextBlock" Text="已完成: 0" Margin="10,0"/>
                        <TextBlock Name="FailedTargetsTextBlock" Text="失败: 0" Margin="10,0"/>
                        <TextBlock Name="TotalVulnerabilitiesTextBlock" Text="总漏洞: 0" Margin="10,0"/>
                        <TextBlock Name="TotalCriticalTextBlock" Text="严重: 0" Foreground="#E74C3C" FontWeight="Bold" Margin="10,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        
        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="StartBatchScanButton" Content="▶️ 开始批量扫描" Width="140" Height="40" 
                    Margin="5" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14" Click="StartBatchScanButton_Click"/>
            <Button Name="StopBatchScanButton" Content="⏹️ 停止扫描" Width="120" Height="40" 
                    Margin="5" Background="#E74C3C" Foreground="White" FontWeight="Bold" IsEnabled="False" Click="StopBatchScanButton_Click"/>
            <Button Name="ExportBatchReportButton" Content="📄 导出报告" Width="120" Height="40" 
                    Margin="5" Background="#3498DB" Foreground="White" FontWeight="Bold" IsEnabled="False" Click="ExportBatchReportButton_Click"/>
            <Button Name="CloseBatchWindowButton" Content="❌ 关闭" Width="100" Height="40" 
                    Margin="5" Background="#95A5A6" Foreground="White" Click="CloseBatchWindowButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
