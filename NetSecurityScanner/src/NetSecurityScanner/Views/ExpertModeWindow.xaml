<Window x:Class="NetSecurityScanner.Views.ExpertModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="专家模式 - 高级扫描配置" Height="800" Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F7FA">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2C3E50" Offset="0"/>
                    <GradientStop Color="#3498DB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border CornerRadius="6" Padding="20,15">
                <StackPanel>
                    <TextBlock Text="🔧 专家模式 - 高级扫描配置" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="自定义所有扫描参数，精细控制扫描行为，适用于高级安全测试场景" FontSize="13" Foreground="#BDC3C7" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- 主内容区域 -->
        <TabControl Grid.Row="1" Margin="0,15,0,0" Background="Transparent" BorderThickness="0">
            <!-- Tab 1: 目标配置 -->
            <TabItem Header="🎯 目标配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- 目标类型 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="目标类型" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <RadioButton Name="SingleIpRadio" Content="单个IP/域名" GroupName="TargetType" IsChecked="True" Margin="0,0,20,5" Checked="TargetTypeRadio_Checked"/>
                                    <RadioButton Name="IpRangeRadio" Content="IP段范围" GroupName="TargetType" Margin="0,0,20,5" Checked="TargetTypeRadio_Checked"/>
                                    <RadioButton Name="CidrRadio" Content="CIDR网段" GroupName="TargetType" Margin="0,0,20,5" Checked="TargetTypeRadio_Checked"/>
                                    <RadioButton Name="FileRadio" Content="文件列表" GroupName="TargetType" Margin="0,0,20,5" Checked="TargetTypeRadio_Checked"/>
                                    <RadioButton Name="RegexRadio" Content="正则模式" GroupName="TargetType" Margin="0,0,0,5" Checked="TargetTypeRadio_Checked"/>
                                </WrapPanel>
                                <TextBox Name="TargetInputTextBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" Margin="0,10,0,5"
                                         BorderBrush="#BDC3C7" BorderThickness="1" Padding="5"/>
                                <TextBlock Name="TargetHintTextBlock" Text="提示：输入单个IP地址，如 192.168.1.1 或 www.example.com"
                                           FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Name="ImportFileButton" Content="📁 导入文件" Width="100" Height="28"
                                            Background="#3498DB" Foreground="White" BorderThickness="0"
                                            Click="ImportFileButton_Click"/>
                                    <TextBlock Name="TargetCountTextBlock" Text="目标数量: 1" Margin="15,0,0,0"
                                               VerticalAlignment="Center" Foreground="#27AE60" FontWeight="SemiBold"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 高级目标选项 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="高级目标选项" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox Name="ReverseDnsCheckBox" Content="启用反向DNS解析" Margin="0,0,20,0"/>
                                    <CheckBox Name="HostDiscoveryCheckBox" Content="先进行主机发现" IsChecked="True" Margin="0,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Label Content="排除主机：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Name="ExcludeHostsTextBox" Width="300" Height="25" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                </StackPanel>
                                <TextBlock Text="多个主机用逗号分隔，如：192.168.1.100,10.0.0.0/24" FontSize="10" Foreground="#95A5A6" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Border>

                        <!-- 实时扫描日志 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Background="White">
                            <StackPanel Margin="15">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📝 扫描日志" FontWeight="Bold" FontSize="14" Foreground="#2C3E50"/>
                                    <Button Name="ClearLogButton" Grid.Column="1" Content="🗑️ 清空日志" Width="90" Height="28"
                                            Background="#95A5A6" Foreground="White" BorderThickness="0"
                                            Click="ClearLogButton_Click"/>
                                </Grid>
                                <TextBox Name="ScanLogTextBox" Height="120" IsReadOnly="True" 
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="11" Background="#1E1E1E" Foreground="#D4D4D4"
                                         BorderBrush="#BDC3C7" BorderThickness="1" Padding="8"
                                         TextWrapping="NoWrap" AcceptsReturn="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 端口与服务 -->
            <TabItem Header="🔌 端口与服务">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- 端口扫描模式 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="端口扫描模式" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <RadioButton Name="CommonPortsRadio" Content="常用端口(Top 1000)" GroupName="PortMode" IsChecked="True" Margin="0,0,15,5"/>
                                    <RadioButton Name="SensitivePortsRadio" Content="敏感端口" GroupName="PortMode" Margin="0,0,15,5"/>
                                    <RadioButton Name="AllPortsRadio" Content="全部端口(1-65535)" GroupName="PortMode" Margin="0,0,15,5"/>
                                    <RadioButton Name="CustomPortsRadio" Content="自定义端口" GroupName="PortMode" Margin="0,0,0,5"/>
                                </WrapPanel>
                                <TextBox Name="CustomPortsTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" Margin="0,10,0,5" IsEnabled="False"
                                         BorderBrush="#BDC3C7" BorderThickness="1" Padding="5"
                                         Text="21,22,23,25,53,80,110,143,443,993,995,1433,3306,3389,5432,6379,8080,8443,9200,27017"/>
                                <TextBlock Text="支持范围格式：22,80,443,8000-9000" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Border>

                        <!-- 协议与检测 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="协议与检测" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox Name="TcpScanCheckBox" Content="TCP扫描" IsChecked="True" Margin="0,0,15,0"/>
                                    <CheckBox Name="UdpScanCheckBox" Content="UDP扫描" Margin="0,0,15,0"/>
                                    <CheckBox Name="SynScanCheckBox" Content="SYN半开扫描" Margin="0,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <CheckBox Name="ServiceVersionCheckBox" Content="服务版本检测" IsChecked="True" Margin="0,0,15,0"/>
                                    <CheckBox Name="OsDetectCheckBox" Content="操作系统识别" Margin="0,0,15,0"/>
                                    <CheckBox Name="ScriptScanCheckBox" Content="NSE脚本扫描" Margin="0,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                                    <Label Content="服务检测强度：" VerticalAlignment="Center"/>
                                    <ComboBox Name="ServiceIntensityComboBox" Width="200" Height="28" SelectedIndex="1">
                                        <ComboBoxItem Content="0 - 仅常用端口"/>
                                        <ComboBoxItem Content="1 - 标准检测"/>
                                        <ComboBoxItem Content="2 - 增强检测"/>
                                        <ComboBoxItem Content="3 - 全部检测"/>
                                        <ComboBoxItem Content="4 - 暴力检测"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 端口排除 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="端口排除列表" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <TextBox Name="ExcludePortsTextBox" Height="40" TextWrapping="Wrap"
                                         BorderBrush="#BDC3C7" BorderThickness="1" Padding="5"
                                         Text=""/>
                                <TextBlock Text="不扫描的端口，用逗号分隔" FontSize="11" Foreground="#7F8C8D" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: 性能调优 -->
            <TabItem Header="⚡ 性能调优">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- 并发控制 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="并发控制" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <Label Content="TCP最大并发数：" FontWeight="SemiBold"/>
                                        <Slider Name="TcpConcurrencySlider" Minimum="1" Maximum="500" Value="50"
                                                TickFrequency="10" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>
                                        <TextBlock Name="TcpConcurrencyValueTextBlock" Text="50" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#3498DB"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <Label Content="UDP最大并发数：" FontWeight="SemiBold"/>
                                        <Slider Name="UdpConcurrencySlider" Minimum="1" Maximum="200" Value="20"
                                                TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>
                                        <TextBlock Name="UdpConcurrencyValueTextBlock" Text="20" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#3498DB"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 超时与重试 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="超时与重试" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <Label Content="TCP超时(ms)：" FontWeight="SemiBold"/>
                                        <Slider Name="TcpTimeoutSlider" Minimum="100" Maximum="5000" Value="500"
                                                TickFrequency="100" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>
                                        <TextBlock Name="TcpTimeoutValueTextBlock" Text="500ms" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#E67E22"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0">
                                        <Label Content="UDP超时(ms)：" FontWeight="SemiBold"/>
                                        <Slider Name="UdpTimeoutSlider" Minimum="500" Maximum="10000" Value="1000"
                                                TickFrequency="500" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>
                                        <TextBlock Name="UdpTimeoutValueTextBlock" Text="1000ms" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#E67E22"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="5,0,0,0">
                                        <Label Content="重试次数：" FontWeight="SemiBold"/>
                                        <Slider Name="RetrySlider" Minimum="0" Maximum="5" Value="1"
                                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,5"/>
                                        <TextBlock Name="RetryValueTextBlock" Text="1" HorizontalAlignment="Center" FontWeight="Bold" Foreground="#E67E22"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 速率限制 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="速率限制" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox Name="RateLimitCheckBox" Content="启用速率限制" Margin="0,0,15,0"/>
                                    <Label Content="数据包速率(包/秒)：" VerticalAlignment="Center"/>
                                    <Slider Name="PacketRateSlider" Minimum="10" Maximum="10000" Value="1000"
                                            TickFrequency="100" IsSnapToTickEnabled="True" Width="200" Margin="0,0,0,5"/>
                                    <TextBlock Name="PacketRateValueTextBlock" Text="1000 pps" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontWeight="Bold" Foreground="#9B59B6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: 高级选项 -->
            <TabItem Header="🔒 高级选项">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- 数据包选项 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="数据包选项" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <Label Content="源端口：" VerticalAlignment="Center" Width="80"/>
                                            <TextBox Name="SourcePortTextBox" Width="100" Height="28" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                            <TextBlock Text="0 = 随机" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#7F8C8D" FontSize="11"/>
                                        </StackPanel>
                                        <CheckBox Name="FragmentPacketsCheckBox" Content="数据包分片(绕过简单IDS)" Margin="0,10,0,5"/>
                                        <CheckBox Name="RandomizeCheckBox" Content="随机化目标顺序" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <Label Content="MTU：" VerticalAlignment="Center" Width="80"/>
                                            <TextBox Name="MtuTextBox" Width="100" Height="28" Text="1500" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                            <TextBlock Text="用于数据包分片" Margin="5,0,0,0" VerticalAlignment="Center" Foreground="#7F8C8D" FontSize="11"/>
                                        </StackPanel>
                                        <CheckBox Name="BadChecksumCheckBox" Content="使用错误校验和(绕过部分防火墙)" Margin="0,10,0,5"/>
                                        <CheckBox Name="StealthModeCheckBox" Content="Stealth模式(低速率)" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 防火墙/IDS规避 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="防火墙/IDS规避" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <CheckBox Name="DecoyScanCheckBox" Content="诱饵扫描" Margin="0,0,15,0"/>
                                    <Label Content="诱饵IP：" VerticalAlignment="Center"/>
                                    <TextBox Name="DecoyIpsTextBox" Width="250" Height="28" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                </StackPanel>
                                <TextBlock Text="多个诱饵用逗号分隔" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <CheckBox Name="IdleScanCheckBox" Content="Idle僵尸扫描(完全隐蔽)" Margin="0,0,15,0"/>
                                    <Label Content="僵尸主机：" VerticalAlignment="Center"/>
                                    <TextBox Name="ZombieHostTextBox" Width="150" Height="28" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                </StackPanel>
                                <CheckBox Name="SourceRoutingCheckBox" Content="使用源路由(松散/严格)" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- 输出控制 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="输出控制" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <Label Content="日志级别：" VerticalAlignment="Center" Width="80"/>
                                    <ComboBox Name="VerbosityComboBox" Width="150" Height="28" SelectedIndex="1">
                                        <ComboBoxItem Content="安静模式"/>
                                        <ComboBoxItem Content="标准"/>
                                        <ComboBoxItem Content="详细"/>
                                        <ComboBoxItem Content="调试"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                                    <Label Content="输出格式：" VerticalAlignment="Center" Width="80"/>
                                    <CheckBox Name="OutputJsonCheckBox" Content="JSON" IsChecked="True" Margin="0,0,10,0"/>
                                    <CheckBox Name="OutputHtmlCheckBox" Content="HTML" Margin="0,0,10,0"/>
                                    <CheckBox Name="OutputCsvCheckBox" Content="CSV" Margin="0,0,0,0"/>
                                </StackPanel>
                                <CheckBox Name="SaveOutputCheckBox" Content="保存扫描输出到文件" IsChecked="True" Margin="0,10,0,5"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Label Content="输出目录：" VerticalAlignment="Center" Width="80"/>
                                    <TextBox Name="OutputDirTextBox" Width="350" Height="28" BorderBrush="#BDC3C7" BorderThickness="1"/>
                                    <Button Name="BrowseOutputButton" Content="浏览" Width="60" Height="28" Margin="5,0,0,0"
                                            Background="#95A5A6" Foreground="White" BorderThickness="0" Click="BrowseOutputButton_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 5: 实时扫描结果 -->
            <TabItem Header="📊 实时结果">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- 扫描进度 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="扫描进度" FontWeight="Bold" FontSize="14" Foreground="#2C3E50"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Name="ClearResultsButton" Content="🗑️ 清空结果" Width="90" Height="28"
                                                Margin="0,0,5,0" Background="#E74C3C" Foreground="White" BorderThickness="0"
                                                Click="ClearResultsButton_Click"/>
                                        <Button Name="CopyResultsButton" Content="📋 复制结果" Width="90" Height="28"
                                                Background="#3498DB" Foreground="White" BorderThickness="0"
                                                Click="CopyResultsButton_Click"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar Name="ExpertScanProgressBar" Height="20" Minimum="0" Maximum="100" Value="0" 
                                                 Foreground="#3498DB" Background="#ECF0F1" BorderThickness="0"/>
                                    <TextBlock Name="ExpertScanProgressText" Grid.Column="1" Text="就绪" Margin="10,0,0,0" 
                                               VerticalAlignment="Center" Foreground="#2C3E50"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 扫描结果统计 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="扫描结果统计" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#ECF0F1" CornerRadius="4" Margin="0,0,5,0">
                                        <StackPanel Margin="10">
                                            <TextBlock Text="总目标数" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                                            <TextBlock Name="TotalTargetsStat" Text="0" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#ECF0F1" CornerRadius="4" Margin="5,0">
                                        <StackPanel Margin="10">
                                            <TextBlock Text="已扫描" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                                            <TextBlock Name="ScannedTargetsStat" Text="0" FontSize="18" FontWeight="Bold" Foreground="#3498DB" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#ECF0F1" CornerRadius="4" Margin="5,0">
                                        <StackPanel Margin="10">
                                            <TextBlock Text="开放端口" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                                            <TextBlock Name="OpenPortsStat" Text="0" FontSize="18" FontWeight="Bold" Foreground="#27AE60" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="3" Background="#ECF0F1" CornerRadius="4" Margin="5,0,0,0">
                                        <StackPanel Margin="10">
                                            <TextBlock Text="发现漏洞" FontSize="12" Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                                            <TextBlock Name="VulnerabilitiesStat" Text="0" FontSize="18" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 实时端口扫描结果 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="实时端口扫描结果" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <DataGrid Name="RealTimePortResultsDataGrid" 
                                          AutoGenerateColumns="False" 
                                          CanUserAddRows="False" 
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="All"
                                          RowHeaderWidth="0"
                                          Height="200"
                                          SelectionMode="Extended"
                                          CanUserSortColumns="True"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="目标IP" Binding="{Binding TargetIp}" Width="120" SortMemberPath="TargetIp"/>
                                        <DataGridTextColumn Header="端口" Binding="{Binding PortNumber}" Width="80" SortMemberPath="PortNumber"/>
                                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80" SortMemberPath="Status"/>
                                        <DataGridTextColumn Header="服务" Binding="{Binding Service}" Width="120" SortMemberPath="Service"/>
                                        <DataGridTextColumn Header="版本" Binding="{Binding ServiceVersion}" Width="150" SortMemberPath="ServiceVersion"/>
                                        <DataGridTextColumn Header="响应时间(ms)" Binding="{Binding ResponseTime}" Width="100" SortMemberPath="ResponseTime"/>
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📋 复制选中行" Click="CopySelectedRows_Click"/>
                                            <MenuItem Header="🗑️ 删除选中行" Click="DeleteSelectedRows_Click"/>
                                            <Separator/>
                                            <MenuItem Header="📊 按端口排序" Click="SortByPort_Click"/>
                                            <MenuItem Header="🔍 筛选开放端口" Click="FilterOpenPorts_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- 实时漏洞扫描结果 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Background="White">
                            <StackPanel Margin="15">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="实时漏洞扫描结果" FontWeight="Bold" FontSize="14" Foreground="#2C3E50"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Name="ExportHtmlButton" Content="📄 导出HTML报告" Width="120" Height="28"
                                                Margin="0,0,5,0" Background="#3498DB" Foreground="White" BorderThickness="0"
                                                Click="ExportHtmlButton_Click"/>
                                        <Button Name="ExportCsvButton" Content="📊 导出CSV" Width="90" Height="28"
                                                Margin="0,0,5,0" Background="#27AE60" Foreground="White" BorderThickness="0"
                                                Click="ExportCsvButton_Click"/>
                                        <Button Name="ExportJsonButton" Content="💾 导出JSON" Width="90" Height="28"
                                                Background="#9B59B6" Foreground="White" BorderThickness="0"
                                                Click="ExportJsonButton_Click"/>
                                    </StackPanel>
                                </Grid>
                                <DataGrid Name="RealTimeVulnResultsDataGrid" 
                                          AutoGenerateColumns="False" 
                                          CanUserAddRows="False" 
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="All"
                                          RowHeaderWidth="0"
                                          Height="200"
                                          SelectionMode="Extended"
                                          CanUserSortColumns="True"
                                          IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="序号" Binding="{Binding Id}" Width="50" SortMemberPath="Id"/>
                                        <DataGridTextColumn Header="漏洞名称" Binding="{Binding Name}" Width="180" SortMemberPath="Name"/>
                                        <DataGridTextColumn Header="CVE编号" Binding="{Binding CveId}" Width="130" SortMemberPath="CveId"/>
                                        <DataGridTextColumn Header="风险等级" Binding="{Binding RiskLevel}" Width="80" SortMemberPath="RiskLevel"/>
                                        <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60" SortMemberPath="Port"/>
                                        <DataGridTextColumn Header="服务" Binding="{Binding Service}" Width="120" SortMemberPath="Service"/>
                                        <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="120" SortMemberPath="Target"/>
                                        <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*" SortMemberPath="Description"/>
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="📋 复制选中行" Click="CopyVulnSelectedRows_Click"/>
                                            <Separator/>
                                            <MenuItem Header="⚠️ 按风险等级排序" Click="SortByRiskLevel_Click"/>
                                            <MenuItem Header="🔴 筛选高危漏洞" Click="FilterHighRisk_Click"/>
                                            <MenuItem Header="🟡 筛选中危漏洞" Click="FilterMediumRisk_Click"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 6: Nmap预设模板 -->
            <TabItem Header="📋 Nmap模板">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- Nmap风格扫描模板 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="Nmap风格扫描模板" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,15"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Name="NmapFastBtn" Content="⚡ 快速扫描 (-F)" Width="180" Height="60" Margin="5"
                                            Background="#3498DB" Foreground="White" BorderThickness="0"
                                            Click="NmapFastBtn_Click" Cursor="Hand"/>
                                    <Button Name="NmapStealthBtn" Content="🥷 隐蔽扫描 (-sS)" Width="180" Height="60" Margin="5"
                                            Background="#E74C3C" Foreground="White" BorderThickness="0"
                                            Click="NmapStealthBtn_Click" Cursor="Hand"/>
                                    <Button Name="NmapAggressiveBtn" Content="💥 激进扫描 (-A)" Width="180" Height="60" Margin="5"
                                            Background="#E67E22" Foreground="White" BorderThickness="0"
                                            Click="NmapAggressiveBtn_Click" Cursor="Hand"/>
                                    <Button Name="NmapPingScanBtn" Content="📡 Ping扫描 (-sn)" Width="180" Height="60" Margin="5"
                                            Background="#9B59B6" Foreground="White" BorderThickness="0"
                                            Click="NmapPingScanBtn_Click" Cursor="Hand"/>
                                    <Button Name="NmapFullPortsBtn" Content="🔍 全端口扫描 (-p-)" Width="180" Height="60" Margin="5"
                                            Background="#1ABC9C" Foreground="White" BorderThickness="0"
                                            Click="NmapFullPortsBtn_Click" Cursor="Hand"/>
                                    <Button Name="NmapVersionBtn" Content="️ 版本检测 (-sV)" Width="180" Height="60" Margin="5"
                                            Background="#27AE60" Foreground="White" BorderThickness="0"
                                            Click="NmapVersionBtn_Click" Cursor="Hand"/>
                                    <Button Name="NmapOsBtn" Content="🖥️ 系统检测 (-O)" Width="180" Height="60" Margin="5"
                                            Background="#8E44AD" Foreground="White" BorderThickness="0"
                                            Click="NmapOsBtn_Click" Cursor="Hand"/>
                                    <Button Name="NmapDefaultBtn" Content=" 默认扫描 (无参数)" Width="180" Height="60" Margin="5"
                                            Background="#95A5A6" Foreground="White" BorderThickness="0"
                                            Click="NmapDefaultBtn_Click" Cursor="Hand"/>
                                </WrapPanel>
                                <TextBlock Text="点击模板按钮自动配置扫描参数" FontSize="11" Foreground="#7F8C8D"/>
                            </StackPanel>
                        </Border>

                        <!-- 预设场景 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="预设场景配置" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,15"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Button Name="PresetWebServerBtn" Content="🌐 Web服务器检测" Width="180" Height="60" Margin="5"
                                            Background="#3498DB" Foreground="White" BorderThickness="0"
                                            Click="PresetWebServerBtn_Click" Cursor="Hand"/>
                                    <Button Name="PresetDatabaseBtn" Content="️ 数据库安全检测" Width="180" Height="60" Margin="5"
                                            Background="#E74C3C" Foreground="White" BorderThickness="0"
                                            Click="PresetDatabaseBtn_Click" Cursor="Hand"/>
                                    <Button Name="PresetWifiBtn" Content="📶 WiFi路由器检测" Width="180" Height="60" Margin="5"
                                            Background="#27AE60" Foreground="White" BorderThickness="0"
                                            Click="PresetWifiBtn_Click" Cursor="Hand"/>
                                    <Button Name="PresetComplianceBtn" Content="✅ 合规性检查" Width="180" Height="60" Margin="5"
                                            Background="#9B59B6" Foreground="White" BorderThickness="0"
                                            Click="PresetComplianceBtn_Click" Cursor="Hand"/>
                                    <Button Name="PresetVulnBtn" Content=" 漏洞专项检测" Width="180" Height="60" Margin="5"
                                            Background="#E67E22" Foreground="White" BorderThickness="0"
                                            Click="PresetVulnBtn_Click" Cursor="Hand"/>
                                    <Button Name="PresetStealthBtn" Content="👻 隐蔽审计" Width="180" Height="60" Margin="5"
                                            Background="#1ABC9C" Foreground="White" BorderThickness="0"
                                            Click="PresetStealthBtn_Click" Cursor="Hand"/>
                                </WrapPanel>
                                <TextBlock Text="点击场景按钮自动配置适用于该场景的扫描参数" FontSize="11" Foreground="#7F8C8D"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部按钮区域 -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="15" Margin="0,15,0,0"
                BorderBrush="#BDC3C7" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Name="LoadPresetButton" Content="📂 加载预设" Width="100" Height="35"
                                Margin="5" Background="#95A5A6" Foreground="White" BorderThickness="0"
                                Click="LoadPresetButton_Click"/>
                        <Button Name="SavePresetButton" Content="💾 保存预设" Width="100" Height="35"
                                Margin="5" Background="#95A5A6" Foreground="White" BorderThickness="0"
                                Click="SavePresetButton_Click"/>
                        <Button Name="ExportNmapButton" Content="📋 导出Nmap命令" Width="120" Height="35"
                                Margin="5" Background="#9B59B6" Foreground="White" BorderThickness="0"
                                Click="ExportNmapButton_Click"/>
                        <Button Name="ValidateConfigButton" Content="✅ 验证配置" Width="100" Height="35"
                                Margin="5" Background="#3498DB" Foreground="White" BorderThickness="0"
                                Click="ValidateConfigButton_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Name="StartExpertScanButton" Content="🚀 开始专家扫描" Width="140" Height="40"
                                Margin="5" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14"
                                BorderThickness="0" Click="StartExpertScanButton_Click"/>
                        <Button Name="CancelExpertButton" Content="❌ 取消" Width="100" Height="40"
                                Margin="5" Background="#E74C3C" Foreground="White" FontWeight="Bold"
                                BorderThickness="0" Click="CancelExpertButton_Click"/>
                    </StackPanel>
                </Grid>
                <!-- 扫描计划预览 -->
                <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="4" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="🎯 目标数量: " FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock Name="TargetCountPreviewText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#3498DB"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="🔌 端口数量: " FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock Name="PortCountPreviewText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#E67E22"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="⏱️ 预计耗时: " FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock Name="EstimatedTimePreviewText" Text="0秒" FontSize="12" FontWeight="Bold" Foreground="#27AE60"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <TextBlock Text="📊 总扫描数: " FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock Name="TotalScansPreviewText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#9B59B6"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
