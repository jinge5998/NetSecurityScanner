<Window x:Class="NetSecurityScanner.Views.CameraSecurityScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="摄像头安全扫描"
        Width="1400"
        Height="950"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
  <Window.Resources>
    <Style x:Key="DataGridCellStyle"
           TargetType="DataGridCell">
      <Setter Property="Padding"
              Value="8,5"/>
      <Setter Property="BorderThickness"
              Value="0"/>
    </Style>
    <Style x:Key="DataGridColumnHeaderStyle"
           TargetType="DataGridColumnHeader">
      <Setter Property="Background"
              Value="#2C3E50"/>
      <Setter Property="Foreground"
              Value="White"/>
      <Setter Property="FontWeight"
              Value="Bold"/>
      <Setter Property="Padding"
              Value="10,8"/>
      <Setter Property="HorizontalContentAlignment"
              Value="Left"/>
    </Style>
    <Style x:Key="RiskCardCritical"
           TargetType="Border">
      <Setter Property="Background"
              Value="#FDECEC"/>
      <Setter Property="CornerRadius"
              Value="6"/>
      <Setter Property="BorderBrush"
              Value="#E74C3C"/>
      <Setter Property="BorderThickness"
              Value="1"/>
    </Style>
    <Style x:Key="RiskCardHigh"
           TargetType="Border">
      <Setter Property="Background"
              Value="#FEF0E6"/>
      <Setter Property="CornerRadius"
              Value="6"/>
      <Setter Property="BorderBrush"
              Value="#E67E22"/>
      <Setter Property="BorderThickness"
              Value="1"/>
    </Style>
    <Style x:Key="RiskCardMedium"
           TargetType="Border">
      <Setter Property="Background"
              Value="#FFF8E1"/>
      <Setter Property="CornerRadius"
              Value="6"/>
      <Setter Property="BorderBrush"
              Value="#F39C12"/>
      <Setter Property="BorderThickness"
              Value="1"/>
    </Style>
    <Style x:Key="RiskCardLow"
           TargetType="Border">
      <Setter Property="Background"
              Value="#E8F5E9"/>
      <Setter Property="CornerRadius"
              Value="6"/>
      <Setter Property="BorderBrush"
              Value="#27AE60"/>
      <Setter Property="BorderThickness"
              Value="1"/>
    </Style>
    <Style x:Key="StyledGroupBox"
           TargetType="GroupBox">
      <Setter Property="BorderBrush"
              Value="#E0E0E0"/>
      <Setter Property="BorderThickness"
              Value="1"/>
      <Setter Property="FontWeight"
              Value="Bold"/>
      <Setter Property="Foreground"
              Value="#2C3E50"/>
      <Setter Property="Padding"
              Value="10"/>
    </Style>
    <Style x:Key="FilterTextBoxStyle"
           TargetType="TextBox">
      <Setter Property="Padding"
              Value="10,8"/>
      <Setter Property="BorderBrush"
              Value="#BDC3C7"/>
      <Setter Property="BorderThickness"
              Value="1"/>
      <Setter Property="FontSize"
              Value="13"/>
      <Setter Property="VerticalContentAlignment"
              Value="Center"/>
      <Setter Property="Background"
              Value="White"/>
    </Style>
  </Window.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="#2C3E50"
            CornerRadius="8"
            Padding="20,15"
            Margin="0,0,0,10">
      <StackPanel>
        <TextBlock Text="📷 摄像头安全扫描"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="White"/>
        <TextBlock Text="IP扫描 · 端口探测 · 漏洞识别 · 弱口令检测 · 风险评估 · 修复建议"
                   FontSize="13"
                   Foreground="#BDC3C7"
                   Margin="0,5,0,0"/>
      </StackPanel>
    </Border>

    <GroupBox Grid.Row="1"
              Header="目标输入"
              Style="{StaticResource StyledGroupBox}"
              Margin="0,0,0,8"
              Padding="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="单IP:"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Margin="0,0,8,0"/>
          <TextBox x:Name="SingleIpTextBox"
                   Grid.Column="1"
                   Padding="6,8"
                   Width="180"
                   HorizontalAlignment="Left"
                   Text="192.168.1.100"
                   FontSize="13"/>
          <TextBlock Text="IP段:"
                     Grid.Column="2"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Margin="15,0,8,0"/>
          <TextBox x:Name="IpRangeTextBox"
                   Grid.Column="3"
                   Padding="6,8"
                   Width="220"
                   HorizontalAlignment="Left"
                   Text="192.168.1.1-192.168.1.254"
                   FontSize="13"/>
          <TextBlock Text="CIDR:"
                     Grid.Column="4"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Margin="15,0,8,0"/>
          <TextBox x:Name="CidrTextBox"
                   Grid.Column="5"
                   Padding="6,8"
                   Width="150"
                   HorizontalAlignment="Left"
                   Text="192.168.1.0/24"
                   FontSize="13"/>
        </Grid>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal">
          <TextBlock Text="⚠ 仅限授权安全测试，未经授权扫描他人设备属于违法行为"
                     FontSize="11"
                     Foreground="#E74C3C"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="2"
              Header="扫描配置"
              Style="{StaticResource StyledGroupBox}"
              Margin="0,0,0,8"
              Padding="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
          <CheckBox x:Name="FingerprintCheck"
                    Content="指纹识别"
                    IsChecked="True"
                    Margin="0,0,20,0"
                    FontWeight="SemiBold"
                    Foreground="#2C3E50"/>
          <CheckBox x:Name="VulnScanCheck"
                    Content="漏洞检测"
                    IsChecked="True"
                    Margin="0,0,20,0"
                    FontWeight="SemiBold"
                    Foreground="#2C3E50"/>
          <CheckBox x:Name="WeakPasswordCheck"
                    Content="弱口令检测"
                    IsChecked="True"
                    Margin="0,0,20,0"
                    FontWeight="SemiBold"
                    Foreground="#2C3E50"/>
          <TextBlock Text="并发:"
                     VerticalAlignment="Center"
                     Margin="10,0,5,0"/>
          <TextBox x:Name="ConcurrencyTextBox"
                   Width="50"
                   Text="30"
                   Padding="4,4"
                   FontSize="12"/>
          <TextBlock Text="超时(ms):"
                     VerticalAlignment="Center"
                     Margin="10,0,5,0"/>
          <TextBox x:Name="TimeoutTextBox"
                   Width="60"
                   Text="3000"
                   Padding="4,4"
                   FontSize="12"/>
        </StackPanel>
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal">
          <Button x:Name="StartScanButton"
                  Content="▶ 开始扫描"
                  Padding="30,12"
                  Click="StartScan_Click"
                  Background="#27AE60"
                  Foreground="White"
                  FontWeight="Bold"
                  FontSize="14"/>
          <Button x:Name="StopScanButton"
                  Content="⏹ 停止扫描"
                  Padding="25,12"
                  Margin="15,0,0,0"
                  Click="StopScan_Click"
                  IsEnabled="False"
                  Background="#E74C3C"
                  Foreground="White"
                  FontWeight="Bold"
                  FontSize="14"/>
          <Button x:Name="ExportReportButton"
                  Content="📋 导出报告"
                  Padding="25,12"
                  Margin="15,0,0,0"
                  Click="ExportReport_Click"
                  IsEnabled="False"
                  Background="#3498DB"
                  Foreground="White"
                  FontWeight="Bold"
                  FontSize="14"/>
          <Button x:Name="ImportTargetsButton"
                  Content="📂 导入IP列表"
                  Padding="20,12"
                  Margin="15,0,0,0"
                  Click="ImportTargets_Click"
                  Background="#9B59B6"
                  Foreground="White"
                  FontWeight="Bold"
                  FontSize="14"/>
          <Button x:Name="AutoDiscoverButton"
                  Content="🔍 自动发现"
                  Padding="20,12"
                  Margin="15,0,0,0"
                  Click="AutoDiscover_Click"
                  Background="#E67E22"
                  Foreground="White"
                  FontWeight="Bold"
                  FontSize="14"/>
        </StackPanel>
      </Grid>
    </GroupBox>

    <Border Grid.Row="3"
            Background="#F8F9FA"
            BorderBrush="#E9ECEF"
            BorderThickness="1"
            CornerRadius="8"
            Padding="15"
            Margin="0,0,0,8">
      <StackPanel>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="ScanStatusText"
                     Text="状态: 就绪"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Foreground="#2C3E50"/>
          <TextBlock x:Name="ScanProgressText"
                     Text="0%"
                     Grid.Column="2"
                     VerticalAlignment="Center"
                     FontWeight="Bold"
                     Foreground="#27AE60"
                     FontSize="14"/>
        </Grid>
        <ProgressBar x:Name="ScanProgressBar"
                     Height="25"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                     Foreground="#27AE60"
                     Background="#E9ECEF"/>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="TotalFoundText"
                     Text="已发现: 0"
                     Grid.Column="0"
                     VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     Foreground="#2C3E50"
                     Margin="0,0,15,0"/>
          <StackPanel Grid.Column="1"
                      Orientation="Horizontal"
                      Margin="0,0,15,0">
            <Ellipse Width="10"
                     Height="10"
                     Fill="#C0392B"
                     Margin="0,0,5,0"
                     VerticalAlignment="Center"/>
            <TextBlock Text="严重:"
                       VerticalAlignment="Center"
                       Margin="0,0,3,0"/>
            <TextBlock x:Name="CriticalCountText"
                       Text="0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="#C0392B"/>
          </StackPanel>
          <StackPanel Grid.Column="2"
                      Orientation="Horizontal"
                      Margin="0,0,15,0">
            <Ellipse Width="10"
                     Height="10"
                     Fill="#E67E22"
                     Margin="0,0,5,0"
                     VerticalAlignment="Center"/>
            <TextBlock Text="高危:"
                       VerticalAlignment="Center"
                       Margin="0,0,3,0"/>
            <TextBlock x:Name="HighCountText"
                       Text="0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="#E67E22"/>
            <TextBlock Text="中危:"
                       VerticalAlignment="Center"
                       Margin="15,0,3,0"/>
            <TextBlock x:Name="MediumCountText"
                       Text="0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="#F39C12"/>
          </StackPanel>
          <StackPanel Grid.Column="3"
                      Orientation="Horizontal">
            <Ellipse Width="10"
                     Height="10"
                     Fill="#3498DB"
                     Margin="0,0,5,0"
                     VerticalAlignment="Center"/>
            <TextBlock Text="在线:"
                       VerticalAlignment="Center"
                       Margin="0,0,3,0"/>
            <TextBlock x:Name="OnlineCountText"
                       Text="0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       Foreground="#3498DB"/>
          </StackPanel>
          <TextBlock x:Name="ScanPhaseText"
                     Grid.Column="5"
                     Text="就绪"
                     VerticalAlignment="Center"
                     Foreground="#7F8C8D"
                     FontSize="12"/>
        </Grid>
      </StackPanel>
    </Border>

    <Grid Grid.Row="4"
          Margin="0,0,0,5">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBox x:Name="FilterTextBox"
               Grid.Column="0"
               Margin="0,0,10,0"
               Padding="10,6"
               TextChanged="FilterTextBox_TextChanged"
               VerticalContentAlignment="Center"
               Style="{StaticResource FilterTextBoxStyle}"
               Foreground="#95A5A6"
               GotFocus="FilterTextBox_GotFocus"
               LostFocus="FilterTextBox_LostFocus"
               Text="🔍 搜索过滤（IP / 厂商 / 型号 / 风险等级）..."
               ToolTip="输入关键词过滤结果（支持IP、厂商、型号、风险等级）"/>
      <Button Grid.Column="1"
              x:Name="CopyButton"
              Content="📋 复制"
              Click="CopyButton_Click"
              Width="80"
              Height="30"
              Margin="0,0,5,0"
              Background="#3498DB"
              Foreground="White"
              BorderThickness="0"
              FontSize="12"
              ToolTip="复制选中结果到剪贴板"/>
      <Button Grid.Column="2"
              x:Name="ExportJsonButton"
              Content="📄 JSON"
              Click="ExportJsonButton_Click"
              Width="80"
              Height="30"
              Margin="0,0,5,0"
              Background="#27AE60"
              Foreground="White"
              BorderThickness="0"
              FontSize="12"
              ToolTip="导出JSON格式报告"/>
    </Grid>
    <TabControl Grid.Row="5"
                Margin="0,0,0,8">
      <TabItem Header="📷 摄像头列表">
        <DataGrid x:Name="CameraDataGrid"
                  AutoGenerateColumns="False"
                  CellStyle="{StaticResource DataGridCellStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="CameraDataGrid_SelectionChanged">
          <DataGrid.ContextMenu>
            <ContextMenu>
              <MenuItem Header="📋 复制IP地址"
                        Click="ContextMenu_CopyIp_Click"/>
              <MenuItem Header="🔄 重新扫描此设备"
                        Click="ContextMenu_Rescan_Click"/>
              <MenuItem Header="🌐 浏览器打开"
                        Click="ContextMenu_OpenBrowser_Click"/>
              <Separator/>
              <MenuItem Header="📋 复制全部信息"
                        Click="ContextMenu_CopyAll_Click"/>
            </ContextMenu>
          </DataGrid.ContextMenu>
          <DataGrid.Columns>
            <DataGridTextColumn Header="IP"
                                Binding="{Binding Ip}"
                                Width="130"/>
            <DataGridTextColumn Header="状态"
                                Binding="{Binding IsOnline}"
                                Width="60"/>
            <DataGridTextColumn Header="厂商"
                                Binding="{Binding Vendor}"
                                Width="100"/>
            <DataGridTextColumn Header="型号"
                                Binding="{Binding Model}"
                                Width="120"/>
            <DataGridTextColumn Header="固件版本"
                                Binding="{Binding FirmwareVersion}"
                                Width="100"/>
            <DataGridTextColumn Header="开放端口"
                                Width="80">
              <DataGridTextColumn.Binding>
                <Binding Path="OpenPorts.Count"/>
              </DataGridTextColumn.Binding>
            </DataGridTextColumn>
            <DataGridTextColumn Header="漏洞"
                                Width="60">
              <DataGridTextColumn.Binding>
                <Binding Path="Vulnerabilities.Count"/>
              </DataGridTextColumn.Binding>
            </DataGridTextColumn>
            <DataGridTextColumn Header="弱口令"
                                Width="60">
              <DataGridTextColumn.Binding>
                <Binding Path="WeakPasswords.Count"/>
              </DataGridTextColumn.Binding>
            </DataGridTextColumn>
            <DataGridTextColumn Header="风险评分"
                                Binding="{Binding RiskAssessment.TotalScore}"
                                Width="70"/>
            <DataGridTextColumn Header="风险等级"
                                Binding="{Binding RiskAssessment.RiskLevel}"
                                Width="80"/>
            <DataGridTextColumn Header="响应时间"
                                Binding="{Binding ResponseTimeMs}"
                                Width="80"/>
            <DataGridTextColumn Header="扫描时间"
                                Binding="{Binding ScanTime}"
                                Width="160"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="🔓 开放端口">
        <DataGrid x:Name="PortDataGrid"
                  AutoGenerateColumns="False"
                  CellStyle="{StaticResource DataGridCellStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="IP"
                                Binding="{Binding Ip}"
                                Width="130"/>
            <DataGridTextColumn Header="端口"
                                Binding="{Binding Port}"
                                Width="60"/>
            <DataGridTextColumn Header="协议"
                                Binding="{Binding Protocol}"
                                Width="60"/>
            <DataGridTextColumn Header="服务"
                                Binding="{Binding Service}"
                                Width="120"/>
            <DataGridTextColumn Header="状态"
                                Binding="{Binding Status}"
                                Width="60"/>
            <DataGridTextColumn Header="Banner"
                                Binding="{Binding Banner}"
                                Width="200"/>
            <DataGridTextColumn Header="默认端口"
                                Binding="{Binding IsDefaultPort}"
                                Width="70"/>
            <DataGridTextColumn Header="风险等级"
                                Binding="{Binding RiskLevel}"
                                Width="80"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="🛡 漏洞信息">
        <DataGrid x:Name="VulnDataGrid"
                  AutoGenerateColumns="False"
                  CellStyle="{StaticResource DataGridCellStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="设备IP"
                                Binding="{Binding CameraIp}"
                                Width="130"/>
            <DataGridTextColumn Header="CVE"
                                Binding="{Binding CveId}"
                                Width="130"/>
            <DataGridTextColumn Header="漏洞名称"
                                Binding="{Binding Name}"
                                Width="200"/>
            <DataGridTextColumn Header="严重等级"
                                Binding="{Binding Severity}"
                                Width="80"/>
            <DataGridTextColumn Header="CVSS"
                                Binding="{Binding CvssScore}"
                                Width="60"/>
            <DataGridTextColumn Header="厂商"
                                Binding="{Binding AffectedVendor}"
                                Width="80"/>
            <DataGridTextColumn Header="影响版本"
                                Binding="{Binding AffectedVersions}"
                                Width="100"/>
            <DataGridTextColumn Header="修复版本"
                                Binding="{Binding FixedVersion}"
                                Width="100"/>
            <DataGridTextColumn Header="已验证"
                                Binding="{Binding IsVerified}"
                                Width="60"/>
            <DataGridTextColumn Header="修复建议"
                                Binding="{Binding Solution}"
                                Width="300"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
      <TabItem Header="🔑 弱口令">
        <DataGrid x:Name="WeakPasswordDataGrid"
                  AutoGenerateColumns="False"
                  CellStyle="{StaticResource DataGridCellStyle}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  IsReadOnly="True">
          <DataGrid.Columns>
            <DataGridTextColumn Header="设备IP"
                                Binding="{Binding CameraIp}"
                                Width="130"/>
            <DataGridTextColumn Header="服务类型"
                                Binding="{Binding ServiceType}"
                                Width="80"/>
            <DataGridTextColumn Header="端口"
                                Binding="{Binding Port}"
                                Width="60"/>
            <DataGridTextColumn Header="用户名"
                                Binding="{Binding Username}"
                                Width="100"/>
            <DataGridTextColumn Header="密码"
                                Binding="{Binding Password}"
                                Width="120"/>
            <DataGridTextColumn Header="风险等级"
                                Binding="{Binding RiskLevel}"
                                Width="80"/>
            <DataGridTextColumn Header="修复建议"
                                Binding="{Binding Suggestion}"
                                Width="350"/>
          </DataGrid.Columns>
        </DataGrid>
      </TabItem>
    </TabControl>

    <Border Grid.Row="6"
            Background="#2C3E50"
            CornerRadius="6"
            Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusBarText"
                   Text="就绪"
                   Foreground="White"
                   VerticalAlignment="Center"/>
        <TextBlock x:Name="TimeText"
                   Grid.Column="1"
                   Text=""
                   Foreground="#BDC3C7"
                   VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>