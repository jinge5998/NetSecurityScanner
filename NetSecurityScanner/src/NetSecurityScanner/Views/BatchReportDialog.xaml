<Window x:Class="NetSecurityScanner.Views.Views.BatchReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📚 批量报告生成" Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5" ShowInTaskbar="False" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#16A085" CornerRadius="4" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📚 批量报告生成" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Name="CountText" Text="将为 0 条记录生成报告" FontSize="12" Foreground="#BDC3C7" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1">
            <GroupBox Header="📄 输出格式" Padding="10" Margin="0,0,0,10">
                <ComboBox Name="FormatCombo" Padding="5">
                    <ComboBoxItem Content="PDF 报告" IsSelected="True"/>
                    <ComboBoxItem Content="Word 文档"/>
                    <ComboBoxItem Content="HTML 网页"/>
                </ComboBox>
            </GroupBox>

            <GroupBox Header="📋 报告内容" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Name="SummaryCheck" Content="执行摘要" IsChecked="True" Margin="5"/>
                    <CheckBox Grid.Column="1" Name="VulnCheck" Content="漏洞列表" IsChecked="True" Margin="5"/>
                    <CheckBox Grid.Column="0" Name="RemediationCheck" Content="修复建议" IsChecked="True" Margin="5"/>
                    <CheckBox Grid.Column="1" Name="StatsCheck" Content="统计分析" IsChecked="True" Margin="5"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="🏢 公司信息" Padding="10">
                <TextBox Name="CompanyTextBox" Text="徐州鸿高电子科技有限公司" Padding="5"/>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="OkButton" Content="✅ 开始生成" Click="Ok_Click" 
                   MinWidth="120" Height="40" Margin="5" 
                   Background="#16A085" Foreground="White" FontWeight="Bold"/>
            <Button Name="CancelButton" Content="❌ 取消" Click="Cancel_Click" 
                   MinWidth="100" Height="40" Margin="5" 
                   Background="#95A5A6" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
