<Window x:Class="NetSecurityScanner.Views.ComprehensiveScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开始综合扫描" Width="500" Height="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="#F5F6FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="0,0,8,8" Padding="20,15">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2C3E50" Offset="0"/>
                    <GradientStop Color="#3498DB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="🛡️ 综合扫描配置" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="配置目标地址与扫描参数，开始全面安全检测" FontSize="11" Foreground="#BDC3C7" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,15,20,5">
            <StackPanel>
                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" Background="White">
                    <StackPanel>
                        <TextBlock Text="🎯 目标地址" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,8"/>
                        <TextBox x:Name="TargetIpTextBox" Text="127.0.0.1" FontSize="13" Padding="6,4"
                                 BorderBrush="#BDC3C7" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock x:Name="IpErrorTextBlock" Text="" FontSize="11" Foreground="#E74C3C" Margin="0,4,0,0"
                                   Visibility="Collapsed" TextWrapping="Wrap"/>
                        <TextBlock Text="支持 IPv4 地址（如 192.168.1.1）或域名（如 example.com）" 
                                   FontSize="10" Foreground="#95A5A6" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" Background="White">
                    <StackPanel>
                        <TextBlock Text="🔌 端口范围" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,8"/>
                        <TextBox x:Name="PortRangeTextBox" Text="1-1000" FontSize="13" Padding="6,4"
                                 BorderBrush="#BDC3C7" BorderThickness="1">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBlock x:Name="PortErrorTextBlock" Text="" FontSize="11" Foreground="#E74C3C" Margin="0,4,0,0"
                                   Visibility="Collapsed" TextWrapping="Wrap"/>
                        <TextBlock Text="格式：范围（1-1000）、列表（22,80,443）或混合（1-100,443,8080）" 
                                   FontSize="10" Foreground="#95A5A6" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" Background="White">
                    <StackPanel>
                        <TextBlock Text="📡 扫描协议" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Border BorderBrush="#27AE60" BorderThickness="1.5" CornerRadius="4" Padding="8,4" Margin="0,0,12,0"
                                    Background="#27AE60">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="TcpCheckBox" IsChecked="True" VerticalAlignment="Center"
                                              Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="TCP" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="#E67E22" BorderThickness="1.5" CornerRadius="4" Padding="8,4"
                                    Background="#E67E22">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="UdpCheckBox" IsChecked="True" VerticalAlignment="Center"
                                              Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="UDP" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ProtocolErrorTextBlock" Text="" FontSize="11" Foreground="#E74C3C" Margin="0,4,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12" Background="White">
                    <StackPanel>
                        <TextBlock Text="⚙️ 扫描选项" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,8"/>
                        <CheckBox x:Name="VulnerabilityScanCheckBox" IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,6">
                            <TextBlock Text="漏洞扫描（基于开放端口）" FontSize="12"/>
                        </CheckBox>
                        <CheckBox x:Name="SaveToHistoryCheckBox" IsChecked="True" VerticalAlignment="Center">
                            <TextBlock Text="保存到扫描历史记录" FontSize="12"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Padding="12" Background="#F8F9FA">
                    <StackPanel>
                        <TextBlock Text="📋 扫描流程说明" FontWeight="Bold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,6"/>
                        <TextBlock FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap" LineHeight="18">
                            <Run Text="1. TCP 端口扫描"/><LineBreak/>
                            <Run Text="2. UDP 端口扫描（如勾选）"/><LineBreak/>
                            <Run Text="3. 服务版本识别"/><LineBreak/>
                            <Run Text="4. 漏洞扫描（基于开放端口）"/><LineBreak/>
                            <Run Text="5. 保存结果到历史记录"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="20,12" Background="White">
            <Border.Resources>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="btnBorder" Background="{TemplateBinding Background}" 
                                        CornerRadius="6" Padding="16,8" Cursor="Hand">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Border.Resources>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StartButton" Content="🚀 开始扫描" 
                        Click="StartButton_Click" Background="#27AE60" Foreground="White" 
                        FontWeight="Bold" FontSize="13" Margin="0,0,10,0"/>
                <Button Content="取消" IsCancel="True" 
                        Background="#95A5A6" Foreground="White" FontWeight="Bold" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
