<Window x:Class="NetSecurityScanner.Views.ScanHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📋 扫描历史" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <Border Grid.Row="0" Background="#2C3E50" CornerRadius="4" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="📋 扫描历史记录" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="查看和管理所有历史扫描记录" FontSize="12" Foreground="#BDC3C7" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- 筛选栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBox Grid.Column="0" Name="SearchTextBox" Height="35" FontSize="14" 
                     Padding="10,5" Margin="0,0,10,0" TextChanged="SearchTextBox_TextChanged"/>
            
            <ComboBox Grid.Column="1" Name="RiskFilterComboBox" Height="35" Margin="0,0,10,0" 
                      SelectionChanged="RiskFilterComboBox_SelectionChanged">
                <ComboBoxItem Content="所有风险等级" IsSelected="True"/>
                <ComboBoxItem Content="严重"/>
                <ComboBoxItem Content="高危"/>
                <ComboBoxItem Content="中危"/>
                <ComboBoxItem Content="低危"/>
            </ComboBox>
            
            <ComboBox Grid.Column="2" Name="DateFilterComboBox" Height="35" Margin="0,0,10,0"
                      SelectionChanged="DateFilterComboBox_SelectionChanged">
                <ComboBoxItem Content="所有时间" IsSelected="True"/>
                <ComboBoxItem Content="今天"/>
                <ComboBoxItem Content="最近7天"/>
                <ComboBoxItem Content="最近30天"/>
            </ComboBox>
            
            <Button Grid.Column="3" Name="RefreshButton" Content="🔄 刷新" Width="100" Height="35" 
                    Background="#3498DB" Foreground="White" FontWeight="Bold" Click="RefreshButton_Click"/>
        </Grid>
        
        <!-- 历史记录列表 -->
        <Border Grid.Row="2" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4">
            <DataGrid Name="HistoryDataGrid" AutoGenerateColumns="False" 
                      CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F8F9FA" SelectionMode="Single"
                      SelectionChanged="HistoryDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="扫描ID" Binding="{Binding ScanId}" Width="80"/>
                    <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="150"/>
                    <DataGridTextColumn Header="扫描时间" Binding="{Binding ScanTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130"/>
                    <DataGridTextColumn Header="扫描模式" Binding="{Binding ScanMode}" Width="100"/>
                    <DataGridTextColumn Header="漏洞总数" Binding="{Binding TotalVulnerabilities}" Width="80"/>
                    <DataGridTextColumn Header="严重" Binding="{Binding CriticalCount}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#E74C3C"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="高危" Binding="{Binding HighCount}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#E67E22"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="中危" Binding="{Binding MediumCount}" Width="50"/>
                    <DataGridTextColumn Header="低危" Binding="{Binding LowCount}" Width="50"/>
                    <DataGridTextColumn Header="扫描时长" Binding="{Binding ScanDuration}" Width="80"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding ScanStatus}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        
        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="ViewDetailsButton" Content="👁️ 查看详情" Width="120" Height="40" 
                    Margin="5" Background="#9B59B6" Foreground="White" FontWeight="Bold" 
                    IsEnabled="False" Click="ViewDetailsButton_Click"/>
            <Button Name="ExportButton" Content="📄 导出记录" Width="120" Height="40" 
                    Margin="5" Background="#27AE60" Foreground="White" FontWeight="Bold" Click="ExportButton_Click"/>
            <Button Name="DeleteButton" Content="🗑️ 删除记录" Width="120" Height="40" 
                    Margin="5" Background="#E74C3C" Foreground="White" FontWeight="Bold" 
                    IsEnabled="False" Click="DeleteButton_Click"/>
            <Button Name="CloseButton" Content="❌ 关闭" Width="100" Height="40" 
                    Margin="5" Background="#95A5A6" Foreground="White" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
