<Window x:Class="NetSecurityScanner.Views.RemediationWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔧 漏洞修复向导" Height="750" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <Border Grid.Row="0" Background="#27AE60" CornerRadius="4" Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="🔧 漏洞修复向导" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="逐步指导您修复发现的安全漏洞" FontSize="12" Foreground="#D5F5E3" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- 修复计划概览 -->
        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="4" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="📋 总漏洞数" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                    <TextBlock Name="TotalVulnerabilitiesTextBlock" Text="0" FontSize="32" FontWeight="Bold" Foreground="#2C3E50"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1">
                    <TextBlock Text="⏱️ 预计修复时间" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                    <TextBlock Name="EstimatedTimeTextBlock" Text="0分钟" FontSize="32" FontWeight="Bold" Foreground="#3498DB"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="✅ 已完成" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                    <TextBlock Name="CompletedCountTextBlock" Text="0" FontSize="32" FontWeight="Bold" Foreground="#27AE60"/>
                </StackPanel>
                
                <StackPanel Grid.Column="3">
                    <TextBlock Text="📊 进度" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                    <TextBlock Name="ProgressTextBlock" Text="0%" FontSize="32" FontWeight="Bold" Foreground="#E67E22"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- 主内容区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧：漏洞列表 -->
            <Border Grid.Column="0" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#ECF0F1" Padding="10">
                        <TextBlock Text="🎯 待修复漏洞列表" FontWeight="Bold" FontSize="14"/>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Name="VulnerabilityListPanel" Margin="5">
                            <!-- 动态生成漏洞项 -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            
            <!-- 右侧：修复步骤 -->
            <Border Grid.Column="1" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- 当前漏洞信息 -->
                    <Border Grid.Row="0" Background="#FFF3E0" CornerRadius="4" Padding="15" Margin="10">
                        <StackPanel>
                            <TextBlock Name="CurrentVulnTitleTextBlock" Text="请选择一个漏洞开始修复" 
                                       FontSize="18" FontWeight="Bold" Foreground="#E65100"/>
                            <TextBlock Name="CurrentVulnDescriptionTextBlock" Text="点击左侧漏洞查看详细修复步骤" 
                                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#666"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Name="CurrentVulnRiskTextBlock" Text="风险等级: -" FontWeight="SemiBold" Margin="0,0,20,0"/>
                                <TextBlock Name="CurrentVulnPortTextBlock" Text="端口: -" Margin="0,0,20,0"/>
                                <TextBlock Name="CurrentVulnServiceTextBlock" Text="服务: -"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    
                    <!-- 修复步骤 -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10">
                        <StackPanel Name="RemediationStepsPanel">
                            <TextBlock Text="👈 请从左侧选择一个漏洞开始修复向导" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="16" Foreground="#95A5A6" Margin="50"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <!-- 底部按钮 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                        <Button Name="CopyCommandButton" Content="📋 复制命令" Width="120" Height="35" 
                                Margin="5" Background="#3498DB" Foreground="White" Click="CopyCommandButton_Click"/>
                        <Button Name="MarkCompletedButton" Content="✅ 标记完成" Width="120" Height="35" 
                                Margin="5" Background="#27AE60" Foreground="White" Click="MarkCompletedButton_Click"/>
                        <Button Name="SkipButton" Content="⏭️ 跳过" Width="100" Height="35" 
                                Margin="5" Background="#95A5A6" Foreground="White" Click="SkipButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="GenerateReportButton" Content="📄 生成修复报告" Width="140" Height="40" 
                    Margin="5" Background="#9B59B6" Foreground="White" FontWeight="Bold" Click="GenerateReportButton_Click"/>
            <Button Name="CloseWizardButton" Content="❌ 关闭向导" Width="120" Height="40" 
                    Margin="5" Background="#E74C3C" Foreground="White" FontWeight="Bold" Click="CloseWizardButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
