<Window x:Class="NetSecurityScanner.Views.NetworkTopologyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🌐 网络拓扑发现" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0984e3" Offset="0"/>
                    <GradientStop Color="#00b894" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <StackPanel>
                    <TextBlock Text="🌐 网络拓扑发现与可视化" FontSize="26" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="自动发现网络设备并生成可视化拓扑图，分析设备间关系" FontSize="13" Foreground="#dfe6e9" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Name="ExportButton" Content="📄 导出结果" Width="100" Height="35"
                            Margin="0,0,8,0" Background="White" Foreground="#0984e3" BorderThickness="0"
                            FontWeight="SemiBold" IsEnabled="False" Click="ExportButton_Click" Cursor="Hand"/>
                    <Button Name="CloseButton" Content="✖ 关闭" Width="80" Height="35"
                            Background="#e17055" Foreground="White" BorderThickness="0"
                            FontWeight="SemiBold" Click="CloseButton_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 扫描控制 -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15"
                BorderBrush="#e0e0e0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="网络范围:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" FontSize="14"/>
                    <TextBox Name="NetworkRangeTextBox" Width="280" Height="35" FontSize="14"
                             Padding="10,5" Text="192.168.1.0/24"/>
                    <TextBlock Text="示例: 192.168.1.0/24 或 10.0.0.1-10.0.0.254"
                               VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" FontSize="12"/>
                </StackPanel>

                <Button Grid.Column="3" Name="StartDiscoveryButton" Content="🔍 开始发现" Width="130" Height="40"
                        Margin="10,0,0,0" Background="#00b894" Foreground="White" FontWeight="Bold" Click="StartDiscoveryButton_Click" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#e0e0e0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：拓扑图区域 -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 拓扑图工具栏 -->
                    <Border Grid.Row="0" Background="#f8f9fa" Padding="10" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊 网络拓扑图" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,15,0"/>
                                <Button Name="RefreshLayoutButton" Content="🔄 刷新布局" Width="100" Height="28"
                                        Margin="0,0,5,0" Background="#3498db" Foreground="White" BorderThickness="0"
                                        Click="RefreshLayoutButton_Click" Cursor="Hand"/>
                                <Button Name="ZoomInButton" Content="🔍+ 放大" Width="80" Height="28"
                                        Margin="0,0,5,0" Background="#2ecc71" Foreground="White" BorderThickness="0"
                                        Click="ZoomInButton_Click" Cursor="Hand"/>
                                <Button Name="ZoomOutButton" Content="🔍- 缩小" Width="80" Height="28"
                                        Margin="0,0,5,0" Background="#e67e22" Foreground="White" BorderThickness="0"
                                        Click="ZoomOutButton_Click" Cursor="Hand"/>
                                <Button Name="ResetViewButton" Content="🎯 重置视图" Width="100" Height="28"
                                        Background="#9b59b6" Foreground="White" BorderThickness="0"
                                        Click="ResetViewButton_Click" Cursor="Hand"/>
                                <Separator Width="1" Background="#e0e0e0" Margin="10,0"/>
                                <Button Name="ExportImageButton" Content="🖼️ 导出图片" Width="90" Height="28"
                                        Margin="0,0,5,0" Background="#e74c3c" Foreground="White" BorderThickness="0"
                                        Click="ExportImageButton_Click" Cursor="Hand"/>
                                <Button Name="AnalysisReportButton" Content="📈 分析报告" Width="100" Height="28"
                                        Margin="0,0,5,0" Background="#2c3e50" Foreground="White" BorderThickness="0"
                                        Click="AnalysisReportButton_Click" Cursor="Hand"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock Text="搜索:" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,5,0"/>
                                <TextBox Name="SearchTextBox" Width="150" Height="26" Margin="0,0,15,0"
                                         VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged"
                                         Padding="5,2"/>
                                <TextBlock Text="节点数:" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,5,0"/>
                                <TextBlock Name="NodeCountTextBlock" Text="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,15,0"/>
                                <TextBlock Text="连线数:" VerticalAlignment="Center" Foreground="Gray" Margin="0,0,5,0"/>
                                <TextBlock Name="EdgeCountTextBlock" Text="0" VerticalAlignment="Center" FontWeight="Bold" Foreground="#2c3e50"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 拓扑图Canvas -->
                    <Border Grid.Row="1" BorderBrush="#e0e0e0" BorderThickness="0">
                        <Grid>
                            <ScrollViewer Name="TopologyScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#fafbfc">
                                <Viewbox Name="TopologyViewbox" Stretch="Uniform" StretchDirection="Both">
                                    <Canvas Name="TopologyCanvas" Width="2000" Height="1200" Background="Transparent"
                                            MouseRightButtonDown="TopologyCanvas_MouseRightButtonDown">
                                        <Canvas.ContextMenu>
                                            <ContextMenu Name="TopologyContextMenu">
                                                <MenuItem Name="ContextMenuViewDetail" Header="📋 查看详细信息" Click="ContextMenuViewDetail_Click"/>
                                                <MenuItem Name="ContextMenuHighlight" Header="🌟 高亮显示" Click="ContextMenuHighlight_Click"/>
                                                <MenuItem Name="ContextMenuHide" Header="👁️ 隐藏/显示" Click="ContextMenuHide_Click"/>
                                                <Separator/>
                                                <MenuItem Name="ContextMenuFitScreen" Header="🎯 适应屏幕" Click="ContextMenuFitScreen_Click"/>
                                                <MenuItem Name="ContextMenuExportImage" Header="🖼️ 导出为图片" Click="ContextMenuExportImage_Click"/>
                                            </ContextMenu>
                                        </Canvas.ContextMenu>
                                        <Canvas.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="TopologyScaleTransform" ScaleX="1" ScaleY="1"/>
                                                <TranslateTransform x:Name="TopologyTranslateTransform" X="0" Y="0"/>
                                            </TransformGroup>
                                        </Canvas.RenderTransform>
                                    </Canvas>
                                </Viewbox>
                            </ScrollViewer>

                            <!-- 图例面板 -->
                            <Border Name="LegendPanel" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,15,0,0"
                                    Background="#FFFFFF" CornerRadius="8" Padding="12" Opacity="0.95"
                                    BorderBrush="#e0e0e0" BorderThickness="1" Width="160">
                                <StackPanel>
                                    <TextBlock Text="🎨 图例说明" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Ellipse Width="12" Height="12" Fill="#E67E22" Margin="0,0,8,0"/>
                                        <TextBlock Text="路由器" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Ellipse Width="12" Height="12" Fill="#3498DB" Margin="0,0,8,0"/>
                                        <TextBlock Text="交换机" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Ellipse Width="12" Height="12" Fill="#0078D4" Margin="0,0,8,0"/>
                                        <TextBlock Text="Windows" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Ellipse Width="12" Height="12" Fill="#00B894" Margin="0,0,8,0"/>
                                        <TextBlock Text="Linux" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Ellipse Width="12" Height="12" Fill="#E74C3C" Margin="0,0,8,0"/>
                                        <TextBlock Text="Web服务器" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Ellipse Width="12" Height="12" Fill="#9B59B6" Margin="0,0,8,0"/>
                                        <TextBlock Text="数据库" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Ellipse Width="12" Height="12" Fill="#F39C12" Margin="0,0,8,0"/>
                                        <TextBlock Text="DNS" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Rectangle Height="2" Fill="#3498DB" Margin="0,8,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5">
                                        <Rectangle Width="25" Height="2" Fill="#3498DB" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="设备连线" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,3">
                                        <Rectangle Width="25" Height="3" Fill="#E74C3C" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="网关连接" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 子网分组信息 -->
                            <Border Name="SubnetInfoPanel" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,15,0"
                                    Background="#FFFFFF" CornerRadius="8" Padding="12" Opacity="0.95"
                                    BorderBrush="#e0e0e0" BorderThickness="1" Width="180" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="🌐 子网信息" FontWeight="Bold" FontSize="13" Foreground="#2c3e50" Margin="0,0,0,8"/>
                                    <StackPanel Name="SubnetListPanel"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 右侧：设备列表和详情 -->
                <Border Grid.Column="1" Width="380" BorderBrush="#e0e0e0" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="280"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 统计信息 -->
                        <Border Grid.Row="0" Background="#f8f9fa" Padding="15" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="📈 网络统计" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,5">
                                        <TextBlock Text="总设备数" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Name="TotalDevicesText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2d3436"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,5">
                                        <TextBlock Text="在线设备" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Name="OnlineDevicesText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#00b894"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,5">
                                        <TextBlock Text="开放端口" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Name="TotalPortsText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0984e3"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,5">
                                        <TextBlock Text="子网数" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Name="SubnetCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#6c5ce7"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,5">
                                        <TextBlock Text="关系数" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Name="RelationshipCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="#e17055"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 设备列表 -->
                        <Border Grid.Row="1" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#f8f9fa" Padding="12" BorderBrush="#e0e0e0" BorderThickness="0,0,0,1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📋 设备列表" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Name="DeviceCountTextBlock" Text="(0)" Margin="10,0,0,0" Foreground="Gray"/>
                                    </StackPanel>
                                </Border>

                                <DataGrid Grid.Row="1" Name="DevicesDataGrid" AutoGenerateColumns="False"
                                          CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                          AlternatingRowBackground="#f8f9fa" BorderThickness="0"
                                          SelectionChanged="DevicesDataGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="IP地址" Binding="{Binding IPAddress}" Width="100"/>
                                        <DataGridTextColumn Header="主机名" Binding="{Binding Hostname}" Width="*"/>
                                        <DataGridTextColumn Header="类型" Binding="{Binding DeviceType}" Width="80"/>
                                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="60">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Online">
                                                            <Setter Property="Foreground" Value="#00b894"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- 设备详情 -->
                        <Border Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Name="DeviceDetailPanel" Margin="15">
                                    <TextBlock Text="👈 选择一个设备查看详情"
                                               HorizontalAlignment="Center" Foreground="#b2bec3"
                                               FontSize="14" Margin="20"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 底部状态栏 -->
        <Border Grid.Row="3" Background="#f8f9fa" CornerRadius="0,0,8,8" Padding="15" Margin="0,15,0,0"
                BorderBrush="#e0e0e0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="StatusTextBlock" Text="就绪" VerticalAlignment="Center" Foreground="Gray" FontSize="13"/>
                <ProgressBar Grid.Column="1" Name="DiscoveryProgressBar" Width="400" Height="20" Margin="20,0" Visibility="Collapsed"/>
                <Button Grid.Column="2" Name="StopDiscoveryButton" Content="⏹ 停止" Width="100" Height="35"
                        IsEnabled="False" Background="#e17055" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Click="StopDiscoveryButton_Click" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
