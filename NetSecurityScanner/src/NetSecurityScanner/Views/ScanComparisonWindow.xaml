<Window x:Class="NetSecurityScanner.Views.ScanComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="扫描结果对比" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <Border Grid.Row="0" Background="#E67E22" CornerRadius="4" Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="📊 扫描结果对比" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="对比两次扫描结果，分析漏洞变化和修复情况" FontSize="12" Foreground="#FADBD8" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- 扫描选择区域 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- 基线扫描 -->
            <Border Grid.Column="0" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="📅 基线扫描" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <ComboBox Name="BaselineScanComboBox" Height="25" Margin="0,0,0,5" SelectionChanged="BaselineScanComboBox_SelectionChanged"/>
                    <TextBlock Name="BaselineScanInfoTextBlock" Text="请选择基线扫描" FontSize="11" Foreground="#7F8C8D"/>
                </StackPanel>
            </Border>
            
            <!-- 对比按钮 -->
            <Button Grid.Column="1" Name="CompareButton" Content="🔍 对比" Width="100" Height="40" 
                    Margin="10,0" Background="#E67E22" Foreground="White" FontWeight="Bold" 
                    VerticalAlignment="Center" Click="CompareButton_Click"/>
            
            <!-- 当前扫描 -->
            <Border Grid.Column="2" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Padding="10">
                <StackPanel>
                    <TextBlock Text="📅 当前扫描" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <ComboBox Name="CurrentScanComboBox" Height="25" Margin="0,0,0,5" SelectionChanged="CurrentScanComboBox_SelectionChanged"/>
                    <TextBlock Name="CurrentScanInfoTextBlock" Text="请选择当前扫描" FontSize="11" Foreground="#7F8C8D"/>
                </StackPanel>
            </Border>
        </Grid>
        
        <!-- 对比结果区域 -->
        <TabControl Grid.Row="2" Name="ComparisonResultTabControl" Visibility="Collapsed">
            <!-- 概览Tab -->
            <TabItem Header="📊 概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- 风险评分变化 -->
                        <Border Background="#F8F9FA" CornerRadius="4" Padding="15" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="风险评分变化" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Name="BaselineRiskScoreTextBlock" Text="0.0" FontSize="36" FontWeight="Bold" Foreground="#3498DB"/>
                                    <TextBlock Text=" → " FontSize="36" Margin="10,0"/>
                                    <TextBlock Name="CurrentRiskScoreTextBlock" Text="0.0" FontSize="36" FontWeight="Bold" Foreground="#E74C3C"/>
                                    <TextBlock Name="RiskScoreChangeTextBlock" Text="(+0.0)" FontSize="24" Margin="15,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        
                        <!-- 统计卡片 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Background="#E8F5E9" CornerRadius="4" Padding="10" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="✅ 修复漏洞" FontWeight="Bold" Foreground="#27AE60"/>
                                    <TextBlock Name="ResolvedCountTextBlock" Text="0" FontSize="28" FontWeight="Bold" Foreground="#27AE60"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="1" Background="#FFEBEE" CornerRadius="4" Padding="10" Margin="5,0">
                                <StackPanel>
                                    <TextBlock Text="⚠️ 新增漏洞" FontWeight="Bold" Foreground="#E74C3C"/>
                                    <TextBlock Name="NewCountTextBlock" Text="0" FontSize="28" FontWeight="Bold" Foreground="#E74C3C"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="2" Background="#FFF3E0" CornerRadius="4" Padding="10" Margin="5,0">
                                <StackPanel>
                                    <TextBlock Text="📌 仍然存在" FontWeight="Bold" Foreground="#E67E22"/>
                                    <TextBlock Name="PersistentCountTextBlock" Text="0" FontSize="28" FontWeight="Bold" Foreground="#E67E22"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="3" Background="#E3F2FD" CornerRadius="4" Padding="10" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="🔄 风险变化" FontWeight="Bold" Foreground="#3498DB"/>
                                    <TextBlock Name="RiskChangedCountTextBlock" Text="0" FontSize="28" FontWeight="Bold" Foreground="#3498DB"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        
                        <!-- 端口变化 -->
                        <Border Background="#F8F9FA" CornerRadius="4" Padding="15">
                            <StackPanel>
                                <TextBlock Text="端口变化" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Name="NewPortsTextBlock" Text="新开放: 0" Margin="0,0,20,0" Foreground="#27AE60"/>
                                    <TextBlock Name="ClosedPortsTextBlock" Text="已关闭: 0" Margin="0,0,20,0" Foreground="#E74C3C"/>
                                    <TextBlock Name="PersistentPortsTextBlock" Text="仍开放: 0" Foreground="#3498DB"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- 新增漏洞Tab -->
            <TabItem Header="⚠️ 新增漏洞">
                <DataGrid Name="NewVulnerabilitiesDataGrid" AutoGenerateColumns="False" 
                          CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8F9FA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CVE编号" Binding="{Binding CveId}" Width="120"/>
                        <DataGridTextColumn Header="漏洞名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="风险等级" Binding="{Binding RiskLevel}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#E74C3C"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60"/>
                        <DataGridTextColumn Header="服务" Binding="{Binding Service}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            
            <!-- 已修复漏洞Tab -->
            <TabItem Header="✅ 已修复">
                <DataGrid Name="ResolvedVulnerabilitiesDataGrid" AutoGenerateColumns="False" 
                          CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8F9FA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CVE编号" Binding="{Binding CveId}" Width="120"/>
                        <DataGridTextColumn Header="漏洞名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="风险等级" Binding="{Binding RiskLevel}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#27AE60"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60"/>
                        <DataGridTextColumn Header="服务" Binding="{Binding Service}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            
            <!-- 仍然存在Tab -->
            <TabItem Header="📌 仍然存在">
                <DataGrid Name="PersistentVulnerabilitiesDataGrid" AutoGenerateColumns="False" 
                          CanUserAddRows="False" GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#F8F9FA">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CVE编号" Binding="{Binding CveId}" Width="120"/>
                        <DataGridTextColumn Header="漏洞名称" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="风险等级" Binding="{Binding RiskLevel}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#E67E22"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60"/>
                        <DataGridTextColumn Header="服务" Binding="{Binding Service}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        
        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Name="ExportComparisonButton" Content="📄 导出对比报告" Width="140" Height="35" 
                    Margin="5" Background="#3498DB" Foreground="White" FontWeight="Bold" 
                    IsEnabled="False" Click="ExportComparisonButton_Click"/>
            <Button Name="CloseComparisonButton" Content="❌ 关闭" Width="100" Height="35" 
                    Margin="5" Background="#95A5A6" Foreground="White" Click="CloseComparisonButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
