                                                                Padding="10,8"
                                                                Margin="0,0,0,6"
                                                                BorderBrush="#E2E8F0"
                                                                BorderThickness="1">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0"
                                                                        Width="6"
                                                                        Height="6"
                                                                        CornerRadius="3"
                                                                        Background="#2563EB"
                                                                        VerticalAlignment="Top"
                                                                        Margin="0,5,8,0"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding}"
                                                                           Foreground="#0F172A"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap"
                                                                           LineHeight="18"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Grid>
                            <!-- ROW_SECONDARY_END -->

                            <!-- ROW_FOOTER_START -->
                            <Grid Grid.Row="4"
                                  MinHeight="160">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="260"/>
                                </Grid.ColumnDefinitions>

                                <!-- 风险等级分布条形图（兼容旧字段引用） -->
                                <Border x:Name="AiRiskDistributionPanel"
                                        Grid.Column="0"
                                        Style="{StaticResource AiCardStyle}"
                                        Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="风险等级分布"
                                                   Foreground="#0F172A"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,12"/>

                                        <!-- 严重 -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Width="10"
                                                        Height="10"
                                                        CornerRadius="5"
                                                        Background="#DC2626"
                                                        Margin="0,0,8,0"/>
                                                <TextBlock Text="严重"
                                                           Foreground="#0F172A"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1"
                                                         x:Name="AiRiskCriticalBar"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="0"
                                                         Background="#F1F5F9"
                                                         BorderThickness="0"
                                                         Height="14"
                                                         Margin="0,0,12,0"
                                                         Foreground="#DC2626"/>
                                            <TextBlock Grid.Column="2"
                                                       x:Name="AiRiskCriticalCountText"
                                                       Text="0"
                                                       Foreground="#0F172A"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- 高危 -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Width="10"
                                                        Height="10"
                                                        CornerRadius="5"
                                                        Background="#EA580C"
                                                        Margin="0,0,8,0"/>
                                                <TextBlock Text="高危"
                                                           Foreground="#0F172A"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1"
                                                         x:Name="AiRiskHighBar"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="0"
                                                         Background="#F1F5F9"
                                                         BorderThickness="0"
                                                         Height="14"
                                                         Margin="0,0,12,0"
                                                         Foreground="#EA580C"/>
                                            <TextBlock Grid.Column="2"
                                                       x:Name="AiRiskHighCountText"
                                                       Text="0"
                                                       Foreground="#0F172A"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- 中危 -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Width="10"
                                                        Height="10"
                                                        CornerRadius="5"
                                                        Background="#D97706"
                                                        Margin="0,0,8,0"/>
                                                <TextBlock Text="中危"
                                                           Foreground="#0F172A"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1"
                                                         x:Name="AiRiskMediumBar"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="0"
                                                         Background="#F1F5F9"
                                                         BorderThickness="0"
                                                         Height="14"
                                                         Margin="0,0,12,0"
                                                         Foreground="#D97706"/>
                                            <TextBlock Grid.Column="2"
                                                       x:Name="AiRiskMediumCountText"
                                                       Text="0"
                                                       Foreground="#0F172A"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>

                                        <!-- 低危 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Width="10"
                                                        Height="10"
                                                        CornerRadius="5"
                                                        Background="#65A30D"
                                                        Margin="0,0,8,0"/>
                                                <TextBlock Text="低危"
                                                           Foreground="#0F172A"
                                                           FontSize="12"
                                                           FontWeight="Medium"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <ProgressBar Grid.Column="1"
                                                         x:Name="AiRiskLowBar"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="0"
                                                         Background="#F1F5F9"
                                                         BorderThickness="0"
                                                         Height="14"
                                                         Margin="0,0,12,0"
                                                         Foreground="#65A30D"/>
                                            <TextBlock Grid.Column="2"
                                                       x:Name="AiRiskLowCountText"
                                                       Text="0"
                                                       Foreground="#0F172A"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 右侧目标信息卡 -->
                                <Border Grid.Column="2"
                                        Style="{StaticResource AiCardStyle}"
                                        Padding="14,12">
                                    <StackPanel>
                                        <TextBlock Text="评估目标"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="AiRiskTargetIpText"
                                                   Text="--"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="置信度"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="AiRiskConfidenceText"
                                                   Text="--"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="安全态势评分"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="AiRiskPostureText"
                                                   Text="--"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="就绪度"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock x:Name="AiRiskReadinessText"
                                                   Text="--"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <!-- 空状态提示卡片（覆盖在最上层） -->
                                <Border x:Name="AiRiskEmptyStatePanel"
                                        Visibility="Visible"
                                        Grid.ColumnSpan="3"
                                        Background="#FFFFFF"
                                        CornerRadius="10"
                                        BorderBrush="#E2E8F0"
                                        BorderThickness="1"
                                        Padding="40,60">
                                    <StackPanel HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Border Width="64"
                                                Height="64"
                                                CornerRadius="32"
                                                Background="#EFF6FF"
                                                Margin="0,0,0,16">
                                            <TextBlock Text="AI"
                                                       Foreground="#2563EB"
                                                       FontSize="22"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="暂无扫描数据"
                                                   Foreground="#0F172A"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="请先执行端口扫描或漏洞扫描，AI 风险评估将在扫描完成后自动生成。"
                                                   Foreground="#64748B"
                                                   FontSize="12"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"
                                                   MaxWidth="380"
                                                   Margin="0,0,0,8"/>
                                        <TextBlock Text="或在完成扫描后点击「重新分析」手动刷新。"
                                                   Foreground="#94A3B8"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- ROW_FOOTER_END -->

                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 扫描历史记录 -->
            <TabItem Header="扫描历史记录">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 搜索和过滤控件 -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="5"
                                VerticalAlignment="Center">
                        <TextBox Name="SearchTextBox"
                                 Width="200"
                                 Margin="5"
                                 TextChanged="SearchTextBox_TextChanged"
                                 VerticalAlignment="Center"
                                 ToolTip="搜索：IP、类型、扫描ID"/>
                        <Button Content="搜索"
                                Width="60"
                                Height="25"
                                Margin="5"
                                Click="SearchScanHistory_Click"
                                Background="#3498DB"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                        <Button Content="刷新历史记录"
                                Width="120"
                                Height="25"
                                Margin="5"
                                Click="RefreshScanHistory_Click"
                                Background="#3498DB"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                        <Button Content="清空历史记录"
                                Width="120"
                                Height="25"
                                Margin="5"
                                Click="ClearScanHistory_Click"
                                Background="#E74C3C"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 过滤选项 -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="5"
                                VerticalAlignment="Center">
                        <TextBlock Text="风险等级："
                                   Margin="5"
                                   VerticalAlignment="Center"/>
                        <ComboBox Name="RiskLevelFilterComboBox"
                                  Width="100"
                                  Margin="5"
                                  SelectionChanged="RiskLevelFilterComboBox_SelectionChanged"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="全部"
                                          IsSelected="True"/>
                            <ComboBoxItem Content="严重风险"/>
                            <ComboBoxItem Content="高风险"/>
                            <ComboBoxItem Content="中风险"/>
                            <ComboBoxItem Content="低风险"/>
                        </ComboBox>
                        <TextBlock Text="扫描类型："
                                   Margin="5"
                                   VerticalAlignment="Center"/>
                        <ComboBox Name="ScanTypeFilterComboBox"
                                  Width="120"
                                  Margin="5"
                                  SelectionChanged="ScanTypeFilterComboBox_SelectionChanged"
                                  VerticalAlignment="Center">
                            <ComboBoxItem Content="全部"
                                          IsSelected="True"/>
                            <ComboBoxItem Content="TCP端口扫描"/>
                            <ComboBoxItem Content="UDP端口扫描"/>
                            <ComboBoxItem Content="漏洞扫描"/>
                        </ComboBox>
                        <Button Content="重置过滤"
                                Width="80"
                                Height="25"
                                Margin="5"
                                Click="ResetFilters_Click"
                                Background="#95A5A6"
                                Foreground="White"
                                VerticalAlignment="Center"/>
                        <Button Name="GenerateReportFromHistoryButton"
                                Content="生成报告"
                                Width="120"
                                Height="25"
                                Margin="5"
                                Click="GenerateReportFromHistory_Click"
                                Background="#3498DB"
                                Foreground="White"
                                VerticalAlignment="Center"
                                IsEnabled="False"/>
                    </StackPanel>

                    <!-- 扫描历史记录列表 -->
                    <DataGrid Name="ScanHistoryDataGrid"
                              Grid.Row="2"
                              Margin="5"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#F5F5F5"
                              SelectionMode="Single"
                              MouseDoubleClick="ScanHistoryDataGrid_MouseDoubleClick"
                              CanUserSortColumns="True"
                              IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header=""
                                                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="40"
                                                    CanUserSort="False"
                                                    IsReadOnly="False"/>
                            <DataGridTextColumn Header="扫描ID"
                                                Binding="{Binding ScanId}"
                                                Width="2*"
                                                SortMemberPath="ScanId"/>
                            <DataGridTextColumn Header="目标IP"
                                                Binding="{Binding TargetIp}"
                                                Width="*"
                                                SortMemberPath="TargetIp"/>
                            <DataGridTextColumn Header="扫描类型"
                                                Binding="{Binding ScanType}"
                                                Width="*"
                                                SortMemberPath="ScanType"/>
                            <DataGridTextColumn Header="扫描时间"
                                                Binding="{Binding ScanTime}"
                                                Width="2*"
                                                SortMemberPath="ScanTime"/>
                            <DataGridTextColumn Header="开放端口数"
                                                Binding="{Binding OpenPortsCount}"
                                                Width="*"
                                                SortMemberPath="OpenPortsCount"/>
                            <DataGridTextColumn Header="漏洞数"
                                                Binding="{Binding VulnerabilitiesCount}"
                                                Width="*"
                                                SortMemberPath="VulnerabilitiesCount"/>
                            <DataGridTextColumn Header="风险等级"
                                                Binding="{Binding RiskLevel}"
                                                Width="*"
                                                CellStyle="{StaticResource RiskLevelCellStyle}"
                                                SortMemberPath="RiskLevel"/>
                            <DataGridTemplateColumn Header="操作"
                                                    Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center">
                                            <Button Content="查看"
                                                    Width="50"
                                                    Height="20"
                                                    Click="ViewScanHistory_Click"
                                                    Tag="{Binding ScanId}"
                                                    Background="#3498DB"
                                                    Foreground="White"
                                                    FontSize="12"
                                                    Margin="2"/>
                                            <Button Content="删除"
                                                    Width="50"
                                                    Height="20"
                                                    Click="DeleteScanHistory_Click"
                                                    Tag="{Binding ScanId}"
                                                    Background="#E74C3C"
                                                    Foreground="White"
                                                    FontSize="12"
                                                    Margin="2"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="🔍 查看详情"
                                          Click="ViewScanHistory_Click"/>
                                <MenuItem Header="🗑 删除记录"
                                          Click="DeleteScanHistory_Click"/>
                                <Separator/>
                                <MenuItem Header="🔌 用插件深挖"
                                          Click="DeepScanHistoryWithPlugins_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Padding"
                                        Value="5"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"
                                        Value="#2C3E50"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                                <Setter Property="Padding"
                                        Value="10"/>
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                    </DataGrid>

                    <!-- 统计信息 -->
                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                Margin="5">
                        <TextBlock Name="ScanHistoryStats"
                                   Text="共 0 条记录"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"/>
                        <TextBlock Name="ScanHistorySummary"
                                   Text=""
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="2"
                   Background="#ECF0F1">
            <StatusBarItem>
                <TextBlock Name="StatusTextBlock"
                           Text="就绪"
                           FontWeight="Bold"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Name="LicenseStatusBarText"
                           Text="授权状态: 检测中..."
                           Margin="10,0"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Name="SystemUptimeText"
                           Text="运行时间: 00:00:00"
                           Margin="10,0"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Name="CpuUsageTextBlock"
                           Text="CPU: 0%"
                           Margin="10,0"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Name="RamUsageTextBlock"
                           Text="内存: 0%"
                           Margin="0,0,10,0"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Name="DiskUsageTextBlock"
                           Text="磁盘: 0%"
                           Margin="0,0,10,0"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Name="NetworkConnectionsTextBlock"
                           Text="网络连接: 0"
                           Margin="0,0,10,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Name="SystemHealthText"
                               Text="系统: 正常"
                               Margin="0,0,10,0"/>
                    <TextBlock Name="StatusVersionText"
                               Text="NetSecurityScanner v1.0"
                               Foreground="#7F8C8D"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>