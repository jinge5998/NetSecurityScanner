<Window x:Class="NetSecurityScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetSecurityScanner"
        xmlns:utils="clr-namespace:NetSecurityScanner.Utils"
        xmlns:oxy="http://oxyplot.org/wpf"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="网络安全扫描工具"
        Height="700"
        Width="1050"
        WindowStartupLocation="CenterScreen"
        TextElement.FontFamily="Microsoft YaHei UI, Microsoft YaHei, SimHei, SimSun, Noto Sans CJK SC, Segoe UI"
        Closing="Window_Closing">
    <Window.Resources>
        <!-- 按钮阴影效果 -->
        <DropShadowEffect x:Key="ButtonShadow"
                          BlurRadius="3"
                          Color="#80000000"
                          Direction="270"
                          Opacity="0.3"
                          RenderingBias="Quality"
                          ShadowDepth="2"/>

        <!-- AI 风险评估仪表盘卡片阴影 -->
        <DropShadowEffect x:Key="AiCardShadow"
                          BlurRadius="14"
                          Color="#80000000"
                          Direction="270"
                          Opacity="0.45"
                          RenderingBias="Quality"
                          ShadowDepth="3"/>

        <!-- 风险等级到颜色的转换器 -->
        <utils:RiskLevelToColorConverter x:Key="RiskLevelToColorConverter"/>

        <!-- 风险等级样式 -->
        <Style x:Key="RiskLevelCellStyle"
               TargetType="DataGridCell">
            <Setter Property="Foreground"
                    Value="{Binding RiskLevel, Converter={StaticResource RiskLevelToColorConverter}}"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
        </Style>

        <!-- AI 风险评估：紫蓝渐变画刷（强调色） -->
        <LinearGradientBrush x:Key="AiAccentGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#2563EB"
                          Offset="0"/>
            <GradientStop Color="#3B82F6"
                          Offset="1"/>
        </LinearGradientBrush>

        <!-- AI 风险评估：白色主题基础画刷 -->
        <SolidColorBrush x:Key="AiCardBackground"
                         Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AiCardBorder"
                         Color="#E2E8F0"/>
        <SolidColorBrush x:Key="AiTextPrimary"
                         Color="#0F172A"/>
        <SolidColorBrush x:Key="AiTextSecondary"
                         Color="#64748B"/>
        <SolidColorBrush x:Key="AiTextTertiary"
                         Color="#94A3B8"/>
        <SolidColorBrush x:Key="AiTrackBackground"
                         Color="#F1F5F9"/>
        <SolidColorBrush x:Key="AiChartTextColor"
                         Color="#64748B"/>
        <SolidColorBrush x:Key="AiChartAxisColor"
                         Color="#CBD5E1"/>
        <SolidColorBrush x:Key="AiChartGridColor"
                         Color="#E2E8F0"/>

        <!-- AI 风险评估：主评分卡片白色渐变（按风险等级动态覆盖） -->
        <LinearGradientBrush x:Key="AiMainCardGradient"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#FFFFFF"
                          Offset="0"/>
            <GradientStop Color="#F8FAFC"
                          Offset="1"/>
        </LinearGradientBrush>

        <!-- AI 风险评估：状态条进度条样式（蓝色 + 浅灰底） -->
        <Style x:Key="AiStatusProgressBarStyle"
               TargetType="ProgressBar">
            <Setter Property="Foreground"
                    Value="{StaticResource AiAccentGradient}"/>
            <Setter Property="Background"
                    Value="#F1F5F9"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Height"
                    Value="6"/>
        </Style>

        <!-- AI 风险评估：重新分析按钮样式（白底蓝边主色按钮） -->
        <Style x:Key="AiRefreshButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#FFFFFF"/>
            <Setter Property="Foreground"
                    Value="#2563EB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="BorderBrush"
                    Value="#2563EB"/>
            <Setter Property="Padding"
                    Value="14,6"/>
            <Setter Property="FontSize"
                    Value="12"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Bd"
                                        Property="Opacity"
                                        Value="0.45"/>
                                <Setter Property="Cursor"
                                        Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- AI 风险评估：白底浅边框卡片通用样式（用于仪表盘所有卡片） -->
        <Style x:Key="AiCardStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="{StaticResource AiCardBackground}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource AiCardBorder}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="10"/>
            <Setter Property="Padding"
                    Value="16,14"/>
        </Style>
    </Window.Resources>
    <!-- 主内容网格 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部菜单栏 -->
        <Menu Grid.Row="0"
              Background="White"
              Foreground="Black">
            <Menu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground"
                            Value="Black"/>
                    <Setter Property="Background"
                            Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="#F0F0F0"/>
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen"
                                 Value="True">
                            <Setter Property="Background"
                                    Value="#F0F0F0"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Menu.Resources>
            <MenuItem Header="文件">
                <MenuItem Header="导出报告"
                          Click="ExportReport_Click"/>
                <Separator/>
                <MenuItem Header="退出"
                          Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="扫描">
                <MenuItem Header="端口扫描"
                          Click="PortScan_Click"/>
                <MenuItem Header="漏洞扫描"
                          Click="VulnerabilityScan_Click"/>
                <MenuItem Header="批量扫描"
                          Click="BatchScan_Click"/>
                <MenuItem Header="开始综合扫描"
                          Click="StartScan_Click"/>
                <MenuItem Header="停止扫描"
                          Click="StopScan_Click"/>
                <Separator/>
                <MenuItem Header="APP 安全扫描"
                          Click="AppScan_Click"/>
                <MenuItem Header="摄像头安全扫描"
                          Click="CameraSecurityScan_Click"/>
                <MenuItem Header="Agent 安全扫描"
                          Click="AgentSecurityScan_Click"/>
                <Separator/>
                <MenuItem Header="专家模式"
                          Click="ExpertMode_Click"/>
            </MenuItem>
            <MenuItem Header="分析">
                <MenuItem Header="统计分析"
                          Click="StatisticsDashboard_Click"/>
                <MenuItem Header="可视化图表"
                          Click="Visualization_Click"/>
                <MenuItem Header="网络拓扑"
                          Click="NetworkTopology_Click"/>
                <MenuItem Header="攻击路径分析"
                          Click="ViewAttackPaths_Click"/>
                <Separator/>
                <MenuItem Header="攻击日志查询"
                          Click="AttackLogQuery_Click"/>
            </MenuItem>
            <MenuItem Header="工具">
                <MenuItem Header="生成端口关闭脚本"
                          Click="GenerateBat_Click"/>
                <MenuItem Header="更新漏洞库"
                          Click="UpdateVulnerabilityDatabase_Click"/>
                <MenuItem Header="合规检查"
                          Click="ComplianceCheck_Click"/>
                <MenuItem Header="漏洞知识库"
                          Click="VulnerabilityKnowledgeBase_Click"/>
                <MenuItem Header="网页后缀追踪"
                          Click="WebPathTracer_Click"/>
                <Separator/>
                <MenuItem Header="🔌 插件扫描"
                          Click="PluginScanButton_Click"/>
                <MenuItem Header="插件管理"
                          Click="PluginManager_Click"/>
                <MenuItem Header="资产管理"
                          Click="AssetManagement_Click"/>
            </MenuItem>
            <MenuItem Header="授权管理">
                <MenuItem Header="🔑 授权码生成器"
                          Click="LicenseCodeGenerator_Click"/>
                <Separator/>
                <MenuItem Header="📋 授权码激活"
                          Click="LicenseManager_Click"/>
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于"
                          Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- 主内容区域 -->
        <TabControl Name="MainTabControl"
                    Grid.Row="1"
                    Margin="10">
            <!-- 端口扫描 -->
            <TabItem Header="端口扫描">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 第一行：目标输入 -->
                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="5">
                        <!-- 目标IP地址输入 -->
                        <Label Content="目标IP/域名："
                               VerticalAlignment="Center"/>
                        <TextBox Name="TargetIpTextBox"
                                 Text="127.0.0.1"
                                 Width="180"
                                 Margin="5"
                                 ToolTip="输入目标IP地址或域名"/>

                        <!-- 端口范围输入 -->
                        <Label Content="端口范围："
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                        <TextBox Name="PortRangeTextBox"
                                 Text="1-1000"
                                 Width="100"
                                 Margin="5"
                                 ToolTip="输入端口范围，如：1-1000 或 22,80,443"/>

                        <!-- 扫描类型选择 -->
                        <Label Content="扫描类型："
                               VerticalAlignment="Center"/>
                        <ComboBox Name="ScanTypeComboBox"
                                  Width="100"
                                  Margin="5"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="TCP"
                                          ToolTip="使用TCP协议进行端口扫描"/>
                            <ComboBoxItem Content="UDP"
                                          ToolTip="使用UDP协议进行端口扫描"/>
                        </ComboBox>

                        <!-- 开始/停止扫描按钮 -->
                        <Button Name="StartPortScanButton"
                                Content="开始扫描"
                                Width="80"
                                Height="30"
                                Margin="5"
                                Click="StartPortScan_Click"
                                Background="#3498DB"
                                Foreground="White"
                                FontWeight="Bold"/>
                        <Button Name="StopPortScanButton"
                                Content="停止扫描"
                                Width="80"
                                Height="30"
                                Margin="5"
                                Click="StopScan_Click"
                                Background="#E74C3C"
                                Foreground="White"
                                FontWeight="Bold"
                                IsEnabled="False"/>

                        <!-- 自动扫描复选框 -->
                        <CheckBox Name="AutoScanCheckBox"
                                  Content="自动扫描常用端口"
                                  Margin="15,0"
                                  VerticalAlignment="Center"
                                  ToolTip="扫描常用端口：21,22,23,25,53,80,110,143,443,465,993,995,1433,3306,3389,5432,8080,8443"/>
                    </StackPanel>


                    <DataGrid Name="PortScanResultsDataGrid"
                              Grid.Row="2"
                              Margin="5"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#F5F5F5"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              CanUserResizeRows="False"
                              RowHeight="35"
                              SelectionChanged="PortScanResultsDataGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="端口号"
                                                Binding="{Binding PortNumber}"
                                                Width="*"
                                                SortMemberPath="PortNumber"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="状态"
                                                Binding="{Binding Status}"
                                                Width="*"
                                                SortMemberPath="Status"
                                                IsReadOnly="True">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Foreground"
                                                Value="{Binding Status, Converter={StaticResource RiskLevelToColorConverter}}"/>
                                        <Setter Property="FontWeight"
                                                Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="服务"
                                                Binding="{Binding Service}"
                                                Width="*"
                                                SortMemberPath="Service"
                                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="服务版本"
                                                Binding="{Binding ServiceVersion}"
                                                Width="2*"
                                                SortMemberPath="ServiceVersion"
                                                IsReadOnly="True">
                                <DataGridTextColumn.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="ToolTip"
                                                Value="{Binding ServiceVersion}"/>
                                        <Setter Property="TextBlock.TextTrimming"
                                                Value="CharacterEllipsis"/>
                                        <Setter Property="TextBlock.TextWrapping"
                                                Value="NoWrap"/>
                                    </Style>
                                </DataGridTextColumn.CellStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping"
                                                Value="NoWrap"/>
                                        <Setter Property="VerticalAlignment"
                                                Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="选择"
                                                    Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="*"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height"
                                        Value="35"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="开放">
                                        <Setter Property="Background"
                                                Value="#E8F5E8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Status}"
                                                 Value="开放或过滤">
                                        <Setter Property="Background"
                                                Value="#FFF8E1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="VerticalAlignment"
                                        Value="Center"/>
                                <Setter Property="Padding"
                                        Value="5"/>
                                <Setter Property="TextBlock.TextWrapping"
                                        Value="NoWrap"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"
                                        Value="#2C3E50"/>
                                <Setter Property="Foreground"
                                        Value="White"/>
                                <Setter Property="FontWeight"
                                        Value="Bold"/>
                                <Setter Property="Padding"
                                        Value="10"/>
                                <Setter Property="HorizontalContentAlignment"
                                        Value="Center"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                    </DataGrid>

                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Margin="5">
                        <Button Content="全选"
                                Width="60"
                                Height="25"
                                Margin="5"
                                Click="SelectAllPorts_Click"
                                Background="#3498DB"
                                Foreground="White"/>
                        <Button Content="取消全选"
                                Width="80"
                                Height="25"
                                Margin="5"
                                Click="UnselectAllPorts_Click"
                                Background="#95A5A6"
                                Foreground="White"/>
                        <Button Name="GeneratePortBatButton"
                                Content="生成关闭端口BAT"
                                Width="140"
                                Height="30"
                                Margin="5"
                                Click="GeneratePortBat_Click"
                                IsEnabled="False"
                                Foreground="White">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background"
                                            Value="#E74C3C"/>
                                    <Setter Property="Foreground"
                                            Value="White"/>
                                    <Setter Property="FontWeight"
                                            Value="Bold"/>
                                    <Setter Property="FontSize"
                                            Value="12"/>
                                    <Setter Property="BorderBrush"
                                            Value="#C0392B"/>
                                    <Setter Property="BorderThickness"
                                            Value="1"/>
                                    <Setter Property="Padding"
                                            Value="10,5"/>
                                    <Setter Property="HorizontalContentAlignment"
                                            Value="Center"/>
                                    <Setter Property="VerticalContentAlignment"
                                            Value="Center"/>
                                    <Setter Property="Cursor"
                                            Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="4"
                                                        Effect="{StaticResource ButtonShadow}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                      RecognizesAccessKey="True"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">
                                                        <Setter Property="Background"
                                                                Value="#C0392B"/>
                                                        <Setter Property="BorderBrush"
                                                                Value="#A93226"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed"
                                                             Value="True">
                                                        <Setter Property="Background"
                                                                Value="#A93226"/>
                                                        <Setter Property="BorderBrush"
                                                                Value="#8E24AA"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled"
                                                             Value="False">
                                                        <Setter Property="Background"
                                                                Value="#BDC3C7"/>
                                                        <Setter Property="BorderBrush"
                                                                Value="#95A5A6"/>
                                                        <Setter Property="Foreground"
                                                                Value="#7F8C8D"/>
                                                        <Setter Property="Cursor"
                                                                Value="No"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Name="ScanProgressText"
                                   Text="就绪"
                                   VerticalAlignment="Center"
                                   Margin="10,0"
                                   FontWeight="Bold"/>
                        <ProgressBar Name="ScanProgressBar"
                                     Width="150"
                                     Height="20"
                                     Margin="10,0"
                                     Minimum="0"
                                     Maximum="100"
                                     Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- 漏洞扫描 -->
            <TabItem Header="漏洞扫描">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Vertical"
                                Margin="5">
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,5">
                            <!-- 目标输入（同样添加智能验证） -->
                            <Label Content="扫描目标："
                                   VerticalAlignment="Center"/>
                            <TextBox Name="VulnTargetTextBox"
                                     Text="127.0.0.1"
                                     Width="200"
                                     Margin="5"
                                     ToolTip="输入要进行漏洞扫描的目标IP地址或域名"/>
                            <Button Name="StartVulnScanButton"
                                    Content="开始漏洞扫描"
                                    Width="120"
                                    Height="25"
                                    Margin="5"
                                    Click="StartVulnScan_Click"
                                    Background="#3498DB"
                                    Foreground="White"/>
                            <Button Name="StopVulnScanButton"
                                    Content="停止扫描"
                                    Width="80"
                                    Height="25"
                                    Margin="5"
                                    Click="StopScan_Click"
                                    Background="#E74C3C"
                                    Foreground="White"
                                    IsEnabled="False"/>
                        </StackPanel>

                        <!-- 漏洞扫描进度指示器（保持原有设计） -->
                        <Border BorderThickness="1"
                                BorderBrush="#3498DB"
                                Background="#E8F4FC"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,5,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,5">
                                    <TextBlock Name="VulnScanProgressText"
                                               Text="准备就绪"
                                               FontSize="12"
                                               Foreground="#2C3E50"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Name="VulnScanProgressPercent"
                                               Text="0%"
                                               FontSize="12"
                                               Foreground="#7F8C8D"
                                               Margin="10,0,0,0"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                                <ProgressBar Name="VulnScanProgressBar"
                                             Height="15"
                                             Maximum="100"
                                             Minimum="0"
                                             Value="0"
                                             Background="#BDC3C7"
                                             Foreground="#3498DB"
                                             BorderThickness="0"
                                             Margin="0,2,0,0"/>
                                <TextBlock Name="VulnScanCurrentStage"
                                           Text="等待开始扫描..."
                                           FontSize="11"
                                           Foreground="#7F8C8D"
                                           FontStyle="Italic"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <DataGrid Name="VulnerabilityResultsDataGrid"
                              Grid.Row="2"
                              Margin="5"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              GridLinesVisibility="All"
                              HeadersVisibility="Column"
                              AlternatingRowBackground="#F5F5F5"
                              IsReadOnly="True"
                              CanUserSortColumns="True"
                              SelectionMode="Single"
                              CanUserResizeRows="False"
                              RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号"
                                                Binding="{Binding Id}"
                                                Width="0.6*"
                                                SortMemberPath="Id">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment"
                                                Value="Center"/>
                                        <Setter Property="HorizontalAlignment"
                                                Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="漏洞名称"
                                                Binding="{Binding Name}"
                                                Width="1.8*"
                                                SortMemberPath="Name">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming"
                                                Value="CharacterEllipsis"/>
                                        <Setter Property="VerticalAlignment"
                                                Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="风险等级"
                                                Binding="{Binding RiskLevel}"
                                                Width="0.8*"
                                                CellStyle="{StaticResource RiskLevelCellStyle}"
                                                SortMemberPath="RiskLevel">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment"
                                                Value="Center"/>
                                        <Setter Property="FontSize"
                                                Value="12"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="端口"
                                                Binding="{Binding Port}"
                                                Width="0.7*"
                                                SortMemberPath="Port">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment"
                                                Value="Center"/>
                                        <Setter Property="HorizontalAlignment"
                                                Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="服务"
                                                Binding="{Binding Service}"
                                                Width="1.2*"
                                                SortMemberPath="Service">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment"
                                                Value="Center"/>
