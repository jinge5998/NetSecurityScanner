<Window x:Class="NetSecurityScanner.Views.ScanProgressLiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛡️ 综合扫描实时进度" Height="480" Width="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" MinHeight="400" MinWidth="600"
        Background="#F5F6FA">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2C3E50" Offset="0"/>
                    <GradientStop Color="#3498DB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="🛡️ 综合扫描进行中..." FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="TargetText" Text="" FontSize="11" Foreground="#BDC3C7" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- 总体进度 + 阶段步骤条 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE1E7" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel LastChildFill="True" Margin="0,0,0,8">
                    <TextBlock x:Name="StatusText" Text="准备中..." FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="PercentText" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#3498DB" DockPanel.Dock="Right"/>
                </DockPanel>
                <ProgressBar x:Name="MainProgressBar" Height="14" Minimum="0" Maximum="100" Value="0"
                             Foreground="#3498DB" Background="#ECEFF1" BorderThickness="0"/>
                <DockPanel LastChildFill="True" Margin="0,6,0,0">
                    <TextBlock x:Name="ElapsedText" Text="已用 0:00" FontSize="11" Foreground="#7F8C8D" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="RemainingText" Text="剩余 --:--" FontSize="11" Foreground="#7F8C8D" DockPanel.Dock="Right"/>
                </DockPanel>

                <!-- 6 阶段步骤条 -->
                <ItemsControl x:Name="PhaseStepper" Margin="0,12,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 中部：当前阶段详情 + 已发现端口列表 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- 当前阶段详情 -->
            <Border Grid.Column="0" Background="White" BorderBrush="#DDE1E7" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="📡 当前阶段详情" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBlock x:Name="CurrentPhaseText" Text="等待开始..." FontSize="12" Foreground="#2C3E50" Margin="0,0,0,6"/>
                    <ProgressBar x:Name="SubProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                                 Foreground="#27AE60" Background="#ECEFF1" BorderThickness="0"/>
                    <TextBlock x:Name="CurrentItemText" Text="" FontSize="11" Foreground="#7F8C8D" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 已发现端口列表 -->
            <Border Grid.Column="1" Background="White" BorderBrush="#DDE1E7" BorderThickness="1" CornerRadius="6" Padding="14">
                <DockPanel>
                    <TextBlock Text="🔓 已发现开放端口" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                    <TextBlock x:Name="PortCountText" Text="0 个" FontSize="11" Foreground="#7F8C8D" DockPanel.Dock="Top" Margin="0,0,0,6"/>
                    <ListBox x:Name="DiscoveredPortsList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             FontFamily="Consolas, Courier New" FontSize="12"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="⛔ 取消扫描" Width="120" Height="32" Click="CancelButton_Click"
                    Background="#E74C3C" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
