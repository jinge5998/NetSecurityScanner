<Window x:Class="NetSecurityScanner.Views.IpQueryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IP查询工具 v1.0" Height="750" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="InfoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="5,3"/>
        </Style>
        <Style x:Key="InfoValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#27AE60"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🌐" FontSize="24" VerticalAlignment="Center"/>
                <TextBlock Text="IP查询工具" FontSize="20" FontWeight="Bold"
                          Foreground="White" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock Text="支持域名解析、IP归属地、Ping测试、Whois查询、IP段扫描"
                          FontSize="12" Foreground="#BDC3C7" VerticalAlignment="Center" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 查询输入区域 -->
        <GroupBox Grid.Row="1" Header="🔍 查询输入" Margin="10,10,10,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 域名/IP输入框 -->
                <TextBox Grid.Row="0" Grid.Column="0" Name="QueryTextBox"
                        Margin="5" ToolTip="输入域名（如 example.com）或IP地址（如 8.8.8.8），多个用逗号分隔"
                        KeyDown="QueryTextBox_KeyDown"/>

                <!-- 查询按钮 -->
                <Button Grid.Row="0" Grid.Column="1" Content="🔍 查询"
                       Click="Query_Click" Margin="5" MinWidth="100"/>
                <Button Grid.Row="0" Grid.Column="2" Content="📡 Ping"
                       Click="Ping_Click" Margin="5" MinWidth="80"
                       Background="#16A085"/>
                <Button Grid.Row="0" Grid.Column="3" Content="🗑️ 清除"
                       Click="Clear_Click" Margin="5" MinWidth="80"
                       Background="#E74C3C"/>

                <!-- 查询选项 -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="5,10,5,0">
                    <CheckBox Name="ResolveDnsCheckBox" Content="域名解析 (DNS)" IsChecked="True"
                             VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <CheckBox Name="IpLocationCheckBox" Content="IP归属地" IsChecked="True"
                             VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <CheckBox Name="IpDetailsCheckBox" Content="IP详细信息" IsChecked="True"
                             VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <CheckBox Name="ReverseDnsCheckBox" Content="反向解析" IsChecked="True"
                             VerticalAlignment="Center" Margin="0,0,15,0"/>
                    <CheckBox Name="PingTestCheckBox" Content="Ping测试" IsChecked="False"
                             VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 批量查询和IP段扫描 -->
                <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="5,10,5,0">
                    <Label Content="IP段扫描:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Name="IpRangeTextBox" Width="180" Margin="0,0,5,0"
                            ToolTip="输入IP段，如 192.168.1.0/24" Text="192.168.1.0/24"/>
                    <Button Content="🔍 扫描" Click="ScanIpRange_Click" Margin="5,0" MinWidth="80"
                           Background="#9B59B6"/>
                    <Button Content="📋 批量解析" Click="BatchResolve_Click" Margin="5,0" MinWidth="100"
                           Background="#F39C12"/>
                    <Button Content="📥 导出结果" Click="ExportResults_Click" Margin="5,0" MinWidth="100"
                           Background="#27AE60"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 结果显示区域 - 使用TabControl -->
        <Grid Grid.Row="2" Margin="10,5,10,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabControl Name="ResultTabs">
                <!-- Tab 1: DNS解析 -->
                <TabItem Header="🌐 DNS解析">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#ECF0F1" Padding="10" Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="解析结果：" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Name="DnsCountText" Text="0" Style="{StaticResource InfoValue}"/>
                                <TextBlock Text=" 个域名/IP" Style="{StaticResource InfoLabel}"/>
                                <Separator Width="20"/>
                                <TextBlock Text="总耗时：" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Name="DnsDurationText" Text="0" Style="{StaticResource InfoValue}"/>
                                <TextBlock Text=" ms" Style="{StaticResource InfoLabel}"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1" Name="DnsResultsGrid" AutoGenerateColumns="False"
                                 IsReadOnly="True" Margin="5"
                                 GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                 Background="White" BorderThickness="1" BorderBrush="#BDC3C7">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="50"/>
                                <DataGridTextColumn Header="域名/IP" Binding="{Binding Source}" Width="*"/>
                                <DataGridTextColumn Header="解析IP" Binding="{Binding IpAddress}" Width="*"/>
                                <DataGridTextColumn Header="类型" Binding="{Binding AddressType}" Width="60"/>
                                <DataGridTextColumn Header="地址族" Binding="{Binding AddressFamily}" Width="70"/>
                                <DataGridTextColumn Header="耗时(ms)" Binding="{Binding DurationMs}" Width="80"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"/>
                                <DataGridTemplateColumn Header="操作" Width="160">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="详情" Click="QueryIpDetail_Click"
                                                       FontSize="11" Padding="5,2" Margin="1"
                                                       Background="#9B59B6"/>
                                                <Button Content="Ping" Click="PingIp_Click"
                                                       FontSize="11" Padding="5,2" Margin="1"
                                                       Background="#16A085"/>
                                                <Button Content="复制" Click="CopyIp_Click"
                                                       FontSize="11" Padding="5,2" Margin="1"
                                                       Background="#34495E"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab 2: IP归属地 -->
                <TabItem Header="📍 IP归属地">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Name="IpLocationPanel" Visibility="Visible" Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="📍 IP地址：" Style="{StaticResource InfoLabel}" FontWeight="Bold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Name="LocationIpText" Style="{StaticResource InfoValue}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="🌍 国家/地区：" Style="{StaticResource InfoLabel}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Name="LocationCountryFlag" Text="🏳️" FontSize="18" VerticalAlignment="Center"/>
                                <TextBlock Name="LocationCountryText" Style="{StaticResource InfoValue}" Margin="8,3"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="🏙️ 省份/州：" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Name="LocationRegionText" Style="{StaticResource InfoValue}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="🏘️ 城市：" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Name="LocationCityText" Style="{StaticResource InfoValue}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="📮 邮编：" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Name="LocationZipText" Style="{StaticResource InfoValue}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="🌐 ISP/运营商：" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Name="LocationIspText" Style="{StaticResource InfoValue}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="📐 经纬度：" Style="{StaticResource InfoLabel}"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Name="LocationCoordsText" Style="{StaticResource InfoValue}"/>
                                <Button Content="🗺️ 打开地图" Click="OpenMap_Click" Margin="10,0,0,0"
                                       FontSize="11" Padding="8,2" Background="#3498DB"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 3: IP详细信息 -->
                <TabItem Header="📋 IP详细信息">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Name="IpDetailsPanel" Visibility="Visible" Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="🔢 ASN：" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Name="DetailAsnText" Style="{StaticResource InfoValue}"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="🏢 组织：" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Name="DetailOrgText" Style="{StaticResource InfoValue}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="🖧 网络段：" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Name="DetailNetworkText" Style="{StaticResource InfoValue}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="💻 主机名：" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Name="DetailHostnameText" Style="{StaticResource InfoValue}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="🕐 时区：" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Name="DetailTimezoneText" Style="{StaticResource InfoValue}"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="🌏 地区代码：" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Grid.Row="5" Grid.Column="1" Name="DetailRegionCodeText" Style="{StaticResource InfoValue}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="💰 货币：" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" Name="DetailCurrencyText" Style="{StaticResource InfoValue}"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="🗣️ 语言：" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Grid.Row="7" Grid.Column="1" Name="DetailLanguageText" Style="{StaticResource InfoValue}"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="🔒 安全等级：" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Grid.Row="8" Grid.Column="1" Name="DetailSecurityText" Style="{StaticResource InfoValue}"/>

                            <TextBlock Grid.Row="9" Grid.Column="0" Text="📊 数据来源：" Style="{StaticResource InfoLabel}"/>
                            <TextBlock Grid.Row="9" Grid.Column="1" Name="DetailSourceText" Style="{StaticResource InfoValue}"/>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 4: Ping测试 -->
                <TabItem Header="📡 Ping测试">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#ECF0F1" Padding="10" Margin="0,0,0,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Ping目标：" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Name="PingTargetText" Text="-" Style="{StaticResource InfoValue}"/>
                                <Separator Width="20"/>
                                <TextBlock Text="平均延迟：" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Name="PingAvgText" Text="0" Style="{StaticResource InfoValue}"/>
                                <TextBlock Text=" ms" Style="{StaticResource InfoLabel}"/>
                                <Separator Width="20"/>
                                <TextBlock Text="丢包率：" Style="{StaticResource InfoLabel}"/>
                                <TextBlock Name="PingLossText" Text="0%" Style="{StaticResource InfoValue}"/>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1" Name="PingResultsGrid" AutoGenerateColumns="False"
                                 IsReadOnly="True"
                                 GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                 Background="White" BorderThickness="1" BorderBrush="#BDC3C7">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="50"/>
                                <DataGridTextColumn Header="字节" Binding="{Binding Bytes}" Width="80"/>
                                <DataGridTextColumn Header="目标" Binding="{Binding Address}" Width="*"/>
                                <DataGridTextColumn Header="序号/TTL" Binding="{Binding Sequence}" Width="100"/>
                                <DataGridTextColumn Header="延迟(ms)" Binding="{Binding RttMs}" Width="100"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab 5: Whois查询 -->
                <TabItem Header="🔍 Whois">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="5">
                        <TextBox Name="WhoisResultText" IsReadOnly="True" FontFamily="Consolas"
                                FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                Background="#1E1E1E" Foreground="#00FF00" Padding="10"
                                Text="点击查询按钮获取Whois信息..."/>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 6: 查询历史 -->
                <TabItem Header="📜 查询历史">
                    <DataGrid Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                             Margin="5"
                             GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                             Background="White" BorderThickness="1" BorderBrush="#BDC3C7">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="150"/>
                            <DataGridTextColumn Header="查询内容" Binding="{Binding Query}" Width="*"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="100"/>
                            <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="#ECF0F1" Padding="10,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="状态：" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                <TextBlock Name="StatusText" Text="就绪" Foreground="#27AE60" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,20,0"/>
                <Separator Width="20"/>
                <TextBlock Text="数据源：" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                <TextBlock Text="ip-api.com (免费) + 系统API" Foreground="#3498DB" VerticalAlignment="Center" Margin="5,0,20,0"/>
                <Separator Width="20"/>
                <TextBlock Text="提示：Enter键快速查询" Foreground="#7F8C8D" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 加载指示器 -->
        <Border Grid.Row="2" Name="LoadingOverlay" Visibility="Collapsed"
               Background="#80FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Center"
               Padding="30" CornerRadius="10">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Name="LoadingProgress" IsIndeterminate="True" Width="200" Height="20"/>
                <TextBlock Name="LoadingText" Text="正在查询..." Margin="10,0,0,0" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
