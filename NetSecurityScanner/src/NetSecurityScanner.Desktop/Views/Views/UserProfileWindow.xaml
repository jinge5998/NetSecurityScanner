<Window x:Class="NetSecurityScanner.Views.UserProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👤 个人资料" Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8f9fa">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#6c5ce7" CornerRadius="8" Padding="18" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="👤 个人资料" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="CurrentUserText" Text="" FontSize="12" Foreground="#dfe6e9" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="显示名称 (1-32字符)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="DisplayNameTextBox" Height="32" Padding="6" FontSize="14"
                         TextChanged="Input_TextChanged"/>
                <TextBlock x:Name="DisplayNameErrorText" Foreground="#d63031" FontSize="11" Margin="2,3,0,12"/>

                <Separator Margin="0,0,0,12"/>

                <TextBlock Text="──────────  修改密码  ──────────" FontWeight="Bold"
                           Foreground="#636e72" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                <TextBlock Text="当前密码（必填）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <PasswordBox x:Name="OldPasswordBox" Height="32" Padding="6" FontSize="14"
                             PasswordChanged="Input_TextChanged"/>
                <TextBlock x:Name="OldPasswordErrorText" Foreground="#d63031" FontSize="11" Margin="2,3,0,12"/>

                <TextBlock Text="新密码（留空则不修改密码，至少6位）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <PasswordBox x:Name="NewPasswordBox" Height="32" Padding="6" FontSize="14"
                             PasswordChanged="Input_TextChanged"/>
                <TextBlock x:Name="NewPasswordErrorText" Foreground="#d63031" FontSize="11" Margin="2,3,0,12"/>

                <TextBlock Text="确认新密码" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="32" Padding="6" FontSize="14"
                             PasswordChanged="Input_TextChanged"/>
                <TextBlock x:Name="ConfirmPasswordErrorText" Foreground="#d63031" FontSize="11" Margin="2,3,0,4"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="CancelButton" Content="取消" Width="90" Height="34" Margin="0,0,8,0"
                    Click="CancelButton_Click" IsCancel="True"/>
            <Button x:Name="SaveButton" Content="保存" Width="90" Height="34"
                    Background="#6c5ce7" Foreground="White" FontWeight="Bold"
                    Click="SaveButton_Click" IsDefault="True" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
