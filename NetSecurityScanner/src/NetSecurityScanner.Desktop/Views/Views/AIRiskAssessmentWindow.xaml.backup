<Window x:Class="NetSecurityScanner.Views.AIRiskAssessmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="🤖 AI风险评估" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <Border Grid.Row="0" Background="LinearGradient(135deg, #667eea, #764ba2)" 
                CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="🤖 AI智能风险评估" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="基于端口扫描结果的智能风险分析与建议" FontSize="13" 
                               Foreground="#e0e0e0" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="White" CornerRadius="50" Width="100" Height="100"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Name="RiskScoreText" Text="--" FontSize="36" FontWeight="Bold" 
                                   Foreground="#667eea" HorizontalAlignment="Center"/>
                        <TextBlock Text="风险评分" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        
        <!-- 控制栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="扫描目标:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <TextBox Name="TargetTextBox" Width="150" Height="35" FontSize="14" 
                         Padding="10,5" IsReadOnly="True" Background="#f5f5f5"/>
                <TextBlock Text="扫描时间:" VerticalAlignment="Center" Margin="15,0,10,0" FontWeight="SemiBold"/>
                <TextBox Name="ScanTimeTextBox" Width="150" Height="35" FontSize="14" 
                         Padding="10,5" IsReadOnly="True" Background="#f5f5f5"/>
                <TextBlock Text="扫描端口:" VerticalAlignment="Center" Margin="15,0,10,0" FontWeight="SemiBold"/>
                <TextBox Name="TotalPortsTextBox" Width="80" Height="35" FontSize="14" 
                         Padding="10,5" IsReadOnly="True" Background="#f5f5f5"/>
                <TextBlock Text="开放端口:" VerticalAlignment="Center" Margin="15,0,10,0" FontWeight="SemiBold"/>
                <TextBox Name="OpenPortsTextBox" Width="80" Height="35" FontSize="14" 
                         Padding="10,5" IsReadOnly="True" Background="#e8f5e9" Foreground="#2e7d32" FontWeight="Bold"/>
            </StackPanel>
            
            <Button Grid.Column="1" Name="RefreshAssessmentButton" Content="🔄 重新评估" Width="120" Height="40" 
                    Background="#667eea" Foreground="White" FontWeight="Bold" Click="RefreshAssessmentButton_Click"/>
        </Grid>
        
        <!-- 主内容区 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>
            
            <!-- 左侧：风险项列表 -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 统计卡片 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Background="#e74c3c" CornerRadius="8" Padding="15" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="🔴 严重" FontSize="12" Foreground="White" Opacity="0.9"/>
                            <TextBlock Name="CriticalCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="1" Background="#e67e22" CornerRadius="8" Padding="15" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="🟠 高危" FontSize="12" Foreground="White" Opacity="0.9"/>
                            <TextBlock Name="HighCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="2" Background="#f1c40f" CornerRadius="8" Padding="15" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="🟡 中危" FontSize="12" Foreground="White" Opacity="0.9"/>
                            <TextBlock Name="MediumCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Column="3" Background="#27ae60" CornerRadius="8" Padding="15" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="🟢 低危" FontSize="12" Foreground="White" Opacity="0.9"/>
                            <TextBlock Name="LowCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- 风险项列表 -->
                <Border Grid.Row="1" BorderBrush="#dfe6e9" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Border Background="#f8f9fa" Padding="12" CornerRadius="8,8,0,0">
                            <TextBlock Text="📋 风险项列表" FontWeight="Bold" FontSize="14"/>
                        </Border>
                        
                        <DataGrid Grid.Row="1" Name="RiskItemsDataGrid" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#f8f9fa" BorderThickness="0"
                                  SelectionChanged="RiskItemsDataGrid_SelectionChanged"
                                  MouseDoubleClick="RiskItemsDataGrid_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="风险等级" Binding="{Binding RiskLevel}" Width="90">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RiskLevel}" Value="Critical">
                                                    <Setter Property="Foreground" Value="#e74c3c"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RiskLevel}" Value="High">
                                                    <Setter Property="Foreground" Value="#e67e22"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RiskLevel}" Value="Medium">
                                                    <Setter Property="Foreground" Value="#f1c40f"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RiskLevel}" Value="Low">
                                                    <Setter Property="Foreground" Value="#27ae60"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="150"/>
                                <DataGridTextColumn Header="风险项" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="评分" Binding="{Binding RiskScore, StringFormat=F1}" Width="60"/>
                                <DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
            
            <!-- 右侧：统计图表和建议 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- 风险分布饼图 -->
                <Border Grid.Row="0" BorderBrush="#dfe6e9" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#f8f9fa" Padding="10" CornerRadius="8,8,0,0">
                            <TextBlock Text="📊 风险分布" FontWeight="Bold"/>
                        </Border>
                        <lvc:PieChart Grid.Row="1" Name="RiskDistributionChart" 
                                      LegendPosition="Right" Margin="10"/>
                    </Grid>
                </Border>
                
                <!-- 服务类型统计 -->
                <Border Grid.Row="1" BorderBrush="#dfe6e9" BorderThickness="1" CornerRadius="8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#f8f9fa" Padding="10" CornerRadius="8,8,0,0">
                            <TextBlock Text="🔌 服务类型分布" FontWeight="Bold"/>
                        </Border>
                        <lvc:PieChart Grid.Row="1" Name="ServiceTypeChart" 
                                      LegendPosition="Right" Margin="10"/>
                    </Grid>
                </Border>
                
                <!-- 修复建议 -->
                <Border Grid.Row="2" BorderBrush="#dfe6e9" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="#f8f9fa" Padding="10" CornerRadius="8,8,0,0">
                            <TextBlock Text="💡 修复建议" FontWeight="Bold"/>
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Name="RecommendationsPanel" Margin="10">
                                <TextBlock Text="选择左侧风险项查看详细建议" 
                                           Foreground="Gray" HorizontalAlignment="Center" Margin="20"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        
        <!-- 底部 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0">
            <TextBlock Name="AssessmentStatusText" Text="就绪" VerticalAlignment="Center" Foreground="Gray"/>
            <Button Name="CopyReportButton" Content="📋 复制报告" Width="120" Height="35" 
                    Margin="10,0,5,0" Background="#00b894" Foreground="White" IsEnabled="False" 
                    Click="CopyReportButton_Click"/>
            <Button Name="ExportReportButton" Content="📄 导出报告" Width="120" Height="35" 
                    Margin="20,0,5,0" Background="#74b9ff" Foreground="White" IsEnabled="False" 
                    Click="ExportReportButton_Click"/>
            <Button Name="CloseButton" Content="❌ 关闭" Width="100" Height="35" 
                    Margin="5,0" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
