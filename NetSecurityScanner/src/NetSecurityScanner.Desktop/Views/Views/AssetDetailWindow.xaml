<Window x:Class="NetSecurityScanner.Views.AssetDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="资产详情" Height="600" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#f8f9fa">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#0984e3" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="资产详情" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="只读视图，所有字段不可修改" FontSize="11" Foreground="#dfe6e9" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 字段列表（只读） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="FieldsPanel">
                <TextBlock Text="名称" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="NameText" Text="-" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="IP地址" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="IPAddressText" Text="-"/>
                </Border>

                <TextBlock Text="MAC 地址" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="MacAddressText" Text="-"/>
                </Border>

                <TextBlock Text="资产类型" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="AssetTypeText" Text="-"/>
                </Border>

                <TextBlock Text="操作系统" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="OperatingSystemText" Text="-"/>
                </Border>

                <TextBlock Text="部门" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="DepartmentText" Text="-"/>
                </Border>

                <TextBlock Text="负责人" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="OwnerText" Text="-"/>
                </Border>

                <TextBlock Text="位置" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="LocationText" Text="-"/>
                </Border>

                <TextBlock Text="状态" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="StatusText" Text="-" FontWeight="Bold"/>
                </Border>

                <TextBlock Text="标签" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="TagsText" Text="-" TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="描述" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="DescriptionText" Text="-" TextWrapping="Wrap" MinHeight="36"/>
                </Border>

                <TextBlock Text="创建时间" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="CreatedAtText" Text="-"/>
                </Border>

                <TextBlock Text="创建人" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="CreatedByText" Text="-"/>
                </Border>

                <TextBlock Text="最后修改时间" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="LastModifiedText" Text="-"/>
                </Border>

                <TextBlock Text="最后修改人" FontWeight="SemiBold" Foreground="#636e72" FontSize="11" Margin="0,4,0,2"/>
                <Border Background="White" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <TextBlock x:Name="LastModifiedByText" Text="-"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 关闭按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Content="❌ 关闭" Width="100" Height="32" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
