<Window x:Class="NetSecurityScanner.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="发现新版本"
        Height="680"
        Width="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Window.Resources>
        <DropShadowEffect x:Key="ButtonShadow"
                          BlurRadius="3"
                          Color="#80000000"
                          Direction="270"
                          Opacity="0.3"
                          RenderingBias="Quality"
                          ShadowDepth="2"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C3E50"
                CornerRadius="8"
                Padding="20"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="发现新版本"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"/>
                <TextBlock Name="SubtitleTextBlock"
                           Text="请及时升级以获取最新功能和安全修复"
                           FontSize="13"
                           Foreground="#b2bec3"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                BorderBrush="#dfe6e9"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15"
                Background="#f8f9fa">
            <StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,8">
                    <TextBlock Text="最新版本："
                               FontSize="14"
                               Foreground="#2C3E50"/>
                    <TextBlock Name="NewVersionTextBlock"
                               Text="v1.0.0.1"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#27AE60"/>
                    <TextBlock Text="  发布日期："
                               FontSize="12"
                               Foreground="#7F8C8D"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Name="ReleaseDateTextBlock"
                               Text="2026-01-15"
                               FontSize="12"
                               Foreground="#2C3E50"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="当前版本："
                               FontSize="12"
                               Foreground="#7F8C8D"/>
                    <TextBlock Name="CurrentVersionTextBlock"
                               Text="v1.0.0.0"
                               FontSize="14"
                               Foreground="#E74C3C"
                               FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="#27AE60"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,10"
                Background="#EAFAF1"
                Name="AutoUpdatePanel">
            <StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,6">
                    <TextBlock Text="🚀 一键自动更新（推荐）"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#2C3E50"/>
                </StackPanel>
                <TextBlock TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="#555"
                           Margin="0,0,0,4"
                           Text="自动从 GitHub 下载最新版本并替换当前文件，更新完成后自动重启应用。"/>
                <StackPanel Orientation="Horizontal"
                            Margin="0,4,0,0">
                    <TextBlock Text="更新包大小："
                               FontSize="12"
                               Foreground="#7F8C8D"/>
                    <TextBlock Name="AssetSizeTextBlock"
                               Text="未知"
                               FontSize="12"
                               Foreground="#2C3E50"
                               FontWeight="Bold"/>
                    <TextBlock Text="  来源："
                               FontSize="12"
                               Foreground="#7F8C8D"/>
                    <TextBlock Name="AssetNameTextBlock"
                               Text=""
                               FontSize="12"
                               Foreground="#2C3E50"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                BorderBrush="#3498DB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Margin="0,0,0,15"
                Background="#EBF5FB">
            <StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,6">
                    <TextBlock Text="📥 手动下载：百度网盘"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#2C3E50"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,0,4">
                    <TextBlock Text="下载链接："
                               FontSize="12"
                               Foreground="#7F8C8D"/>
                    <TextBlock Name="BaiduUrlTextBlock"
                               Text=""
                               FontSize="12"
                               Foreground="#2980B9"
                               Cursor="Hand"
                               MouseLeftButtonDown="BaiduUrlTextBlock_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="提取码："
                               FontSize="12"
                               Foreground="#7F8C8D"/>
                    <TextBlock Name="ExtractionCodeTextBlock"
                               Text=""
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#E74C3C"/>
                    <Button Name="CopyCodeButton"
                            Content="复制"
                            FontSize="10"
                            Padding="6,1"
                            Margin="8,0,0,0"
                            Background="#3498DB"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CopyCodeButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4"
                BorderBrush="#dfe6e9"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        Background="#f8f9fa"
                        Padding="12"
                        CornerRadius="8,8,0,0">
                    <TextBlock Text="更新说明"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#2C3E50"/>
                </Border>
                <TextBox Grid.Row="1"
                         Name="ReleaseNotesTextBox"
                         Background="#1E1E1E"
                         Foreground="#D4D4D4"
                         FontFamily="Consolas"
                         FontSize="13"
                         Padding="10"
                         Margin="0"
                         BorderThickness="0"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         AcceptsReturn="True"/>
            </Grid>
        </Border>

        <Border Grid.Row="5"
                BorderBrush="#dfe6e9"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                Margin="0,0,0,10"
                Name="ProgressPanel"
                Visibility="Collapsed"
                Background="#f8f9fa">
            <StackPanel>
                <TextBlock Name="ProgressMessageTextBlock"
                           Text="准备更新..."
                           FontSize="13"
                           Foreground="#2C3E50"
                           Margin="0,0,0,6"/>
                <ProgressBar Name="UpdateProgressBar"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Height="20"
                             Foreground="#27AE60"
                             Background="#ECF0F1"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0">
            <Button Name="AutoUpdateButton"
                    Content="🚀 一键更新"
                    Width="150"
                    Height="42"
                    Margin="8,0"
                    Background="#27AE60"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    Click="AutoUpdateButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Effect="{StaticResource ButtonShadow}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#219A52"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#1E8449"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button Name="ManualDownloadButton"
                    Content="📥 手动下载"
                    Width="140"
                    Height="42"
                    Margin="8,0"
                    Background="#3498DB"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    Click="DownloadButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Effect="{StaticResource ButtonShadow}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#219A52"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#1E8449"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button Name="RemindLaterButton"
                    Content="稍后提醒"
                    Width="120"
                    Height="42"
                    Margin="8,0"
                    Background="#95A5A6"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    Click="RemindLaterButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Effect="{StaticResource ButtonShadow}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#7F8C8D"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#707B7C"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>

            <Button Name="SkipButton"
                    Content="跳过此版本"
                    Width="120"
                    Height="42"
                    Margin="8,0"
                    Background="#E67E22"
                    Foreground="White"
                    FontWeight="Bold"
                    FontSize="14"
                    Click="SkipButton_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="BorderThickness"
                                Value="0"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Effect="{StaticResource ButtonShadow}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#D35400"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed"
                                                 Value="True">
                                            <Setter Property="Background"
                                                    Value="#BA4A00"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</Window>