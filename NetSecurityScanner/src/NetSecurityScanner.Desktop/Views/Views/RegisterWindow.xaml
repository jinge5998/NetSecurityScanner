<Window x:Class="NetSecurityScanner.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔐 注册新账号" Height="700" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="700" MinWidth="500"
        Background="#f8f9fa">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#0984e3" CornerRadius="8" Padding="18" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="🔐 创建新账号" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="注册后需等待管理员审核通过；所有权限由管理员分发" FontSize="12" Foreground="#dfe6e9" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel>
                <!-- 用户名 -->
                <TextBlock Text="用户名 *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UsernameTextBox" Grid.Column="0" Height="32" Padding="6" FontSize="14" TabIndex="1"
                             TextChanged="UsernameTextBox_TextChanged"/>
                    <TextBlock x:Name="UsernameStatusText" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" MinWidth="90"/>
                </Grid>
                <TextBlock x:Name="UsernameErrorText" Foreground="#d63031" FontSize="11" Margin="2,3,0,6" Height="14"/>

                <!-- 显示名 -->
                <TextBlock Text="显示名称 (选填，最多 32 字符)" FontWeight="SemiBold" Margin="0,4,0,4"/>
                <TextBox x:Name="DisplayNameTextBox" Height="32" Padding="6" FontSize="14" TabIndex="2"/>
                <TextBlock x:Name="DisplayNameErrorText" Foreground="#d63031" FontSize="11" Margin="2,3,0,6" Height="14"/>

                <!-- 邮箱 -->
                <TextBlock Text="邮箱 (选填)" FontWeight="SemiBold" Margin="0,4,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="EmailTextBox" Grid.Column="0" Height="32" Padding="6" FontSize="14" TabIndex="3"
                             TextChanged="EmailTextBox_TextChanged"/>
                    <TextBlock x:Name="EmailStatusText" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" MinWidth="90"/>
                </Grid>
                <TextBlock x:Name="EmailErrorText" Foreground="#d63031" FontSize="11" Margin="2,3,0,6" Height="14"/>

                <!-- 手机 -->
                <TextBlock Text="手机 (选填，11 位数字 1 开头)" FontWeight="SemiBold" Margin="0,4,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PhoneTextBox" Grid.Column="0" Height="32" Padding="6" FontSize="14" TabIndex="4"
                             TextChanged="PhoneTextBox_TextChanged"/>
                    <TextBlock x:Name="PhoneStatusText" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" MinWidth="90"/>
                </Grid>
                <TextBlock x:Name="PhoneErrorText" Foreground="#d63031" FontSize="11" Margin="2,3,0,6" Height="14"/>

                <!-- 申请说明 -->
                <TextBlock Text="申请说明 (选填，最多 200 字符 — admin 审核时可见)" FontWeight="SemiBold" Margin="0,4,0,4"/>
                <TextBox x:Name="ReasonTextBox" Height="60" Padding="6" FontSize="13" TabIndex="5"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         TextChanged="ReasonTextBox_TextChanged"/>
                <TextBlock x:Name="ReasonCountText" Foreground="#636e72" FontSize="11" Margin="2,3,0,6" Height="14"/>

                <!-- 密码 -->
                <TextBlock Text="密码 * (至少 6 位；建议字母+数字)" FontWeight="SemiBold" Margin="0,4,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="PasswordBox" Grid.Column="0" Height="32" Padding="6" FontSize="14" TabIndex="6" IsTabStop="True" PasswordChar="●"
                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                    <Button x:Name="GeneratePasswordButton" Grid.Column="1" Content="🎲 生成强密码" Width="110" Height="32" Margin="6,0,0,0"
                            TabIndex="-1" Cursor="Hand" ToolTip="生成 12 位随机强密码（含大小写字母 + 数字 + 特殊字符）"
                            Click="GeneratePasswordButton_Click"/>
                </Grid>
                <Grid Margin="2,3,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="PasswordStrengthBar" Grid.Column="0" Height="8" Maximum="100" Value="0" Minimum="0"/>
                    <TextBlock x:Name="PasswordStrengthText" Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" MinWidth="50"/>
                </Grid>
                <TextBlock x:Name="PasswordErrorText" Foreground="#d63031" FontSize="11" Margin="2,0,0,6" Height="14"/>

                <!-- 确认密码 -->
                <TextBlock Text="确认密码 *" FontWeight="SemiBold" Margin="0,4,0,4"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="32" Padding="6" FontSize="14" TabIndex="7" IsTabStop="True" PasswordChar="●"
                             PasswordChanged="ConfirmPasswordBox_PasswordChanged"/>
                <TextBlock x:Name="ConfirmPasswordErrorText" Foreground="#d63031" FontSize="11" Margin="2,3,0,4" Height="14"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="取消" Width="90" Height="34" Margin="0,0,8,0"
                    Click="CancelButton_Click" IsCancel="True" TabIndex="9" Cursor="Hand"/>
            <Button x:Name="RegisterButton" Content="✅ 注册" Width="100" Height="34"
                    Background="#0984e3" Foreground="White" FontWeight="Bold"
                    Click="RegisterButton_Click" IsDefault="True" TabIndex="8" Cursor="Hand" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
