<Window x:Class="NetSecurityScanner.Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="👥 账号管理" Height="620" Width="1020"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="560" MinWidth="900"
        Background="#f8f9fa">
    <Window.Resources>
        <!-- 状态徽章样式 -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="6,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#0984e3" CornerRadius="8" Padding="18" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="👥 账号管理" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="InfoText" Text="" FontSize="12" Foreground="#dfe6e9" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 搜索/筛选条 -->
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#dfe6e9" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍 搜索:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" x:Name="SearchTextBox" Height="30" Padding="6" FontSize="13"
                         TextChanged="SearchTextBox_TextChanged" VerticalContentAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="状态:" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox Grid.Column="3" x:Name="StatusFilterCombo" Height="30" SelectionChanged="StatusFilter_Changed" Cursor="Hand">
                    <ComboBoxItem Content="全部" IsSelected="True"/>
                    <ComboBoxItem Content="⏳ 待审"/>
                    <ComboBoxItem Content="✅ 正常"/>
                    <ComboBoxItem Content="🚫 禁用"/>
                </ComboBox>
                <Button Grid.Column="4" x:Name="ViewDetailButton" Content="👁 查看详情" Click="ViewDetailButton_Click"
                        Width="100" Height="30" Margin="12,0,0,0" IsEnabled="False" Cursor="Hand"/>
                <Button Grid.Column="5" Content="🔄 刷新" Click="RefreshButton_Click"
                        Width="80" Height="30" Margin="6,0,0,0" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- 账号列表 -->
        <DataGrid Grid.Row="2" x:Name="UsersDataGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  AlternatingRowBackground="#f1f2f6"
                  RowHeight="36"
                  MouseDoubleClick="UsersDataGrid_MouseDoubleClick"
                  SelectionChanged="UsersDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="110" SortMemberPath="Username">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="显示名称" Binding="{Binding DisplayName}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="130" SortMemberPath="CreatedAt">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="最后登录" Binding="{Binding LastLoginAtDisplay}" Width="130" SortMemberPath="LastLoginAt">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="状态" Width="100" SortMemberPath="StatusSortKey">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource StatusBadgeStyle}" Background="{Binding StatusBackground}">
                                <TextBlock Text="{Binding StatusText}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="权限" Binding="{Binding PermissionSummary}" Width="*" SortMemberPath="PermissionCount">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="Foreground" Value="#2d3436"/>
                            <Setter Property="ToolTip" Value="{Binding PermissionDetail}"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="角色" Binding="{Binding RoleText}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="8,0"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="HintText" Text="💡 提示：admin 可双击普通用户行编辑权限" FontSize="12" Foreground="#636e72" Margin="0,0,16,0"/>
                <TextBlock x:Name="FilterStatusText" Text="" FontSize="12" Foreground="#0984e3" FontWeight="SemiBold"/>
            </StackPanel>
            <Button Grid.Column="1" Content="关闭" Width="100" Height="32" Click="CloseButton_Click" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
