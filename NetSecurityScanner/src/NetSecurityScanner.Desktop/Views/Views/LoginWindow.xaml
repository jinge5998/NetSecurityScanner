<Window x:Class="NetSecurityScanner.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔑 登录" Height="360" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8f9fa">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#00b894" CornerRadius="8" Padding="18" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="🔑 用户登录" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="登录后可管理资产" FontSize="12" Foreground="#dfe6e9" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 表单 -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="用户名" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameTextBox" Height="32" Padding="6" FontSize="14"
                     TextChanged="Input_TextChanged" KeyDown="Input_KeyDown"/>
            <TextBlock x:Name="UsernameErrorText" Foreground="#d63031" FontSize="11" Margin="2,3,0,8"/>

            <TextBlock Text="密码" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox" Height="32" Padding="6" FontSize="14"
                         PasswordChanged="Input_TextChanged" KeyDown="Input_KeyDown"/>
            <TextBlock x:Name="PasswordErrorText" Foreground="#d63031" FontSize="11" Margin="2,3,0,8"/>

            <CheckBox x:Name="RememberMeCheckBox" Content="记住登录状态" Margin="0,4,0,0"
                      VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 底部按钮 -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="RegisterLinkButton" Grid.Column="0" HorizontalAlignment="Left"
                    Content="🆕 注册新账号" Background="Transparent" BorderThickness="0"
                    Foreground="#0984e3" Cursor="Hand"
                    Click="RegisterLinkButton_Click"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton" Content="取消" Width="80" Height="32" Margin="0,0,8,0"
                        Click="CancelButton_Click" IsCancel="True"/>
                <Button x:Name="LoginButton" Content="登录" Width="80" Height="32"
                        Background="#00b894" Foreground="White" FontWeight="Bold"
                        Click="LoginButton_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
