<Window x:Class="NetSecurityScanner.Views.CameraTagManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="标签管理" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部按钮 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="📝 新建标签" Click="NewTag_Click"
                    Background="#2563EB" Foreground="White"
                    BorderThickness="0" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="✏️ 编辑" Click="EditTag_Click"
                    Background="#0EA5E9" Foreground="White"
                    BorderThickness="0" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="🗑️ 删除" Click="DeleteTag_Click"
                    Background="#EF4444" Foreground="White"
                    BorderThickness="0" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"/>
        </StackPanel>

        <!-- 主区域：左标签列表 + 右 IP 列表 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="所有标签" FontWeight="Bold" FontSize="13"
                               Foreground="#1E293B" Margin="10,8"/>
                    <ListView x:Name="TagListView" BorderThickness="0" SelectionChanged="TagListView_SelectionChanged">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="颜色" Width="50">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="20" Height="20" CornerRadius="3"
                                                    Background="{Binding Color}" BorderBrush="#94A3B8" BorderThickness="1"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="名称" Width="120" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="IP数" Width="50" DisplayMemberBinding="{Binding IpCount}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>

            <Border Grid.Column="1" Margin="10,0,0,0" Background="White"
                    BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="CurrentTagTitle"
                               Text="该标签下的 IP" FontWeight="Bold" FontSize="13"
                               Foreground="#1E293B" Margin="10,8"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="10">
                        <TextBox x:Name="NewIpTextBox" Width="200" Padding="6" Margin="0,0,8,0"
                                 BorderBrush="#CBD5E1" BorderThickness="1"
                                 ToolTip="输入 IP 后回车或点击「添加」"/>
                        <Button Content="➕ 添加" Click="AddIp_Click"
                                Background="#10B981" Foreground="White"
                                BorderThickness="0" Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                        <Button Content="➖ 移除选中" Click="RemoveIp_Click"
                                Background="#F59E0B" Foreground="White"
                                BorderThickness="0" Padding="12,6" Cursor="Hand"/>
                    </StackPanel>
                    <ListView x:Name="IpListView" SelectionMode="Multiple" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="IP" Width="200" DisplayMemberBinding="{Binding}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" x:Name="StatusText" Foreground="#64748B" FontSize="11"
                   Margin="0,10,0,0" Text=""/>
    </Grid>
</Window>
