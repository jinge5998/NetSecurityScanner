<Window x:Class="NetSecurityScanner.Views.AIRiskAssessmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Risk Assessment Center - Professional Edition" 
        Height="950" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="#0f1419"
        WindowStyle="SingleBorderWindow">
    
    <Window.Resources>
        <!-- Color Palette -->
        <SolidColorBrush x:Key="BackgroundPrimary" Color="#0f1419"/>
        <SolidColorBrush x:Key="BackgroundSecondary" Color="#141a24"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1c2536"/>
        <SolidColorBrush x:Key="CardBackgroundHover" Color="#243044"/>
        
        <!-- Risk Colors -->
        <SolidColorBrush x:Key="CriticalBrush" Color="#ff4757"/>
        <SolidColorBrush x:Key="HighBrush" Color="#ff6b4a"/>
        <SolidColorBrush x:Key="MediumBrush" Color="#ffa502"/>
        <SolidColorBrush x:Key="LowBrush" Color="#2ed573"/>
        <SolidColorBrush x:Key="InfoBrush" Color="#70a1ff"/>
        
        <!-- Gradient Brushes -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="CriticalGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#ff4757" Offset="0"/>
            <GradientStop Color="#ff6b81" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2ed573" Offset="0"/>
            <GradientStop Color="#7bed9f" Offset="1"/>
        </LinearGradientBrush>
        
        <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#ffa502" Offset="0"/>
            <GradientStop Color="#ffbe76" Offset="1"/>
        </LinearGradientBrush>
        
        <!-- Shadow Effects -->
        <DropShadowEffect x:Key="CardShadow" ShadowDepth="4" BlurRadius="12" Opacity="0.4" Color="Black"/>
        <DropShadowEffect x:Key="GlowEffect" ShadowDepth="0" BlurRadius="20" Opacity="0.6"/>
        
        <!-- Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
            <Setter Property="Margin" Value="8"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header Section -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundSecondary}" Padding="25,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Left: Title -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{StaticResource PrimaryGradient}" CornerRadius="8" Padding="10,6" Margin="0,0,15,0">
                            <TextBlock Text="&#x2699;" FontSize="24" Foreground="White"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="RISK ASSESSMENT CENTER" FontSize="26" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Professional Network Security Analysis Platform" FontSize="13" Foreground="#6c7a89"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                
                <!-- Right: Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="RefreshAssessmentButton" Style="{StaticResource ModernButton}" 
                            Background="{StaticResource PrimaryGradient}" Margin="0,0,10,0"
                            Click="RefreshAssessmentButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F504;" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Reassess"/>
                        </StackPanel>
                    </Button>
                    <Button Name="CopyReportButton" Style="{StaticResource ModernButton}" 
                            Background="#2ed573" IsEnabled="False" Margin="0,0,10,0"
                            Click="CopyReportButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4CB;" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Copy"/>
                        </StackPanel>
                    </Button>
                    <Button Name="ExportReportButton" Style="{StaticResource ModernButton}" 
                            Background="#70a1ff" IsEnabled="False" Margin="0,0,10,0"
                            Click="ExportReportButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4C4;" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Export"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernButton}" Background="#ff4757"
                            Click="CloseButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x274C;" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Close"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" 
                      Background="{StaticResource BackgroundPrimary}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Top Stats Cards -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Risk Score Card -->
                    <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Background="{StaticResource CriticalBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                    <TextBlock Text="&#x26A0;" FontSize="16" Foreground="White"/>
                                </Border>
                                <TextBlock Text="RISK SCORE" FontSize="14" FontWeight="Bold" Foreground="#6c7a89" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <Grid Grid.Row="1" Height="160">
                                <lvc:PieChart Name="RiskGaugeChart" LegendPosition="Hidden"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">
                                    <TextBlock Name="RiskScoreText" Text="--" FontSize="48" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                    <TextBlock Text="/ 10" FontSize="14" Foreground="#6c7a89" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            
                            <TextBlock Grid.Row="2" Name="RiskLevelText" Text="Analyzing..." FontSize="16" FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryGradient}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Target Card -->
                    <Border Grid.Column="1" Style="{StaticResource ModernCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Background="{StaticResource InfoBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                    <TextBlock Text="&#x1F3AF;" FontSize="16" Foreground="White"/>
                                </Border>
                                <TextBlock Text="TARGET" FontSize="14" FontWeight="Bold" Foreground="#6c7a89" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Row="1" Name="TargetTextBox" Text="--" FontSize="32" FontWeight="Bold" 
                                       Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Name="ScanTimeTextBox" Text="" FontSize="11" Foreground="#6c7a89" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Open Ports Card -->
                    <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Background="{StaticResource MediumBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                    <TextBlock Text="&#x1F50C;" FontSize="16" Foreground="White"/>
                                </Border>
                                <TextBlock Text="OPEN PORTS" FontSize="14" FontWeight="Bold" Foreground="#6c7a89" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Row="1" Name="OpenPortsTextBox" Text="--" FontSize="42" FontWeight="Bold" 
                                       Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Name="TotalPortsTextBox" Text="Total: 0" FontSize="11" Foreground="#6c7a89" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Vulnerabilities Card -->
                    <Border Grid.Column="3" Style="{StaticResource ModernCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Background="{StaticResource HighBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                    <TextBlock Text="&#x26A0;" FontSize="16" Foreground="White"/>
                                </Border>
                                <TextBlock Text="VULNERABILITIES" FontSize="14" FontWeight="Bold" Foreground="#6c7a89" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Row="1" Name="VulnCountText" Text="--" FontSize="42" FontWeight="Bold" 
                                       Foreground="{StaticResource HighBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Name="VulnTrendText" Text="Analyzing..." FontSize="11" Foreground="#6c7a89" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                    
                    <!-- Risk Level Card -->
                    <Border Grid.Column="4" Style="{StaticResource ModernCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                <Border Background="{StaticResource LowBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                    <TextBlock Text="&#x1F4CA;" FontSize="16" Foreground="White"/>
                                </Border>
                                <TextBlock Text="RISK LEVEL" FontSize="14" FontWeight="Bold" Foreground="#6c7a89" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <TextBlock Grid.Row="1" Name="RiskLevelBadge" Text="--" FontSize="36" FontWeight="Bold" 
                                       Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Name="RiskLevelDesc" Text="Waiting..." FontSize="11" Foreground="#6c7a89" Margin="0,10,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
                
                <!-- Charts Grid -->
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left Column: Risk Distribution & Radar Chart -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Risk Distribution Pie Chart -->
                        <Border Grid.Row="0" Style="{StaticResource ModernCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                    <Border Background="{StaticResource PrimaryGradient}" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                                        <TextBlock Text="&#x1F4CA;" FontSize="16" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="Risk Distribution Analysis" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <lvc:PieChart Grid.Row="1" Name="RiskDistributionChart" LegendPosition="Bottom"/>
                            </Grid>
                        </Border>
                        
                        <!-- Multi-dimensional Radar Chart -->
                        <Border Grid.Row="1" Style="{StaticResource ModernCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                    <Border Background="{StaticResource WarningGradient}" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                                        <TextBlock Text="&#x1F5DE;" FontSize="16" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="Multi-dimensional Security Analysis" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <lvc:PolarChart Grid.Row="1" Name="RadarChart" LegendPosition="Right"/>
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <!-- Center Column: Risk Items List & Port Distribution -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Risk Items List -->
                        <Border Grid.Row="0" Style="{StaticResource ModernCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="{StaticResource CriticalGradient}" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                                        <TextBlock Text="&#x26A0;" FontSize="16" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="Risk Items Identified" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                    <TextBlock Name="RiskItemCount" Text="(0 items)" FontSize="12" Foreground="#6c7a89" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                
                                <DataGrid Grid.Row="1" Name="RiskItemsDataGrid" AutoGenerateColumns="False" 
                                          CanUserAddRows="False" GridLinesVisibility="None"
                                          Background="Transparent" BorderThickness="0"
                                          RowBackground="#1e2438" AlternatingRowBackground="#252c45"
                                          SelectionChanged="RiskItemsDataGrid_SelectionChanged"
                                          Sorting="RiskItemsDataGrid_Sorting"
                                          MouseDoubleClick="RiskItemsDataGrid_MouseDoubleClick"
                                          Foreground="White" FontSize="12">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Level" Binding="{Binding RiskLevel}" Width="75" SortMemberPath="RiskLevel">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RiskLevel}" Value="Critical">
                                                            <Setter Property="Foreground" Value="#ff4757"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RiskLevel}" Value="High">
                                                            <Setter Property="Foreground" Value="#ff6b4a"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RiskLevel}" Value="Medium">
                                                            <Setter Property="Foreground" Value="#ffa502"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding RiskLevel}" Value="Low">
                                                            <Setter Property="Foreground" Value="#2ed573"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="90" Foreground="#c8c8c8" SortMemberPath="Target"/>
                                        <DataGridTextColumn Header="Risk Item" Binding="{Binding Title}" Width="*" Foreground="#c8c8c8" SortMemberPath="Title"/>
                                        <DataGridTextColumn Header="Score" Binding="{Binding RiskScore, StringFormat=F1}" Width="55" Foreground="#c8c8c8" SortMemberPath="RiskScore"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        
                        <!-- Port Distribution Bar Chart -->
                        <Border Grid.Row="1" Style="{StaticResource ModernCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                                    <Border Background="{StaticResource InfoBrush}" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                                        <TextBlock Text="&#x1F4C8;" FontSize="16" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="Port Risk Distribution" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <lvc:CartesianChart Grid.Row="1" Name="PortDistributionChart"/>
                            </Grid>
                        </Border>
                    </Grid>
                    
                    <!-- Right Column: Statistics & Recommendations -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Statistics Cards -->
                        <Border Grid.Row="0" Style="{StaticResource ModernCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                    <Border Background="{StaticResource SuccessGradient}" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                                        <TextBlock Text="&#x1F4DD;" FontSize="16" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="Security Statistics" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Critical Count -->
                                    <Border Grid.Column="0" Grid.Row="0" Background="#1a1f2e" CornerRadius="8" Padding="12" Margin="0,0,5,5">
                                        <StackPanel>
                                            <TextBlock Text="Critical" FontSize="12" Foreground="#ff4757" FontWeight="Bold"/>
                                            <TextBlock Name="CriticalCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#ff4757"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- High Count -->
                                    <Border Grid.Column="1" Grid.Row="0" Background="#1a1f2e" CornerRadius="8" Padding="12" Margin="5,0,0,5">
                                        <StackPanel>
                                            <TextBlock Text="High" FontSize="12" Foreground="#ff6b4a" FontWeight="Bold"/>
                                            <TextBlock Name="HighCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#ff6b4a"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Medium Count -->
                                    <Border Grid.Column="0" Grid.Row="1" Background="#1a1f2e" CornerRadius="8" Padding="12" Margin="0,5,5,0">
                                        <StackPanel>
                                            <TextBlock Text="Medium" FontSize="12" Foreground="#ffa502" FontWeight="Bold"/>
                                            <TextBlock Name="MediumCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#ffa502"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Low Count -->
                                    <Border Grid.Column="1" Grid.Row="1" Background="#1a1f2e" CornerRadius="8" Padding="12" Margin="5,5,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Low" FontSize="12" Foreground="#2ed573" FontWeight="Bold"/>
                                            <TextBlock Name="LowCountText" Text="0" FontSize="28" FontWeight="Bold" Foreground="#2ed573"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        
                        <!-- Recommendations Panel -->
                        <Border Grid.Row="1" Style="{StaticResource ModernCard}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                    <Border Background="{StaticResource PrimaryGradient}" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                                        <TextBlock Text="&#x2714;" FontSize="16" Foreground="White"/>
                                    </Border>
                                    <TextBlock Text="Security Recommendations" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl Name="RecommendationsItemsControl">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#1a1f2e" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#c8c8c8" FontSize="12" LineHeight="20"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                
                <!-- Assessment Status Bar -->
                <Border Grid.Row="2" Background="{StaticResource BackgroundSecondary}" CornerRadius="8" Padding="15,10" Margin="0,5,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="&#x1F4C8;" FontSize="14" Foreground="#6c7a89" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Name="AssessmentStatusText" Text="Ready for assessment..." FontSize="13" Foreground="#6c7a89" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Last Update: " FontSize="12" Foreground="#6c7a89" VerticalAlignment="Center"/>
                            <TextBlock Name="LastUpdateText" Text="--" FontSize="12" Foreground="{StaticResource InfoBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
