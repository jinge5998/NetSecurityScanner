<Window x:Class="NetSecurityScanner.Views.LicenseCodeGeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔑 授权码生成器"
    Height="720"
    Width="1000"
        WindowStartupLocation="CenterScreen"
        MinHeight="680"
    MinWidth="900"
        Background="#f5f6fa">

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 顶部标题 -->
    <Border Grid.Row="0"
        Background="#2d3436"
        CornerRadius="8"
        Padding="18,14"
        Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Text="🔑 授权码生成器"
              FontSize="20"
              FontWeight="Bold"
              Foreground="White"/>
          <TextBlock Text="基于 v1.0.2.2 LicenseService 算法 | 发行记录本地存储"
              FontSize="11"
              Foreground="#b2bec3"
              Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Right">
          <TextBlock x:Name="CurrentMachineIdText"
              Foreground="#74b9ff"
              FontSize="11"
              FontFamily="Consolas"/>
          <TextBlock Text="当前机器指纹"
              Foreground="#636e72"
              FontSize="10"
              HorizontalAlignment="Right"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主内容区：左侧生成面板 + 右侧结果+历史 -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ========== 左侧：生成参数面板 ========== -->
      <Border Grid.Column="0"
          Background="White"
          CornerRadius="8"
          Padding="20"
          Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="📋 生成参数"
              FontSize="15"
              FontWeight="Bold"
              Foreground="#2d3436"
              Margin="0,0,0,16"/>

          <!-- 机器码 -->
          <TextBlock Text="目标机器码（前8位）"
              FontWeight="SemiBold"
              Margin="0,0,0,6"
              FontSize="12"/>
          <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MachineIdPrefixTextBox"
                Grid.Column="0"
                Height="32"
                FontSize="13"
                FontFamily="Consolas"
                     MaxLength="8"
                CharacterCasing="Upper"
                Padding="6,0,0,0"
                     TextChanged="MachineIdPrefixTextBox_TextChanged"/>
            <Button Grid.Column="1"
                x:Name="ReadCurrentMachineButton"
                Content="📡 本机"
                Padding="10,0"
                Height="32"
                    Margin="6,0,0,0"
                FontSize="11"
                Background="#0984e3"
                Foreground="White"
                BorderThickness="0"
                    Click="ReadCurrentMachineButton_Click"
                Cursor="Hand"/>
          </Grid>
          <TextBlock x:Name="MachineIdHintText"
              Text="填入授权目标机器的机器码前8位（大写字母/数字）"
              FontSize="10"
              Foreground="#b2bec3"
              Margin="0,0,0,12"
              TextWrapping="Wrap"/>

          <!-- 完整机器码（只读展示） -->
          <TextBlock Text="完整机器码（参考）"
              FontWeight="SemiBold"
              Margin="0,0,0,6"
              FontSize="12"/>
          <TextBox x:Name="FullMachineIdTextBox"
              IsReadOnly="True"
              Height="28"
              FontSize="10"
              FontFamily="Consolas"
                   Foreground="#636e72"
              Background="#f8f9fa"
              BorderBrush="#dfe6e9"
              Margin="0,0,0,4"/>
          <TextBlock x:Name="FullMachineIdPrefixHint"
              FontSize="10"
              Foreground="#00b894"
              Margin="0,0,0,16"
              TextWrapping="Wrap"/>

          <!-- 授权类型 -->
          <TextBlock Text="授权类型"
              FontWeight="SemiBold"
              Margin="0,0,0,8"
              FontSize="12"/>
          <WrapPanel Margin="0,0,0,16">
            <RadioButton x:Name="TrialRadio"
                GroupName="LicenseType"
                IsChecked="True"
                         Checked="LicenseTypeRadio_Changed"
                Margin="0,0,10,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🕐"
                    FontSize="13"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"/>
                <TextBlock Text="试用（5分钟）"
                    FontSize="12"
                    VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="Year1Radio"
                GroupName="LicenseType"
                         Checked="LicenseTypeRadio_Changed"
                Margin="0,0,10,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="📅"
                    FontSize="13"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"/>
                <TextBlock Text="1年期"
                    FontSize="12"
                    VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="Year2Radio"
                GroupName="LicenseType"
                         Checked="LicenseTypeRadio_Changed"
                Margin="0,0,10,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🗓️"
                    FontSize="13"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"/>
                <TextBlock Text="2年期"
                    FontSize="12"
                    VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
            <RadioButton x:Name="PermanentRadio"
                GroupName="LicenseType"
                         Checked="LicenseTypeRadio_Changed"
                Margin="0,0,0,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="♾️"
                    FontSize="13"
                    VerticalAlignment="Center"
                    Margin="0,0,4,0"/>
                <TextBlock Text="永久授权"
                    FontSize="12"
                    VerticalAlignment="Center"/>
              </StackPanel>
            </RadioButton>
          </WrapPanel>

          <!-- 发行时间 -->
          <TextBlock Text="发行时间"
              FontWeight="SemiBold"
              Margin="0,0,0,6"
              FontSize="12"/>
          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <DatePicker Grid.Column="0"
                x:Name="IssueDatePicker"
                SelectedDate="{x:Static system:DateTime.Now}"
                        xmlns:system="clr-namespace:System;assembly=mscorlib"
                Height="32"
                VerticalContentAlignment="Center"/>
            <TextBox Grid.Column="2"
                x:Name="IssueTimeTextBox"
                Text="12:00:00"
                Height="32"
                FontSize="12"
                     VerticalContentAlignment="Center"
                HorizontalContentAlignment="Center"
                Padding="0"/>
          </Grid>

          <!-- 发行者 -->
          <TextBlock Text="发行者（管理员名称）"
              FontWeight="SemiBold"
              Margin="0,0,0,6"
              FontSize="12"/>
          <TextBox x:Name="IssuerTextBox"
              Height="30"
              FontSize="12"
              Padding="6,0"
              Margin="0,0,0,16"/>

          <!-- 备注 -->
          <TextBlock Text="备注（选填）"
              FontWeight="SemiBold"
              Margin="0,0,0,6"
              FontSize="12"/>
          <TextBox x:Name="NoteTextBox"
              Height="50"
              FontSize="12"
              Padding="6"
              AcceptsReturn="True"
                   TextWrapping="Wrap"
              VerticalScrollBarVisibility="Auto"
              Margin="0,0,0,20"/>

          <!-- 生成按钮 -->
          <Button x:Name="GenerateButton"
              Content="🚀 生成授权码"
              Height="42"
              FontSize="15"
              FontWeight="Bold"
                  Background="#00b894"
              Foreground="White"
              BorderThickness="0"
              Cursor="Hand"
                  Click="GenerateButton_Click"/>
          <TextBlock x:Name="GenerateErrorText"
              Foreground="#d63031"
              FontSize="11"
              Margin="0,6,0,0"
                     TextWrapping="Wrap"
              Height="18"/>
        </StackPanel>
      </Border>

      <!-- ========== 右侧：生成结果 + 历史记录 ========== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 右上：生成结果 -->
        <Border Grid.Row="0"
            Background="White"
            CornerRadius="8"
            Padding="20"
            Margin="0,0,0,12">
          <StackPanel>
            <TextBlock Text="✅ 生成结果"
                FontSize="15"
                FontWeight="Bold"
                Foreground="#2d3436"
                Margin="0,0,0,12"/>
            <Border Background="#f1f2f6"
                CornerRadius="6"
                Padding="16"
                Margin="0,0,0,10">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="GeneratedCodeTextBox"
                    Grid.Column="0"
                    IsReadOnly="True"
                    FontSize="15"
                         FontFamily="Consolas"
                    FontWeight="Bold"
                    Foreground="#2d3436"
                         Background="Transparent"
                    BorderThickness="0"
                         VerticalContentAlignment="Center"
                    TextWrapping="Wrap"/>
                <Button Grid.Column="1"
                    x:Name="CopyCodeButton"
                    Content="📋 复制"
                    Padding="12,6"
                    Margin="10,0,0,0"
                        Background="#0984e3"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="SemiBold"
                        Cursor="Hand"
                    Click="CopyCodeButton_Click"/>
              </Grid>
            </Border>

            <!-- 校验信息 -->
            <Border x:Name="ValidationPanel"
                Background="#f1f2f6"
                CornerRadius="6"
                Padding="14"
                Margin="0,0,0,10">
              <StackPanel>
                <TextBlock Text="🔍 本地校验（请在目标机器激活验证）"
                    FontWeight="SemiBold"
                    FontSize="12"
                    Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0"
                      Grid.Column="0"
                      Text="机器码匹配:"
                      FontSize="11"
                      Foreground="#636e72"/>
                  <TextBlock Grid.Row="0"
                      Grid.Column="1"
                      x:Name="ValidateMachineMatch"
                      Text="—"
                      FontSize="11"
                      FontWeight="SemiBold"/>

                  <TextBlock Grid.Row="1"
                      Grid.Column="0"
                      Text="HMAC校验:"
                      FontSize="11"
                      Foreground="#636e72"
                      Margin="0,3,0,0"/>
                  <TextBlock Grid.Row="1"
                      Grid.Column="1"
                      x:Name="ValidateHmac"
                      Text="—"
                      FontSize="11"
                      FontWeight="SemiBold"
                      Margin="0,3,0,0"/>

                  <TextBlock Grid.Row="2"
                      Grid.Column="0"
                      Text="到期时间:"
                      FontSize="11"
                      Foreground="#636e72"
                      Margin="0,3,0,0"/>
                  <TextBlock Grid.Row="2"
                      Grid.Column="1"
                      x:Name="ValidateExpiry"
                      Text="—"
                      FontSize="11"
                      FontWeight="SemiBold"
                      Margin="0,3,0,0"/>

                  <TextBlock Grid.Row="3"
                      Grid.Column="0"
                      Text="授权类型:"
                      FontSize="11"
                      Foreground="#636e72"
                      Margin="0,3,0,0"/>
                  <TextBlock Grid.Row="3"
                      Grid.Column="1"
                      x:Name="ValidateType"
                      Text="—"
                      FontSize="11"
                      FontWeight="SemiBold"
                      Margin="0,3,0,0"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 快速操作 -->
            <StackPanel Orientation="Horizontal">
              <Button x:Name="SaveAndRecordButton"
                  Content="💾 保存并记录"
                  Padding="14,6"
                  Margin="0,0,8,0"
                      Background="#636e72"
                  Foreground="White"
                  BorderThickness="0"
                  Cursor="Hand"
                      Click="SaveAndRecordButton_Click"/>
              <Button x:Name="ClearResultButton"
                  Content="🗑️ 清空结果"
                  Padding="14,6"
                      Background="#dfe6e9"
                  Foreground="#636e72"
                  BorderThickness="0"
                  Cursor="Hand"
                      Click="ClearResultButton_Click"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- 右下：历史记录 -->
        <Border Grid.Row="1"
            Background="White"
            CornerRadius="8"
            Padding="20">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                Margin="0,0,0,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0"
                  Text="📜 发行记录"
                  FontSize="15"
                  FontWeight="Bold"
                  Foreground="#2d3436"
                         VerticalAlignment="Center"/>
              <Button Grid.Column="1"
                  x:Name="ExportButton"
                  Content="📥 导出CSV"
                  Padding="12,5"
                  Margin="0,0,6,0"
                      Background="#0984e3"
                  Foreground="White"
                  BorderThickness="0"
                  FontSize="11"
                  Cursor="Hand"
                      Click="ExportButton_Click"/>
              <Button Grid.Column="2"
                  x:Name="RefreshButton"
                  Content="🔄 刷新"
                  Padding="12,5"
                  Margin="0,0,6,0"
                      Background="#00b894"
                  Foreground="White"
                  BorderThickness="0"
                  FontSize="11"
                  Cursor="Hand"
                      Click="RefreshButton_Click"/>
              <Button Grid.Column="3"
                  x:Name="ClearHistoryButton"
                  Content="🗑️ 清空历史"
                  Padding="12,5"
                      Background="#d63031"
                  Foreground="White"
                  BorderThickness="0"
                  FontSize="11"
                  Cursor="Hand"
                      Click="ClearHistoryButton_Click"/>
            </Grid>

            <DataGrid Grid.Row="1"
                x:Name="HistoryDataGrid"
                AutoGenerateColumns="False"
                      IsReadOnly="True"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                      GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                      AlternatingRowBackground="#f8f9fa"
                RowBackground="White"
                      BorderThickness="1"
                BorderBrush="#dfe6e9"
                      HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto">
              <DataGrid.Columns>
                <DataGridTextColumn Header="前缀"
                    Binding="{Binding MachineIdPrefix}"
                    Width="80">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="FontFamily"
                          Value="Consolas"/>
                      <Setter Property="FontSize"
                          Value="11"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="类型"
                    Binding="{Binding LicenseTypeName}"
                    Width="80"/>
                <DataGridTextColumn Header="发行时间"
                    Binding="{Binding IssuedTime, StringFormat='yyyy-MM-dd HH:mm'}"
                    Width="130"/>
                <DataGridTextColumn Header="到期时间"
                    Binding="{Binding ExpiryDisplay}"
                    Width="130"/>
                <DataGridTextColumn Header="发行者"
                    Binding="{Binding IssuedBy}"
                    Width="90"/>
                <DataGridTextColumn Header="备注"
                    Binding="{Binding Note}"
                    Width="*"/>
                <DataGridTemplateColumn Header="操作"
                    Width="80">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="📋"
                            Padding="6,2"
                            FontSize="11"
                            Background="#0984e3"
                            Foreground="White"
                                BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="复制授权码"
                                Click="CopyHistoryCode_Click"
                            Tag="{Binding}"/>
                        <Button Content="🗑️"
                            Padding="6,2"
                            FontSize="11"
                            Background="#d63031"
                            Foreground="White"
                                BorderThickness="0"
                            Cursor="Hand"
                            ToolTip="删除记录"
                            Margin="4,0,0,0"
                                Click="DeleteHistoryRecord_Click"
                            Tag="{Binding}"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2"
                x:Name="HistoryCountText"
                Text="共 0 条记录"
                FontSize="11"
                       Foreground="#b2bec3"
                Margin="0,8,0,0"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- 底部状态栏 -->
    <Border Grid.Row="2"
        Background="#dfe6e9"
        CornerRadius="6"
        Padding="12,8"
        Margin="0,12,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusTextBlock"
            Grid.Column="0"
            Text="就绪"
            FontSize="11"
            Foreground="#636e72"
            VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1"
            Text="NetSecurityScanner License Generator v1.0.2.2"
            FontSize="10"
            Foreground="#b2bec3"/>
      </Grid>
    </Border>
  </Grid>
</Window>