<Window x:Class="NetSecurityScanner.Views.UserApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⏳ 用户审核" Height="720" Width="1340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="640" MinWidth="1200"
        Background="#f8f9fa">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#fdcb6e" CornerRadius="8" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="⏳ 待审核用户" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="InfoText" Text="审核者: 加载中..." FontSize="12" Foreground="#fff5e1" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔍" Foreground="White" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="SearchTextBox" Width="180" Height="32" Padding="6,4" FontSize="13"
                             Background="White" BorderBrush="#dfe6e9" VerticalContentAlignment="Center"
                             TextChanged="SearchTextBox_TextChanged"
                             ToolTip="按用户名/邮箱/手机/显示名实时过滤"/>
                    <Button x:Name="ExportCsvButton" Content="📊 导出 CSV" Click="ExportCsvButton_Click"
                            Width="100" Height="32" Margin="8,0,0,0" Background="White" Foreground="#0984e3" Cursor="Hand"
                            ToolTip="导出当前过滤后的待审用户列表为 CSV 文件"/>
                    <Button x:Name="ViewAuditLogButton" Content="📜 审计日志" Click="ViewAuditLogButton_Click"
                            Width="100" Height="32" Margin="6,0,0,0" Background="White" Foreground="#d35400" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左右分栏 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="700"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：待审用户列表 -->
            <Grid Grid.Column="0">
                <DataGrid x:Name="PendingUsersDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="False"
                          SelectionMode="Extended"
                          SelectionChanged="PendingUsersDataGrid_SelectionChanged"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          GridLinesVisibility="Horizontal"
                          AlternatingRowBackground="#f1f2f6">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="✓" Binding="{Binding IsSelected, Mode=TwoWay}" Width="32"/>
                        <DataGridTextColumn Header="用户名" Binding="{Binding Username}" IsReadOnly="True" Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="显示名" Binding="{Binding DisplayName}" IsReadOnly="True" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="邮箱" Binding="{Binding Email}" IsReadOnly="True" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#0984e3"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="手机" Binding="{Binding Phone}" IsReadOnly="True" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="申请说明" Binding="{Binding ReasonShort}" IsReadOnly="True" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#636e72"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="等待时长" Binding="{Binding WaitDurationDisplay}" IsReadOnly="True" Width="90">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                    <Setter Property="Foreground" Value="#d35400"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 空数据状态层 -->
                <Border x:Name="EmptyHint" Visibility="Collapsed"
                        Background="White" BorderBrush="#dfe6e9" BorderThickness="1"
                        CornerRadius="4">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🎉" FontSize="42" HorizontalAlignment="Center"/>
                        <TextBlock Text="暂无待审用户" FontSize="15" FontWeight="Bold"
                                   Foreground="#2d3436" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                        <TextBlock Text="所有新注册用户都已被处理" FontSize="12"
                                   Foreground="#636e72" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="240"/>
                        <Button Content="🔄 刷新列表" Click="RefreshButton_Click" Width="120" Height="32"
                                Margin="0,16,0,0" Cursor="Hand"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 右侧：权限分配 -->
            <Border Grid.Column="1" Background="White" CornerRadius="6" Padding="18" Margin="12,0,0,0"
                    BorderBrush="#dfe6e9" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部：选中用户 + 权限模板 -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="📋 权限分配" FontSize="15" FontWeight="Bold" Foreground="#2d3436" Margin="0,0,0,8"/>
                        <TextBlock x:Name="SelectedUserText" Text="请在左侧选择待审用户"
                                   FontSize="13" Foreground="#636e72" Margin="0,0,0,12"/>

                        <!-- 权限模板 -->
                        <Border Background="#f8f9fa" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="📦 权限模板（一键应用）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="TemplateViewerButton" Content="👁 仅查看" Click="TemplateViewerButton_Click"
                                            Width="100" Height="30" Margin="0,0,6,0" Background="#dfe6e9" Cursor="Hand"
                                            ToolTip="仅可查看资产列表和详情，不能修改"/>
                                    <Button x:Name="TemplateOperatorButton" Content="🛠 普通操作员" Click="TemplateOperatorButton_Click"
                                            Width="120" Height="30" Margin="0,0,6,0" Background="#74b9ff" Foreground="White" Cursor="Hand"
                                            ToolTip="可查看、添加、编辑资产，不能删除"/>
                                    <Button x:Name="TemplateAssetManagerButton" Content="📋 资产管理员" Click="TemplateAssetManagerButton_Click"
                                            Width="120" Height="30" Margin="0,0,6,0" Background="#6c5ce7" Foreground="White" Cursor="Hand"
                                            ToolTip="可管理资产全流程（查看/增/改/删/导入/导出）"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 权限列表 -->
                    <TextBlock Grid.Row="1" Text="🔧 自定义权限（勾选生效）" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PermissionsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#f8f9fa" CornerRadius="4" Padding="12,8" Margin="0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="14" Foreground="#2d3436"/>
                                                <TextBlock Text="{Binding Key}" FontSize="11" Foreground="#636e72" FontFamily="Consolas, Courier New" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 备注 -->
                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="📝 备注（可选，会写入审计日志）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="RemarkTextBox" Height="48" Padding="6" FontSize="13"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                 Background="#fff5e1" BorderBrush="#fdcb6e"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="#dfe6e9" CornerRadius="4" Padding="12,6" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusBarText" Text="就绪" Foreground="#2d3436" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SelectAllButton" Content="☑ 全选" Width="80" Height="32" Click="SelectAllButton_Click" Margin="0,0,6,0" Cursor="Hand"
                    ToolTip="勾选当前过滤后列表中的所有用户"/>
            <Button x:Name="InvertSelectionButton" Content="🔄 反选" Width="80" Height="32" Click="InvertSelectionButton_Click" Margin="0,0,6,0" Cursor="Hand"
                    ToolTip="反向选择当前过滤后列表中的用户"/>
            <Button x:Name="ClearSelectionButton" Content="⬜ 清空" Width="80" Height="32" Click="ClearSelectionButton_Click" Margin="0,0,12,0" Cursor="Hand"
                    ToolTip="取消所有勾选"/>
            <TextBlock Text="批量：勾选多个用户 →" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#636e72" FontSize="12"/>
            <Button x:Name="BatchApproveButton" Content="✅ 批量批准" Width="100" Height="32" Click="BatchApproveButton_Click"
                    Background="#00b894" Foreground="White" FontWeight="Bold" Margin="0,0,6,0" IsEnabled="False" Cursor="Hand"/>
            <Button x:Name="BatchRejectButton" Content="🚫 批量拒绝" Width="100" Height="32" Click="BatchRejectButton_Click"
                    Background="#d63031" Foreground="White" FontWeight="Bold" Margin="0,0,12,0" IsEnabled="False" Cursor="Hand"/>
            <Button x:Name="RefreshButton" Content="🔄 刷新" Width="80" Height="32" Click="RefreshButton_Click" Margin="0,0,6,0" Cursor="Hand"/>
            <Button x:Name="ApproveButton" Content="✅ 批准" Width="90" Height="32" Click="ApproveButton_Click"
                    Background="#0984e3" Foreground="White" FontWeight="Bold" Margin="0,0,6,0" IsEnabled="False" Cursor="Hand"/>
            <Button x:Name="RejectButton" Content="🚫 拒绝" Width="90" Height="32" Click="RejectButton_Click"
                    Background="#d63031" Foreground="White" FontWeight="Bold" Margin="0,0,6,0" IsEnabled="False" Cursor="Hand"/>
            <Button Content="关闭" Width="80" Height="32" Click="CloseButton_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
