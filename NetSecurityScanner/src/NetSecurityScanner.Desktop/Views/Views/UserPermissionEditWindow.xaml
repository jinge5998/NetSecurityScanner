<Window x:Class="NetSecurityScanner.Views.UserPermissionEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔑 编辑用户权限" Height="560" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f8f9fa">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#6c5ce7" CornerRadius="8" Padding="18" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="🔑 编辑用户权限" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="HeaderText" Text="" FontSize="13" Foreground="#dfe6e9" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 快捷操作 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="SelectAllButton" Content="✅ 全选" Width="80" Height="30"
                    Click="SelectAllButton_Click" Margin="0,0,8,0" Cursor="Hand"/>
            <Button x:Name="SelectNoneButton" Content="⬜ 全不选" Width="80" Height="30"
                    Click="SelectNoneButton_Click" Margin="0,0,8,0" Cursor="Hand"/>
            <Button x:Name="SelectViewOnlyButton" Content="👁 仅查看" Width="90" Height="30"
                    Click="SelectViewOnlyButton_Click" Margin="0,0,8,0" Cursor="Hand"
                    ToolTip="仅勾选 Asset:View"/>
            <TextBlock x:Name="SelectedCountText" Text="已选 0 项" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold" Foreground="#2d3436"/>
        </StackPanel>

        <!-- 权限列表 -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="15" BorderBrush="#dfe6e9" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PermissionsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#f8f9fa" CornerRadius="4" Padding="12,8" Margin="0,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="14" Foreground="#2d3436"/>
                                        <TextBlock Text="{Binding Key}" FontSize="11" Foreground="#636e72" FontFamily="Consolas, Courier New" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="1" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center" Cursor="Hand"
                                              Checked="PermissionCheck_Changed" Unchecked="PermissionCheck_Changed"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 底部 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="SaveButton" Content="💾 保存" Width="100" Height="34"
                    Click="SaveButton_Click" Background="#00b894" Foreground="White"
                    FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand"/>
            <Button x:Name="CancelButton" Content="取消" Width="100" Height="34"
                    Click="CancelButton_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
