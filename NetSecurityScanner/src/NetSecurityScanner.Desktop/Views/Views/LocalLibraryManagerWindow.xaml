<Window x:Class="NetSecurityScanner.Views.LocalLibraryManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛠 本地 JSON 漏洞库管理" Height="500" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#8e44ad" Offset="0"/>
                    <GradientStop Color="#6c3483" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="🛠 本地 JSON 漏洞库管理" FontSize="16" FontWeight="Bold" Foreground="White"/>
        </Border>

        <!-- 当前库信息 -->
        <Border Grid.Row="1" Background="#f4f6f7" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="CurrentInfoText" FontSize="12" Foreground="#2c3e50" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- 快照列表 -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="12" BorderBrush="#e0e0e0" BorderThickness="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="📸 历史快照（最多 5 个，按时间倒序）" FontWeight="SemiBold" FontSize="13" Foreground="#34495e" Margin="0,0,0,8"/>
                <ListView x:Name="SnapshotListView" BorderThickness="0" Background="Transparent">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="文件名" Width="240" DisplayMemberBinding="{Binding FileName}"/>
                            <GridViewColumn Header="时间" Width="160" DisplayMemberBinding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}"/>
                            <GridViewColumn Header="条目数" Width="80" DisplayMemberBinding="{Binding Count}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </DockPanel>
        </Border>

        <!-- 操作按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RollbackButton" Content="↩ 回滚到选中快照" Width="160" Height="34"
                    Background="#2980b9" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Click="RollbackButton_Click" Cursor="Hand"/>
            <Button x:Name="ClearButton" Content="🗑 清空本地库" Width="140" Height="34"
                    Margin="8,0,0,0" Background="#c0392b" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Click="ClearButton_Click" Cursor="Hand"/>
            <Button x:Name="CancelButton" Content="取消" Width="80" Height="34"
                    Margin="8,0,0,0" Background="#95a5a6" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Click="CancelButton_Click" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
