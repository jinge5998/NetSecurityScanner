<Window x:Class="NetSecurityScanner.Views.CameraSecurityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="摄像头安全扫描"
        Height="780"
        Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <local:SeverityToBrushConverter x:Key="SeverityToBrush"
                                        xmlns:local="clr-namespace:NetSecurityScanner.Views"/>

        <Style x:Key="CardGroupBox"
               TargetType="GroupBox">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#E0E3EB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="#2C3E50"
                                Padding="10,5"
                                CornerRadius="3">
                            <TextBlock Text="{Binding}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="13"/>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SeverityCritical"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#E74C3C"/>
        </Style>
        <Style x:Key="SeverityHigh"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#E67E22"/>
        </Style>
        <Style x:Key="SeverityMedium"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#F1C40F"/>
        </Style>
        <Style x:Key="SeverityLow"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#27AE60"/>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#3498DB"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Padding"
                    Value="20,8"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="#BDC3C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background"
                    Value="#E74C3C"/>
            <Setter Property="Tag"
                    Value="#E74C3C"/>
        </Style>

        <Style x:Key="DataCell"
               TargetType="Border">
            <Setter Property="Padding"
                    Value="8,4"/>
            <Setter Property="BorderBrush"
                    Value="#EAECEF"/>
            <Setter Property="BorderThickness"
                    Value="0,0,0,1"/>
            <Setter Property="Background"
                    Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部：控制面板 -->
        <GroupBox Header=" 扫描配置 "
                  Style="{StaticResource CardGroupBox}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="目标 IP:"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           FontWeight="Bold"/>
                <TextBox Grid.Column="1"
                         x:Name="TxtTargetIp"
                         Text="192.168.1.100"
                         Height="32"
                         FontSize="14"
                         Padding="8,0"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2"
                           Text="品牌:"
                           VerticalAlignment="Center"
                           Margin="20,0,8,0"
                           FontWeight="Bold"/>
                <ComboBox Grid.Column="3"
                          x:Name="CmbVendor"
                          Height="32"
                          FontSize="13"
                          SelectedIndex="0">
                    <ComboBoxItem Content="自动识别"/>
                    <ComboBoxItem Content="Hikvision 海康威视"/>
                    <ComboBoxItem Content="Dahua 大华"/>
                    <ComboBoxItem Content="Axis"/>
                    <ComboBoxItem Content="Uniview 宇视"/>
                    <ComboBoxItem Content="TP-Link"/>
                </ComboBox>

                <Button Grid.Column="5"
                        x:Name="BtnStart"
                        Content="▶ 开始扫描"
                        Style="{StaticResource PrimaryButton}"
                        Width="130"
                        Height="36"
                        Margin="20,0,8,0"
                        Click="BtnStart_Click"/>
                <Button Grid.Column="5"
                        x:Name="BtnStop"
                        Content="■ 停止"
                        Style="{StaticResource DangerButton}"
                        Width="100"
                        Height="36"
                        Margin="160,0,0,0"
                        Visibility="Collapsed"
                        Click="BtnStop_Click"/>
                <Button Grid.Column="6"
                        x:Name="BtnExport"
                        Content="导出报告"
                        Height="36"
                        Padding="16,8"
                        VerticalAlignment="Center"
                        Click="BtnExport_Click"
                        IsEnabled="False"
                        Background="#95A5A6"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>
            </Grid>
        </GroupBox>

        <!-- 进度条 -->
        <Grid Grid.Row="1"
              Margin="0,0,0,8"
              Visibility="Collapsed"
              x:Name="ProgressBar">
            <ProgressBar Height="20"
                         Foreground="#3498DB"
                         Background="#E0E3EB"/>
        </Grid>

        <!-- 主区域：左日志 + 右结果 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：日志 -->
            <GroupBox Grid.Column="0"
                      Header=" 扫描日志 "
                      Style="{StaticResource CardGroupBox}">
                <TextBox x:Name="TxtLog"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="11"
                         Background="#1E1E2E"
                         Foreground="#CDD6F4"
                         BorderThickness="0"
                         Padding="8"
                         AcceptsReturn="True"/>
            </GroupBox>

            <!-- 分割线 -->
            <Border Grid.Column="1"
                    Background="#E0E3EB"/>

            <!-- 右侧：结果面板 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 设备信息 -->
                <GroupBox Grid.Row="0"
                          Header=" 设备信息 "
                          Style="{StaticResource CardGroupBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   Text="IP 地址:"
                                   FontWeight="Bold"
                                   Foreground="#7F8C8D"
                                   Margin="0,0,8,4"/>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   x:Name="LblIp"
                                   Text="—"
                                   FontWeight="Bold"
                                   Margin="0,0,20,4"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="2"
                                   Text="品牌:"
                                   FontWeight="Bold"
                                   Foreground="#7F8C8D"
                                   Margin="0,0,8,4"/>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="3"
                                   x:Name="LblVendor"
                                   Text="—"
                                   FontWeight="Bold"
                                   Margin="0,0,20,4"/>

                        <TextBlock Grid.Row="0"
                                   Grid.Column="4"
                                   Text="固件版本:"
                                   FontWeight="Bold"
                                   Foreground="#7F8C8D"
                                   Margin="0,0,8,4"/>
                        <TextBlock Grid.Row="0"
                                   Grid.Column="5"
                                   x:Name="LblFirmware"
                                   Text="—"
                                   Margin="0,0,0,4"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   Text="开放端口:"
                                   FontWeight="Bold"
                                   Foreground="#7F8C8D"
                                   Margin="0,4,8,0"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   x:Name="LblPorts"
                                   Text="—"
                                   TextWrapping="Wrap"
                                   Margin="0,4,20,0"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="2"
                                   Text="HTTP Server:"
                                   FontWeight="Bold"
                                   Foreground="#7F8C8D"
                                   Margin="0,4,8,0"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="3"
                                   x:Name="LblHttpServer"
                                   Text="—"
                                   Margin="0,4,20,0"/>

                        <TextBlock Grid.Row="1"
                                   Grid.Column="4"
                                   Text="可达性:"
                                   FontWeight="Bold"
                                   Foreground="#7F8C8D"
                                   Margin="0,4,8,0"/>
                        <TextBlock Grid.Row="1"
                                   Grid.Column="5"
                                   x:Name="LblReachable"
                                   Text="—"
                                   Margin="0,4,0,0"/>
                    </Grid>
                </GroupBox>

                <!-- 风险概览 -->
                <GroupBox Grid.Row="1"
                          Header=" 风险概览 "
                          Style="{StaticResource CardGroupBox}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal">
                            <Border Background="#27AE60"
                                    Width="4"
                                    Margin="0,0,6,0"/>
                            <TextBlock Text="Critical"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   x:Name="LblCritical"
                                   Text="0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#E74C3C"
                                   VerticalAlignment="Center"
                                   Margin="0,0,30,0"/>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal">
                            <Border Background="#E67E22"
                                    Width="4"
                                    Margin="0,0,6,0"/>
                            <TextBlock Text="High"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                   x:Name="LblHigh"
                                   Text="0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#E67E22"
                                   VerticalAlignment="Center"
                                   Margin="0,0,30,0"/>

                        <StackPanel Grid.Column="4"
                                    Orientation="Horizontal">
                            <Border Background="#F1C40F"
                                    Width="4"
                                    Margin="0,0,6,0"/>
                            <TextBlock Text="Medium"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Grid.Column="5"
                                   x:Name="LblMedium"
                                   Text="0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#F1C40F"
                                   VerticalAlignment="Center"
                                   Margin="0,0,30,0"/>

                        <StackPanel Grid.Column="6"
                                    Orientation="Horizontal">
                            <Border Background="#27AE60"
                                    Width="4"
                                    Margin="0,0,6,0"/>
                            <TextBlock Text="Low"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"/>
                        </StackPanel>
                        <TextBlock Grid.Column="7"
                                   x:Name="LblLow"
                                   Text="0"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#27AE60"
                                   VerticalAlignment="Center"
                                   Margin="0,0,30,0"/>

                        <TextBlock Grid.Column="8"
                                   Text="风险评分:"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   Foreground="#7F8C8D"
                                   Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="9"
                                   x:Name="LblScore"
                                   Text="—"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </GroupBox>

                <!-- 漏洞列表 -->
                <GroupBox Grid.Row="2"
                          Header=" 发现的漏洞 "
                          Style="{StaticResource CardGroupBox}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 表头 -->
                        <Border Grid.Row="0"
                                Background="#34495E"
                                CornerRadius="4,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="严重度"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           Padding="8,6"/>
                                <TextBlock Grid.Column="1"
                                           Text="漏洞名称"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           Padding="8,6"/>
                                <TextBlock Grid.Column="2"
                                           Text="CVE"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           Padding="8,6"/>
                                <TextBlock Grid.Column="3"
                                           Text="CVSS"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           Padding="8,6"/>
                                <TextBlock Grid.Column="4"
                                           Text="检测方式"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           Padding="8,6"/>
                            </Grid>
                        </Border>

                        <!-- 列表 -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ListFindings">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DataCell}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="70"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="120"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Width="60"
                                                        Height="24"
                                                        CornerRadius="3"
                                                        Background="{Binding Severity, Converter={StaticResource SeverityToBrush}}">
                                                    <TextBlock Text="{Binding Severity}"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               FontSize="11"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           Padding="8,4"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CveId}"
                                                           Padding="8,4"
                                                           Foreground="#2980B9"
                                                           FontFamily="Consolas"/>
                                                <TextBlock Grid.Column="3"
                                                           Text="{Binding CvssScore, StringFormat=F1}"
                                                           Padding="8,4"
                                                           FontWeight="Bold"/>
                                                <TextBlock Grid.Column="4"
                                                           Text="{Binding DetectionMethod}"
                                                           Padding="8,4"
                                                           Foreground="#7F8C8D"
                                                           FontSize="11"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 详情区 -->
                        <GridSplitter Grid.Row="2"
                                      Height="2"
                                      HorizontalAlignment="Stretch"
                                      Background="#E0E3EB"
                                      Margin="0,4"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </Grid>
    </Grid>
</Window>