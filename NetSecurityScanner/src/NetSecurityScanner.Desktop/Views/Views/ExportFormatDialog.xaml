<Window x:Class="NetSecurityScanner.Views.ExportFormatDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择导出格式" Height="260" Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="请选择导出格式：" FontSize="14" FontWeight="SemiBold"
                   Foreground="#1E293B" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1">
            <RadioButton x:Name="CsvRadio" Content="CSV (逗号分隔值，适合 Excel)" GroupName="Format"
                         FontSize="13" Margin="0,4" IsChecked="True"/>
            <RadioButton x:Name="JsonRadio" Content="JSON (结构化数据，适合程序处理)" GroupName="Format"
                         FontSize="13" Margin="0,4"/>
            <RadioButton x:Name="XmlRadio" Content="XML (标记语言，适合跨系统交换)" GroupName="Format"
                         FontSize="13" Margin="0,4"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Width="80" Height="32" Margin="0,0,8,0" IsCancel="True"
                    Background="White" BorderBrush="#CBD5E1" Cursor="Hand"/>
            <Button Content="确定" Width="80" Height="32" IsDefault="True" Click="OkButton_Click"
                    Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
