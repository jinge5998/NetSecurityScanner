<Window x:Class="NetSecurityScanner.Views.BatchScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetSecurityScanner.Views"
        Title="批量扫描" Height="750" Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" MinWidth="900" MinHeight="600"
        Background="#F5F6FA">
    <Window.Resources>
        <local:ThreatLevelToBrushConverter x:Key="ThreatLevelToBrushConverter"/>
        <local:ThreatLevelToForegroundConverter x:Key="ThreatLevelToForegroundConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#9B59B6" CornerRadius="4" Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="批量扫描" FontSize="22" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="同时扫描多个目标，支持IP段、CIDR和文件导入" FontSize="12" Foreground="#E8DAEF" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Row="0" Grid.ColumnSpan="2" Name="BatchScanProgressBar" Height="22" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,8"/>

                <StackPanel Grid.Row="1" Orientation="Horizontal">
                    <TextBlock Name="BatchScanStatusTextBlock" Text="准备就绪" FontWeight="SemiBold" FontSize="13" Margin="0,0,20,0"/>
                    <TextBlock Name="ElapsedTimeTextBlock" Text="已用时间: 00:00:00" FontSize="12" Foreground="#7F8C8D" Margin="0,0,20,0"/>
                    <TextBlock Name="RemainingTimeTextBlock" Text="预计剩余: --:--:--" FontSize="12" Foreground="#7F8C8D" Margin="0,0,20,0"/>
                    <TextBlock Name="CurrentScanningTargetTextBlock" Text="当前: -" FontSize="12" Foreground="#7F8C8D"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                    <Border Background="#3498DB" CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Name="TotalTargetsTextBlock" Text="总目标: 0" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#27AE60" CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Name="CompletedTargetsTextBlock" Text="已完成: 0" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#E74C3C" CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Name="FailedTargetsTextBlock" Text="失败: 0" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#E67E22" CornerRadius="3" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Name="TotalVulnerabilitiesTextBlock" Text="总漏洞: 0" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#C0392B" CornerRadius="3" Padding="8,4">
                        <TextBlock Name="TotalCriticalTextBlock" Text="严重: 0" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="1" Name="BatchScanProgressTextBlock" Text="0/0" FontWeight="Bold" FontSize="14" Foreground="#9B59B6" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Expander Grid.Row="0" Header="扫描配置" IsExpanded="False" Margin="0,0,0,5" Background="White" BorderBrush="#BDC3C7" BorderThickness="1">
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="目标类型：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" Name="BatchTargetTypeComboBox" Height="25" SelectionChanged="BatchTargetTypeComboBox_SelectionChanged">
                                <ComboBoxItem Content="IP 段范围" Tag="Range"/>
                                <ComboBoxItem Content="CIDR 网段" Tag="CIDR"/>
                                <ComboBoxItem Content="从文件导入" Tag="File"/>
                                <ComboBoxItem Content="手动输入列表" Tag="List"/>
                            </ComboBox>
                        </Grid>
                        <TextBox Name="BatchTargetValueTextBox" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,5"/>
                        <TextBlock Name="BatchTargetHintTextBlock" Text="提示：输入IP段，如 192.168.1.1-192.168.1.254" FontSize="10" Foreground="#7F8C8D" Margin="0,0,0,5"/>
                        <Button Name="ImportFileButton" Content="导入目标文件" Height="28" Margin="0,0,0,5" Background="#3498DB" Foreground="White" Click="ImportFileButton_Click" Visibility="Collapsed"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="扫描模式：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <ComboBox Grid.Column="1" Name="BatchScanModeComboBox" Height="25" SelectedIndex="1">
                                <ComboBoxItem Content="闪电扫描" Tag="Lightning"/>
                                <ComboBoxItem Content="标准扫描" Tag="Standard"/>
                                <ComboBoxItem Content="深度扫描" Tag="Deep"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="并发数：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Slider Grid.Column="1" Name="ConcurrencySlider" Minimum="1" Maximum="50" Value="10" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="ConcurrencyValueTextBlock" Text="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="超时(秒)：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Slider Grid.Column="1" Name="TimeoutSlider" Minimum="5" Maximum="60" Value="10" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Name="TimeoutValueTextBlock" Text="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <Button Name="ParseTargetsButton" Content="解析目标" Width="110" Height="30" Background="#27AE60" Foreground="White" FontWeight="Bold" Click="ParseTargetsButton_Click" Margin="0,0,10,0"/>
                            <TextBlock Name="ParsedTargetCountTextBlock" Text="已解析: 0 个目标" VerticalAlignment="Center" Foreground="#27AE60" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <Border Grid.Row="1" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#ECF0F1" Padding="8,5" CornerRadius="4,4,0,0">
                            <TextBlock Text="IP列表" FontWeight="Bold" FontSize="13"/>
                        </Border>
                        <ListView Grid.Row="1" Name="IpListView" SelectionMode="Single" SelectionChanged="IpListView_SelectionChanged" FontSize="12">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding ThreatLevel, Converter={StaticResource ThreatLevelToBrushConverter}}" Padding="4,3" Margin="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="14" Foreground="{Binding ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding IpAddress}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{Binding ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ProgressText}" FontSize="11" Foreground="{Binding ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding DurationText}" FontSize="11" Foreground="{Binding ThreatLevel, Converter={StaticResource ThreatLevelToForegroundConverter}}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="4" Background="White" Margin="5,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#2C3E50" Padding="12" CornerRadius="4,4,0,0">
                        <StackPanel>
                            <TextBlock Name="SelectedIpTextBlock" Text="选择左侧IP查看详情" Foreground="White" FontSize="15" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Name="SelectedIpStatusTextBlock" Text="" Foreground="#BDC3C7" FontSize="12" Margin="0,0,15,0"/>
                                <TextBlock Name="SelectedIpPortsTextBlock" Text="" Foreground="#3498DB" FontSize="12" Margin="0,0,15,0"/>
                                <TextBlock Name="SelectedIpVulnsTextBlock" Text="" Foreground="#E74C3C" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TabControl Grid.Row="1" Name="DetailTabControl" Margin="5">
                        <TabItem Header="开放端口">
                            <DataGrid Name="PortResultDataGrid" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#F8F9FA" FontSize="12" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="端口" Binding="{Binding PortNumber}" Width="70"/>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="60"/>
                                    <DataGridTextColumn Header="服务" Binding="{Binding Service}" Width="100"/>
                                    <DataGridTextColumn Header="版本" Binding="{Binding ServiceVersion}" Width="*"/>
                                    <DataGridTextColumn Header="响应时间" Binding="{Binding ResponseTime}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="漏洞列表">
                            <DataGrid Name="VulnResultDataGrid" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#F8F9FA" FontSize="12" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="漏洞名称" Binding="{Binding Name}" Width="200"/>
                                    <DataGridTextColumn Header="风险等级" Binding="{Binding RiskLevel}" Width="80"/>
                                    <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60"/>
                                    <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="StartBatchScanButton" Content="开始批量扫描" Width="140" Height="40" Margin="5" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14" Click="StartBatchScanButton_Click"/>
            <Button Name="StopBatchScanButton" Content="停止扫描" Width="120" Height="40" Margin="5" Background="#E74C3C" Foreground="White" FontWeight="Bold" IsEnabled="False" Click="StopBatchScanButton_Click"/>
            <Button Name="ExportBatchReportButton" Content="导出报告" Width="120" Height="40" Margin="5" Background="#3498DB" Foreground="White" FontWeight="Bold" IsEnabled="False" Click="ExportBatchReportButton_Click"/>
            <Button Name="CloseBatchWindowButton" Content="关闭" Width="100" Height="40" Margin="5" Background="#95A5A6" Foreground="White" Click="CloseBatchWindowButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
