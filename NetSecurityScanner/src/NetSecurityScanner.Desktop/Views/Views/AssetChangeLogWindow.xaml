<Window x:Class="NetSecurityScanner.Views.AssetChangeLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📜 资产变更日志" Height="600" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="#f8f9fa">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" Background="#6c5ce7" CornerRadius="8" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="📜 资产变更日志" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="所有资产的创建、修改、删除操作都会记录在此" FontSize="11" Foreground="#dfe6e9" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 工具条：按资产筛选 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="按资产筛选:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="AssetFilterCombo" Height="28" SelectionChanged="AssetFilterCombo_SelectionChanged" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            <Button Grid.Column="3" x:Name="ClearFilterButton" Content="✖ 清除筛选" Width="100" Height="28" Click="ClearFilterButton_Click"/>
        </Grid>

        <!-- 日志 DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#dfe6e9" BorderThickness="1">
            <DataGrid x:Name="ChangeLogDataGrid" AutoGenerateColumns="False"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#f8f9fa" BorderThickness="0"
                      IsReadOnly="True" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding ChangedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
                    <DataGridTextColumn Header="操作类型" Binding="{Binding ChangeType}" Width="80"/>
                    <DataGridTextColumn Header="资产ID" Binding="{Binding AssetId}" Width="220"/>
                    <DataGridTextColumn Header="字段" Binding="{Binding FieldName}" Width="100"/>
                    <DataGridTextColumn Header="旧值" Binding="{Binding OldValue}" Width="180"/>
                    <DataGridTextColumn Header="新值" Binding="{Binding NewValue}" Width="180"/>
                    <DataGridTextColumn Header="操作人" Binding="{Binding ChangedBy}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 底部状态/关闭 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" Grid.Column="0" Text="共 0 条记录" VerticalAlignment="Center" Foreground="#636e72"/>
            <Button Grid.Column="1" x:Name="CloseButton" Content="❌ 关闭" Width="100" Height="32" Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
