<Window x:Class="NetSecurityScanner.Views.CameraDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="摄像头详情"
        Width="1000"
        Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题 -->
        <Border Grid.Row="0" Background="White" BorderBrush="#CBD5E1" BorderThickness="1"
                CornerRadius="6" Padding="15,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleText" Text="摄像头详情" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock x:Name="SubTitleText" Text="" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="风险评分：" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RiskScoreText" Text="0.0" FontSize="28" FontWeight="Bold" Foreground="#E67E22" VerticalAlignment="Center"/>
                    <TextBlock Text=" / 100" FontSize="14" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="2,0,0,6"/>
                    <Border x:Name="RiskLevelBadge" Background="#F39C12" CornerRadius="4" Padding="10,4" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RiskLevelText" Text="--" Foreground="White" FontWeight="Bold" FontSize="14"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体：左侧 4 个 Tab + 右侧概览 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" Background="White" BorderBrush="#CBD5E1" Margin="0,0,10,0">
                <TabItem Header="📋 基本信息">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="BasicInfoGrid" Margin="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="🔓 开放端口">
                    <DataGrid x:Name="PortGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="White" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60"/>
                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="60"/>
                            <DataGridTextColumn Header="服务" Binding="{Binding Service}" Width="100"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"/>
                            <DataGridTextColumn Header="Banner" Binding="{Binding Banner}" Width="220"/>
                            <DataGridTextColumn Header="默认端口" Binding="{Binding IsDefaultPort}" Width="80"/>
                            <DataGridTextColumn Header="风险等级" Binding="{Binding RiskLevel}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="🛡 漏洞信息">
                    <DataGrid x:Name="VulnGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="White" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CVE" Binding="{Binding CveId}" Width="120"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180"/>
                            <DataGridTextColumn Header="严重等级" Binding="{Binding Severity}" Width="80"/>
                            <DataGridTextColumn Header="CVSS" Binding="{Binding CvssScore}" Width="60"/>
                            <DataGridTextColumn Header="修复版本" Binding="{Binding FixedVersion}" Width="100"/>
                            <DataGridTextColumn Header="修复建议" Binding="{Binding Solution}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="🔑 弱口令">
                    <DataGrid x:Name="WeakPwdGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              Background="White" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="服务" Binding="{Binding ServiceType}" Width="80"/>
                            <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="60"/>
                            <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="100"/>
                            <DataGridTextColumn Header="密码" Binding="{Binding Password}" Width="120"/>
                            <DataGridTextColumn Header="风险等级" Binding="{Binding RiskLevel}" Width="80"/>
                            <DataGridTextColumn Header="修复建议" Binding="{Binding Suggestion}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <!-- 右侧概览面板 -->
            <Border Grid.Column="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="📊 概览" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                        <TextBlock x:Name="SummaryVendorText" Text="厂商: --" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SummaryModelText" Text="型号: --" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SummaryFirmwareText" Text="固件: --" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SummarySerialText" Text="序列号: --" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                        <TextBlock x:Name="SummaryMacText" Text="MAC: --" FontSize="12" Foreground="#334155" Margin="0,0,0,6"/>
                        <Separator Margin="0,8"/>
                        <TextBlock Text="🔓 端口" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <TextBlock x:Name="PortCountText" Text="开放端口: 0" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                        <Separator Margin="0,8"/>
                        <TextBlock Text="🛡 漏洞" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <TextBlock x:Name="VulnTotalText" Text="漏洞总数: 0" FontSize="12" Foreground="#64748B" Margin="0,0,0,6"/>
                        <TextBlock x:Name="VulnCriticalText" Text="严重: 0" FontSize="12" Foreground="#C0392B" Margin="0,0,0,4"/>
                        <TextBlock x:Name="VulnHighText" Text="高危: 0" FontSize="12" Foreground="#E67E22" Margin="0,0,0,4"/>
                        <TextBlock x:Name="VulnMediumText" Text="中危: 0" FontSize="12" Foreground="#F39C12" Margin="0,0,0,6"/>
                        <Separator Margin="0,8"/>
                        <TextBlock Text="🔑 弱口令" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <TextBlock x:Name="WeakPwdCountText" Text="弱口令: 0" FontSize="12" Foreground="#C0392B" Margin="0,0,0,6"/>
                        <Separator Margin="0,8"/>
                        <TextBlock Text="🎯 优先修复建议" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="RemediationsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="12" Foreground="#334155"
                                               TextWrapping="Wrap" Margin="0,0,0,4"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="📋 复制全部信息" Click="CopyAll_Click"
                    Background="#3498DB" Foreground="White" BorderThickness="0"
                    Padding="14,8" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="关闭" Click="Close_Click" IsCancel="True"
                    Background="#94A3B8" Foreground="White" BorderThickness="0"
                    Padding="20,8" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
