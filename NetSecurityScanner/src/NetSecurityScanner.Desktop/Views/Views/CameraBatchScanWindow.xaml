<Window x:Class="NetSecurityScanner.Views.CameraBatchScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="摄像头批量扫描"
        Height="760"
        Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style x:Key="CardGroupBox"
               TargetType="GroupBox">
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#E0E3EB"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="10"/>
            <Setter Property="Margin"
                    Value="0,0,0,8"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="#2C3E50"
                                Padding="10,5"
                                CornerRadius="3">
                            <TextBlock Text="{Binding}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       FontSize="13"/>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#3498DB"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Padding"
                    Value="20,8"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="#2980B9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="bd"
                                        Property="Background"
                                        Value="#BDC3C7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background"
                    Value="#E74C3C"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 扫描配置 -->
        <GroupBox Grid.Row="0"
                  Header=" 扫描配置 "
                  Style="{StaticResource CardGroupBox}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 目标输入行 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="目标类型:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               FontWeight="Bold"/>
                    <ComboBox Grid.Column="1"
                              x:Name="CmbTargetType"
                              Height="32"
                              FontSize="13"
                              SelectedIndex="0"
                              SelectionChanged="CmbTargetType_SelectionChanged">
                        <ComboBoxItem Content="IP 段"
                                      Tag="Range"/>
                        <ComboBoxItem Content="CIDR"
                                      Tag="CIDR"/>
                        <ComboBoxItem Content="文件导入"
                                      Tag="File"/>
                        <ComboBoxItem Content="IP 列表"
                                      Tag="List"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2"
                               Text="目标:"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               FontWeight="Bold"/>
                    <TextBox Grid.Column="3"
                             x:Name="TxtTargetValue"
                             Height="32"
                             FontSize="13"
                             Padding="8,0"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="4"
                            x:Name="BtnImportFile"
                            Content="导入目标文件"
                            Height="32"
                            Padding="12,4"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Click="BtnImportFile_Click"/>
                    <Button Grid.Column="5"
                            Content="解析目标"
                            Height="32"
                            Padding="12,4"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Click="BtnParseTargets_Click"/>
                </Grid>

                <!-- 提示行 -->
                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            Margin="0,6,0,6">
                    <TextBlock x:Name="TxtTargetHint"
                               Text="提示：输入 IP 段，如 192.168.1.1-192.168.1.254"
                               Foreground="#7F8C8D"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtParsedCount"
                               Text=""
                               Foreground="#27AE60"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"/>
                </StackPanel>

                <!-- 选项行 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="品牌:"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               FontWeight="Bold"/>
                    <ComboBox Grid.Column="1"
                              x:Name="CmbVendor"
                              Height="32"
                              FontSize="13"
                              SelectedIndex="0">
                        <ComboBoxItem Content="自动识别"
                                      Tag=""/>
                        <ComboBoxItem Content="Hikvision 海康威视"
                                      Tag="Hikvision"/>
                        <ComboBoxItem Content="Dahua 大华"
                                      Tag="Dahua"/>
                        <ComboBoxItem Content="Axis"
                                      Tag="Axis"/>
                        <ComboBoxItem Content="Uniview 宇视"
                                      Tag="Uniview"/>
                        <ComboBoxItem Content="TP-Link"
                                      Tag="TP-Link"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2"
                               Text="扫描模式:"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               FontWeight="Bold"/>
                    <ComboBox Grid.Column="3"
                              x:Name="CmbScanMode"
                              Height="32"
                              FontSize="13"
                              SelectedIndex="0">
                        <ComboBoxItem Content="快速扫描"
                                      Tag="Quick"/>
                        <ComboBoxItem Content="完整扫描"
                                      Tag="Full"/>
                    </ComboBox>

                    <CheckBox Grid.Column="4"
                              x:Name="ChkWeakPassword"
                              Content="弱口令检测（需授权）"
                              IsChecked="False"
                              VerticalAlignment="Center"
                              Margin="16,0,0,0"
                              FontWeight="Bold"
                              Foreground="#C0392B"
                              Checked="ChkWeakPassword_Checked"/>

                    <TextBlock Grid.Column="6"
                               Text="并发数:"
                               VerticalAlignment="Center"
                               Margin="16,0,8,0"
                               FontWeight="Bold"/>
                    <Slider Grid.Column="7"
                            x:Name="ConcurrencySlider"
                            Minimum="1"
                            Maximum="20"
                            Value="5"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="8"
                               x:Name="TxtConcurrencyValue"
                               Text="5"
                               Width="28"
                               TextAlignment="Right"
                               VerticalAlignment="Center"
                               FontWeight="Bold"
                               Foreground="#2C3E50"/>
                </Grid>

                <!-- 操作按钮行 -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,0">
                    <Button x:Name="BtnStart"
                            Content="▶ 开始批量扫描"
                            Style="{StaticResource PrimaryButton}"
                            Width="150"
                            Height="36"
                            Margin="0,0,8,0"
                            Click="BtnStart_Click"/>
                    <Button x:Name="BtnStop"
                            Content="■ 停止"
                            Style="{StaticResource DangerButton}"
                            Width="100"
                            Height="36"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="BtnStop_Click"/>
                    <Button x:Name="BtnExport"
                            Content="导出汇总报告"
                            Height="36"
                            Padding="16,8"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            Background="#95A5A6"
                            Foreground="White"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnExport_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 汇总统计 + 总进度 -->
        <GroupBox Grid.Row="1"
                  Header=" 汇总统计 "
                  Style="{StaticResource CardGroupBox}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal">
                    <TextBlock x:Name="TxtTotalTargets"
                               Text="总目标: 0"
                               FontWeight="Bold"
                               Margin="0,0,24,0"/>
                    <TextBlock x:Name="TxtCompleted"
                               Text="已完成: 0"
                               Foreground="#27AE60"
                               FontWeight="Bold"
                               Margin="0,0,24,0"/>
                    <TextBlock x:Name="TxtFailed"
                               Text="失败: 0"
                               Foreground="#E74C3C"
                               FontWeight="Bold"
                               Margin="0,0,24,0"/>
                    <TextBlock x:Name="TxtTotalFindings"
                               Text="总漏洞: 0"
                               Foreground="#E67E22"
                               FontWeight="Bold"
                               Margin="0,0,24,0"/>
                    <TextBlock x:Name="TxtTotalCritical"
                               Text="Critical: 0"
                               Foreground="#C0392B"
                               FontWeight="Bold"/>
                </StackPanel>
                <ProgressBar Grid.Row="1"
                             x:Name="OverallProgressBar"
                             Height="14"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Margin="0,8,0,0"
                             Foreground="#3498DB"
                             Background="#E0E3EB"/>
            </Grid>
        </GroupBox>

        <!-- 结果列表 -->
        <GroupBox Grid.Row="2"
                  Header=" 扫描结果（双击行查看单目标详情） "
                  Style="{StaticResource CardGroupBox}">
            <DataGrid x:Name="GridResults"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EAECEF"
                      RowHeaderWidth="0"
                      MouseDoubleClick="GridResults_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="IP 地址"
                                        Width="130"
                                        Binding="{Binding IpAddress}"/>
                    <DataGridTextColumn Header="状态"
                                        Width="90"
                                        Binding="{Binding Status}"/>
                    <DataGridTextColumn Header="品牌"
                                        Width="110"
                                        Binding="{Binding Vendor}"/>
                    <DataGridTextColumn Header="开放端口"
                                        Width="70"
                                        Binding="{Binding OpenPortsCount}"/>
                    <DataGridTextColumn Header="漏洞数"
                                        Width="70"
                                        Binding="{Binding FindingsCount}"/>
                    <DataGridTextColumn Header="Critical"
                                        Width="70"
                                        Binding="{Binding CriticalCount}"/>
                    <DataGridTextColumn Header="High"
                                        Width="60"
                                        Binding="{Binding HighCount}"/>
                    <DataGridTextColumn Header="风险评分"
                                        Width="80"
                                        Binding="{Binding RiskScore}"/>
                    <DataGridTextColumn Header="耗时"
                                        Width="80"
                                        Binding="{Binding DurationText}"/>
                    <DataGridTextColumn Header="错误信息"
                                        Width="*"
                                        Binding="{Binding ErrorMessage}"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Window>
