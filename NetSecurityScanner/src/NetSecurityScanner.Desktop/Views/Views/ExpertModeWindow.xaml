                                Content="⚡ 快速扫描"
                                Width="110"
                                Height="35"
                                Margin="5"
                                Background="#E67E22"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                ToolTip="快速模式：常见端口 + 短超时 + 高并发 + 关闭服务检测"
                                Click="QuickScanPresetButton_Click"/>
                        <Button Name="DeepScanPresetButton"
                                Content="🔍 深度扫描"
                                Width="110"
                                Height="35"
                                Margin="5"
                                Background="#8E44AD"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                ToolTip="深度模式：全部端口 + 长超时 + 服务检测 + 全量漏洞检测"
                                Click="DeepScanPresetButton_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Name="StartExpertScanButton"
                                Content="🚀 开始专家扫描"
                                Width="140"
                                Height="40"
                                Margin="5"
                                Background="#27AE60"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="14"
                                BorderThickness="0"
                                Click="StartExpertScanButton_Click"/>
                        <Button Name="CancelExpertButton"
                                Content="❌ 取消"
                                Width="100"
                                Height="40"
                                Margin="5"
                                Background="#E74C3C"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderThickness="0"
                                Click="CancelExpertButton_Click"/>
                    </StackPanel>
                </Grid>
                <!-- 扫描计划预览 -->
                <Border Grid.Row="1"
                        Background="#F8F9FA"
                        CornerRadius="4"
                        Padding="10"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal">
                            <TextBlock Text="🎯 目标数量: "
                                       FontSize="12"
                                       Foreground="#7F8C8D"/>
                            <TextBlock Name="TargetCountPreviewText"
                                       Text="0"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#3498DB"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal">
                            <TextBlock Text="🔌 端口数量: "
                                       FontSize="12"
                                       Foreground="#7F8C8D"/>
                            <TextBlock Name="PortCountPreviewText"
                                       Text="0"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#E67E22"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal">
                            <TextBlock Text="⏱️ 预计耗时: "
                                       FontSize="12"
                                       Foreground="#7F8C8D"/>
                            <TextBlock Name="EstimatedTimePreviewText"
                                       Text="0秒"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#27AE60"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal">
                            <TextBlock Text="📊 总扫描数: "
                                       FontSize="12"
                                       Foreground="#7F8C8D"/>
                            <TextBlock Name="TotalScansPreviewText"
                                       Text="0"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="#9B59B6"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>