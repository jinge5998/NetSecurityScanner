<Window x:Class="NetSecurityScanner.Views.ExpertModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="专家模式 - 高级扫描配置"
        Height="800"
        Width="1100"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F7FA">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,0">
                    <GradientStop Color="#2C3E50"
                                  Offset="0"/>
                    <GradientStop Color="#3498DB"
                                  Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border CornerRadius="6"
                    Padding="20,15">
                <StackPanel>
                    <TextBlock Text="🔧 专家模式 - 高级扫描配置"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="自定义所有扫描参数，精细控制扫描行为，适用于高级安全测试场景"
                               FontSize="13"
                               Foreground="#BDC3C7"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- 主内容区域 -->
        <TabControl Grid.Row="1"
                    Margin="0,15,0,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Name="ExpertTabControl"
                    SelectionChanged="ExpertTabControl_SelectionChanged">
            <!-- Tab 1: 目标配置 -->
            <TabItem Header="🎯 目标配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <!-- 目标类型 -->
                        <Border BorderBrush="#BDC3C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,8"
                                Background="White">
                            <StackPanel Margin="12">
                                <TextBlock Text="目标类型"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#2C3E50"
                                           Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <RadioButton Name="SingleIpRadio"
                                                 Content="单个IP/域名"
                                                 GroupName="TargetType"
                                                 IsChecked="True"
                                                 Margin="0,0,20,5"
                                                 Checked="TargetTypeRadio_Checked"/>
                                    <RadioButton Name="IpRangeRadio"
                                                 Content="IP段范围"
                                                 GroupName="TargetType"
                                                 Margin="0,0,20,5"
                                                 Checked="TargetTypeRadio_Checked"/>
                                    <RadioButton Name="CidrRadio"
                                                 Content="CIDR网段"
                                                 GroupName="TargetType"
                                                 Margin="0,0,20,5"
                                                 Checked="TargetTypeRadio_Checked"/>
                                    <RadioButton Name="FileRadio"
                                                 Content="文件列表"
                                                 GroupName="TargetType"
                                                 Margin="0,0,20,5"
                                                 Checked="TargetTypeRadio_Checked"/>
                                    <RadioButton Name="RegexRadio"
                                                 Content="正则模式"
                                                 GroupName="TargetType"
                                                 Margin="0,0,0,5"
                                                 Checked="TargetTypeRadio_Checked"/>
                                </WrapPanel>
                                <TextBox Name="TargetInputTextBox"
                                         Height="55"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,8,0,5"
                                         BorderBrush="#BDC3C7"
                                         BorderThickness="1"
                                         Padding="5"/>
                                <TextBlock Name="TargetHintTextBlock"
                                           Text="提示：输入单个IP地址，如 192.168.1.1 或 www.example.com"
                                           FontSize="11"
                                           Foreground="#7F8C8D"
                                           Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,5,0,0">
                                    <Button Name="ImportFileButton"
                                            Content="📁 导入文件"
                                            Width="100"
                                            Height="28"
                                            Background="#3498DB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="ImportFileButton_Click"/>
                                    <Button Name="PasteFromClipboardButton"
                                            Content="📋 从剪贴板粘贴"
                                            Width="130"
                                            Height="28"
                                            Background="#27AE60"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="PasteFromClipboardButton_Click"
                                            Margin="5,0,0,0"/>
                                    <TextBlock Name="TargetCountTextBlock"
                                               Text="目标数量: 1"
                                               Margin="15,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="#27AE60"
                                               FontWeight="SemiBold"/>
                                    <Button Name="DeduplicateButton"
                                            Content="🔄 去重"
                                            Width="80"
                                            Height="28"
                                            Background="#1ABC9C"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="DeduplicateButton_Click"
                                            Margin="10,0,0,0"/>
                                    <Button Name="PreviewTargetsButton"
                                            Content="👁️ 预览"
                                            Width="80"
                                            Height="28"
                                            Background="#34495E"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="PreviewTargetsButton_Click"
                                            Margin="5,0,0,0"/>
                                    <Button Name="ExportTargetsButton"
                                            Content="📤 导出"
                                            Width="80"
                                            Height="28"
                                            Background="#2ECC71"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="ExportTargetsButton_Click"
                                            Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 高级目标选项 -->
                        <Border BorderBrush="#BDC3C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,8"
                                Background="White">
                            <StackPanel Margin="12">
                                <TextBlock Text="高级目标选项"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#2C3E50"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <CheckBox Name="ReverseDnsCheckBox"
                                              Content="启用反向DNS解析"
                                              Margin="0,0,20,0"/>
                                    <CheckBox Name="HostDiscoveryCheckBox"
                                              Content="先进行主机发现"
                                              IsChecked="True"
                                              Margin="0,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,5">
                                    <Label Content="排除主机："
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0"/>
                                    <TextBox Name="ExcludeHostsTextBox"
                                             Width="300"
                                             Height="25"
                                             BorderBrush="#BDC3C7"
                                             BorderThickness="1"/>
                                </StackPanel>
                                <TextBlock Text="多个主机用逗号分隔，如：192.168.1.100,10.0.0.0/24"
                                           FontSize="10"
                                           Foreground="#95A5A6"
                                           Margin="0,0,0,5"/>
                            </StackPanel>
                        </Border>

                        <!-- 目标分组管理 -->
                        <Border BorderBrush="#BDC3C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,8"
                                Background="White">
                            <StackPanel Margin="12">
                                <TextBlock Text="📁 目标分组管理"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#2C3E50"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,8">
                                    <ComboBox Name="TargetGroupComboBox"
                                              Width="180"
                                              Height="28"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="全部分组"
                                                      Tag="all"/>
                                    </ComboBox>
                                    <Button Name="AddGroupButton"
                                            Content="➕ 新建分组"
                                            Width="90"
                                            Height="28"
                                            Background="#3498DB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="AddGroupButton_Click"
                                            Margin="8,0,0,0"/>
                                    <Button Name="DeleteGroupButton"
                                            Content="🗑️ 删除分组"
                                            Width="90"
                                            Height="28"
                                            Background="#E74C3C"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="DeleteGroupButton_Click"
                                            Margin="5,0,0,0"/>
                                    <Button Name="AssignGroupButton"
                                            Content="📌 分配到分组"
                                            Width="100"
                                            Height="28"
                                            Background="#27AE60"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="AssignGroupButton_Click"
                                            Margin="5,0,0,0"/>
                                </StackPanel>
                                <TextBlock Name="GroupInfoTextBlock"
                                           Text="当前分组：全部分组 | 目标数：0"
                                           FontSize="11"
                                           Foreground="#7F8C8D"/>
                            </StackPanel>
                        </Border>

                        <!-- 智能推荐 -->
                        <Border BorderBrush="#BDC3C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,8"
                                Background="White">
                            <StackPanel Margin="12">
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,5">
                                    <TextBlock Text="智能推荐"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="#2C3E50"
                                               Margin="0,0,15,0"/>
                                    <Button Name="RecommendButton"
                                            Content="💡 推荐模式"
                                            Width="110"
                                            Height="28"
                                            Background="#9B59B6"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="RecommendButton_Click"/>
                                </StackPanel>
                                <TextBlock Name="RecommendResultTextBlock"
                                           Text="点击「推荐模式」按钮，根据目标数量和网络条件自动推荐扫描参数"
                                           FontSize="12"
                                           Foreground="#7F8C8D"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                                <Button Name="ApplyRecommendButton"
                                        Content="✅ 应用推荐"
                                        Width="110"
                                        Height="26"
                                        Margin="0,8,0,0"
                                        Background="#27AE60"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Visibility="Collapsed"
                                        Click="ApplyRecommendButton_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- 实时扫描日志 -->
                        <Border BorderBrush="#BDC3C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="White">
                            <StackPanel Margin="15">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📝 扫描日志"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               Foreground="#2C3E50"/>
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <Button Name="ExportLogButton"
                                                Content="📥 导出日志"
                                                Width="90"
                                                Height="28"
                                                Background="#16A085"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Click="ExportLogButton_Click"
                                                Margin="0,0,5,0"/>
                                        <Button Name="ClearLogButton"
                                                Content="🗑️ 清空日志"
                                                Width="90"
                                                Height="28"
                                                Background="#95A5A6"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Click="ClearLogButton_Click"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox Name="ScanLogTextBox"
                                         Height="120"
                                         IsReadOnly="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         Background="#1E1E1E"
                                         Foreground="#D4D4D4"
                                         BorderBrush="#BDC3C7"
                                         BorderThickness="1"
                                         Padding="8"
                                         TextWrapping="NoWrap"
                                         AcceptsReturn="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 端口与服务 -->
            <TabItem Header="🔌 端口与服务">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- 端口扫描模式 -->
                        <Border BorderBrush="#BDC3C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,10"
                                Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="端口扫描模式"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#2C3E50"
                                           Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <RadioButton Name="CommonPortsRadio"
                                                 Content="常用端口(Top 1000)"
                                                 GroupName="PortMode"
                                                 IsChecked="True"
                                                 Margin="0,0,15,5"/>
                                    <RadioButton Name="SensitivePortsRadio"
                                                 Content="敏感端口"
                                                 GroupName="PortMode"
                                                 Margin="0,0,15,5"/>
                                    <RadioButton Name="AllPortsRadio"
                                                 Content="全部端口(1-65535)"
                                                 GroupName="PortMode"
                                                 Margin="0,0,15,5"/>
                                    <RadioButton Name="CustomPortsRadio"
                                                 Content="自定义端口"
                                                 GroupName="PortMode"
                                                 Margin="0,0,0,5"/>
                                </WrapPanel>
                                <TextBox Name="CustomPortsTextBox"
                                         Height="60"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         Margin="0,10,0,5"
                                         IsEnabled="False"
                                         BorderBrush="#BDC3C7"
                                         BorderThickness="1"
                                         Padding="5"
                                         Text="21,22,23,25,53,80,110,143,443,993,995,1433,3306,3389,5432,6379,8080,8443,9200,27017"/>
                                <TextBlock Text="支持范围格式：22,80,443,8000-9000"
                                           FontSize="11"
                                           Foreground="#7F8C8D"
                                           Margin="0,0,0,10"/>
                                <!-- 预设场景下拉框 -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,5,0,0">
                                    <Label Content="预设场景："
                                           VerticalAlignment="Center"
                                           Margin="0,0,5,0"/>
                                    <ComboBox Name="PortPresetComboBox"
                                              Width="220"
                                              Height="28"
                                              SelectionChanged="PortPresetComboBox_SelectionChanged">
                                        <ComboBoxItem Content="-- 请选择预设场景 --"
                                                      Tag="-1"/>
                                        <ComboBoxItem Content="🌐 Web 服务器"
                                                      Tag="WebServer"/>
                                        <ComboBoxItem Content="🗄️ 数据库"
                                                      Tag="Database"/>
                                        <ComboBoxItem Content="🐳 容器/编排"
                                                      Tag="Container"/>
                                        <ComboBoxItem Content="🔑 远程访问"
                                                      Tag="RemoteAccess"/>
                                        <ComboBoxItem Content="📧 邮件服务"
                                                      Tag="MailServer"/>
                                        <ComboBoxItem Content="📁 文件共享"
                                                      Tag="FileShare"/>
                                        <ComboBoxItem Content="⚙️ DevOps 工具"
                                                      Tag="DevOps"/>
                                        <ComboBoxItem Content="📡 IoT 设备"
                                                      Tag="IoTDevice"/>
                                        <ComboBoxItem Content="📊 监控运维"
                                                      Tag="Monitoring"/>
                                        <ComboBoxItem Content="⚠️ 高危端口（重点）"
                                                      Tag="HighRisk"/>
                                    </ComboBox>
                                    <Button Name="ApplyPresetButton"
                                            Content="✅ 应用预设"
                                            Width="100"
                                            Height="28"
                                            Margin="10,0,0,0"
                                            Background="#16A085"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="ApplyPresetButton_Click"/>
                                    <TextBlock Name="PresetDescriptionTextBlock"
                                               Text=""
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="#7F8C8D"
                                               FontSize="11"
                                               TextWrapping="NoWrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 协议与检测 -->
                        <Border BorderBrush="#BDC3C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,10"
                                Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="协议与检测"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#2C3E50"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,10">
                                    <CheckBox Name="TcpScanCheckBox"
                                              Content="TCP扫描"
                                              IsChecked="True"
                                              Margin="0,0,15,0"/>
                                    <CheckBox Name="UdpScanCheckBox"
                                              Content="UDP扫描"
                                              Margin="0,0,15,0"/>
                                    <CheckBox Name="SynScanCheckBox"
                                              Content="SYN半开扫描"
                                              Margin="0,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,5">
                                    <CheckBox Name="ServiceVersionCheckBox"
                                              Content="服务版本检测"
                                              IsChecked="True"
                                              Margin="0,0,15,0"/>
                                    <CheckBox Name="OsDetectCheckBox"
                                              Content="操作系统识别"
                                              Margin="0,0,15,0"/>
                                    <CheckBox Name="ScriptScanCheckBox"
                                              Content="NSE脚本扫描"
                                              Margin="0,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,10,0,5">
                                    <Label Content="服务检测强度："
                                           VerticalAlignment="Center"/>
                                    <ComboBox Name="ServiceIntensityComboBox"
                                              Width="200"
                                              Height="28"
                                              SelectedIndex="1">
                                        <ComboBoxItem Content="0 - 仅常用端口"/>
                                        <ComboBoxItem Content="1 - 标准检测"/>
                                        <ComboBoxItem Content="2 - 增强检测"/>
                                        <ComboBoxItem Content="3 - 全部检测"/>
                                        <ComboBoxItem Content="4 - 暴力检测"/>
                                        <ComboBoxItem Content="5 - 强度5（nmap 7）"/>
                                        <ComboBoxItem Content="6 - 强度6（nmap 8）"/>
                                        <ComboBoxItem Content="7 - 强度7（nmap 9）"/>
                                        <ComboBoxItem Content="8 - 强度8"/>
                                        <ComboBoxItem Content="9 - 强度9（最深度）"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 端口排除 -->
                        <Border BorderBrush="#BDC3C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="端口排除列表"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#2C3E50"
                                           Margin="0,0,0,10"/>
                                <TextBox Name="ExcludePortsTextBox"
                                         Height="40"
                                         TextWrapping="Wrap"
                                         BorderBrush="#BDC3C7"
                                         BorderThickness="1"
                                         Padding="5"
                                         Text=""/>
                                <TextBlock Text="不扫描的端口，用逗号分隔"
                                           FontSize="11"
                                           Foreground="#7F8C8D"
                                           Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: 性能调优 -->
            <TabItem Header="⚡ 性能调优">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <!-- 扫描引擎 -->
                        <Border BorderBrush="#BDC3C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,10"
                                Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="扫描引擎"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#2C3E50"
                                           Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,0,0,5">
                                    <RadioButton Name="RustEngineRadio"
                                                 Content="Rust引擎（推荐，高速）"
                                                 GroupName="ScanEngine"
                                                 IsChecked="True"
                                                 Margin="0,0,20,0"
                                                 Checked="ScanEngineRadio_Checked"/>
                                    <RadioButton Name="BuiltInEngineRadio"
                                                 Content="内置C#引擎（兼容模式）"
                                                 GroupName="ScanEngine"
                                                 Margin="0,0,0,0"
                                                 Checked="ScanEngineRadio_Checked"/>
                                </StackPanel>
                                <TextBlock Name="EngineStatusTextBlock"
                                           Text="Rust引擎就绪"
                                           FontSize="11"
                                           Foreground="#27AE60"
                                           Margin="0,5,0,0"/>
                                <TextBlock Name="EnginePathTextBlock"
                                           Text=""
                                           FontSize="10"
                                           Foreground="#7F8C8D"
                                           Margin="0,2,0,0"
                                           TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,8,0,0">
                                    <Button Name="TestRustEngineButton"
                                            Content="🧪 自检引擎"
                                            Width="100"
                                            Height="26"
                                            Background="#3498DB"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="TestRustEngineButton_Click"
                                            ToolTip="启动并连接一次 Rust 引擎，验证可用性"/>
                                    <Button Name="OpenRustFolderButton"
                                            Content="📂 打开目录"
                                            Width="100"
                                            Height="26"
                                            Background="#95A5A6"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="OpenRustFolderButton_Click"
                                            Margin="6,0,0,0"
                                            ToolTip="在资源管理器中打开 Rust 引擎所在目录"/>
                                    <Button Name="CopyRustPathButton"
                                            Content="📋 复制路径"
                                            Width="100"
                                            Height="26"
                                            Background="#1ABC9C"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Click="CopyRustPathButton_Click"
                                            Margin="6,0,0,0"
                                            ToolTip="复制 Rust 引擎完整路径到剪贴板"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 并发控制 -->
                        <Border BorderBrush="#BDC3C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Margin="0,0,0,10"
                                Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="并发控制"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#2C3E50"
                                           Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"
                                                Margin="0,0,10,0">
                                        <Label Content="TCP最大并发数："
                                               FontWeight="SemiBold"/>
                                        <Slider Name="TcpConcurrencySlider"
                                                Minimum="1"
                                                Maximum="500"
                                                Value="50"
                                                TickFrequency="10"
                                                IsSnapToTickEnabled="True"
                                                Margin="0,0,0,5"/>
                                        <TextBlock Name="TcpConcurrencyValueTextBlock"
                                                   Text="50"
                                                   HorizontalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Foreground="#3498DB"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0">
                                        <Label Content="UDP最大并发数："
                                               FontWeight="SemiBold"/>
                                        <Slider Name="UdpConcurrencySlider"
                                                Minimum="1"
                                                Maximum="200"
                                                Value="20"
                                                TickFrequency="5"
                                                IsSnapToTickEnabled="True"
