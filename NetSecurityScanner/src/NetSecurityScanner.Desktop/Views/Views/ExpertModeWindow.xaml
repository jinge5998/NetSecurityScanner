                        </Border>

                        <!-- 卡片2: 风险等级分布 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="风险等级分布" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Canvas Name="RiskLevelPieChart" Grid.Column="0" Width="200" Height="200"/>
                                    <Canvas Name="RiskLevelBarChart" Grid.Column="1" Width="300" Height="200" Margin="15,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 卡片3: 服务类型分布 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10" Background="White">
                            <StackPanel Margin="15">
                                <TextBlock Text="服务类型分布" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                <Canvas Name="ServiceTypeBarChart" Width="500" Height="200"/>
                            </StackPanel>
                        </Border>

                        <!-- 卡片4: 导出图片按钮 -->
                        <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Background="White">
                            <StackPanel Margin="15">
                                <Button Name="ExportChartImageButton" Content="📷 导出图片" Width="120" Height="35"
                                        Background="#3498DB" Foreground="White" BorderThickness="0"
                                        Click="ExportChartImageButton_Click" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- Tab 10: 专项工具 -->
            <TabItem Header="🔧 专项工具">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <WrapPanel>
                            <!-- 卡片1: 弱口令检测 -->
                            <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,10,10" Background="White" Width="350">
                                <StackPanel Margin="15">
                                    <TextBlock Text="🔐 弱口令检测" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                    <TextBlock Text="目标地址：" FontSize="12" Foreground="#7F8C8D"/>
                                    <TextBox Name="WeakPasswordTargetTextBox" Height="25" Margin="0,2,0,8" BorderBrush="#BDC3C7" BorderThickness="1" Padding="3"/>
                                    <TextBlock Text="服务类型：" FontSize="12" Foreground="#7F8C8D"/>
                                    <ComboBox Name="WeakPasswordServiceComboBox" Height="25" Margin="0,2,0,8" SelectedIndex="0">
                                        <ComboBoxItem Content="SSH"/>
                                        <ComboBoxItem Content="FTP"/>
                                        <ComboBoxItem Content="MySQL"/>
                                        <ComboBoxItem Content="MSSQL"/>
                                    </ComboBox>
                                    <TextBlock Text="用户名字典：" FontSize="12" Foreground="#7F8C8D"/>
                                    <TextBox Name="UsernameDictTextBox" Height="25" Margin="0,2,0,8" BorderBrush="#BDC3C7" BorderThickness="1" Padding="3" IsReadOnly="True"/>
                                    <TextBlock Text="密码字典：" FontSize="12" Foreground="#7F8C8D"/>
                                    <TextBox Name="PasswordDictTextBox" Height="25" Margin="0,2,0,8" BorderBrush="#BDC3C7" BorderThickness="1" Padding="3" IsReadOnly="True"/>
                                    <Button Name="StartWeakPasswordScanButton" Content="开始检测" Width="100" Height="28"
                                            Background="#E74C3C" Foreground="White" BorderThickness="0"
                                            Click="StartWeakPasswordScanButton_Click" Margin="0,5,0,5"/>
                                    <TextBlock Name="WeakPasswordStatusTextBlock" Text="状态：就绪" FontSize="11" Foreground="#95A5A6"/>
                                    <DataGrid Name="WeakPasswordResultDataGrid" Height="100" AutoGenerateColumns="False"
                                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="All"
                                              RowHeaderWidth="0" IsReadOnly="True" Margin="0,5,0,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="用户名" Binding="{Binding Username}" Width="*"/>
                                            <DataGridTextColumn Header="密码" Binding="{Binding Password}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <!-- 卡片2: 目录扫描 -->
                            <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,10,10" Background="White" Width="350">
                                <StackPanel Margin="15">
                                    <TextBlock Text="📂 目录扫描" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                    <TextBlock Text="目标URL：" FontSize="12" Foreground="#7F8C8D"/>
                                    <TextBox Name="DirScanUrlTextBox" Height="25" Margin="0,2,0,8" BorderBrush="#BDC3C7" BorderThickness="1" Padding="3" Text="http://example.com"/>
                                    <TextBlock Text="字典选择：" FontSize="12" Foreground="#7F8C8D"/>
                                    <ComboBox Name="DirScanDictComboBox" Height="25" Margin="0,2,0,8" SelectedIndex="0">
                                        <ComboBoxItem Content="常用目录字典"/>
                                        <ComboBoxItem Content="PHP字典"/>
                                        <ComboBoxItem Content="ASP字典"/>
                                        <ComboBoxItem Content="JSP字典"/>
                                    </ComboBox>
                                    <Button Name="StartDirScanButton" Content="开始扫描" Width="100" Height="28"
                                            Background="#E67E22" Foreground="White" BorderThickness="0"
                                            Click="StartDirScanButton_Click" Margin="0,5,0,5"/>
                                    <TextBlock Name="DirScanStatusTextBlock" Text="状态：就绪" FontSize="11" Foreground="#95A5A6"/>
                                    <ListBox Name="DirScanResultListBox" Height="130" BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 卡片3: POC验证 -->
                            <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,10,10" Background="White" Width="350">
                                <StackPanel Margin="15">
                                    <TextBlock Text="💉 POC验证" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                    <TextBlock Text="目标地址：" FontSize="12" Foreground="#7F8C8D"/>
                                    <TextBox Name="PocTargetTextBox" Height="25" Margin="0,2,0,8" BorderBrush="#BDC3C7" BorderThickness="1" Padding="3"/>
                                    <TextBlock Text="POC插件列表：" FontSize="12" Foreground="#7F8C8D"/>
                                    <ListBox Name="PocPluginListBox" Height="80" BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,2,0,8" SelectionMode="Multiple"/>
                                    <Button Name="StartPocVerifyButton" Content="开始验证" Width="100" Height="28"
                                            Background="#9B59B6" Foreground="White" BorderThickness="0"
                                            Click="StartPocVerifyButton_Click" Margin="0,5,0,5"/>
                                    <TextBlock Name="PocStatusTextBlock" Text="状态：就绪" FontSize="11" Foreground="#95A5A6"/>
                                    <TextBox Name="PocResultTextBox" Height="80" IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" BorderBrush="#BDC3C7" BorderThickness="1"
                                             Margin="0,5,0,0" Text="提示信息"/>
                                </StackPanel>
                            </Border>

                            <!-- 卡片4: CMS识别 -->
                            <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Margin="0,0,10,10" Background="White" Width="350">
                                <StackPanel Margin="15">
                                    <TextBlock Text="🆔 CMS识别" FontWeight="Bold" FontSize="14" Foreground="#2C3E50" Margin="0,0,0,10"/>
                                    <TextBlock Text="目标URL：" FontSize="12" Foreground="#7F8C8D"/>
                                    <TextBox Name="CmsIdentifyUrlTextBox" Height="25" Margin="0,2,0,8" BorderBrush="#BDC3C7" BorderThickness="1" Padding="3" Text="http://example.com"/>
                                    <Button Name="StartCmsIdentifyButton" Content="开始识别" Width="100" Height="28"
                                            Background="#1ABC9C" Foreground="White" BorderThickness="0"
                                            Click="StartCmsIdentifyButton_Click" Margin="0,5,0,5"/>
                                    <TextBlock Name="CmsStatusTextBlock" Text="状态：就绪" FontSize="11" Foreground="#95A5A6"/>
                                    <TextBlock Name="CmsResultTextBlock" Text="提示信息" TextWrapping="Wrap"
                                               FontSize="12" Foreground="#2C3E50" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 底部按钮区域 -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="15" Margin="0,15,0,0"
                BorderBrush="#BDC3C7" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Name="LoadPresetButton" Content="📂 加载预设" Width="100" Height="35"
                                Margin="5" Background="#95A5A6" Foreground="White" BorderThickness="0"
                                Click="LoadPresetButton_Click"/>
                        <Button Name="SavePresetButton" Content="💾 保存预设" Width="100" Height="35"
                                Margin="5" Background="#95A5A6" Foreground="White" BorderThickness="0"
                                Click="SavePresetButton_Click"/>
                        <Button Name="ExportNmapButton" Content="📋 导出Nmap命令" Width="120" Height="35"
                                Margin="5" Background="#9B59B6" Foreground="White" BorderThickness="0"
                                Click="ExportNmapButton_Click"/>
                        <Button Name="ValidateConfigButton" Content="✅ 验证配置" Width="100" Height="35"
                                Margin="5" Background="#3498DB" Foreground="White" BorderThickness="0"
                                Click="ValidateConfigButton_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Name="StartExpertScanButton" Content="🚀 开始专家扫描" Width="140" Height="40"
                                Margin="5" Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14"
                                BorderThickness="0" Click="StartExpertScanButton_Click"/>
                        <Button Name="CancelExpertButton" Content="❌ 取消" Width="100" Height="40"
                                Margin="5" Background="#E74C3C" Foreground="White" FontWeight="Bold"
                                BorderThickness="0" Click="CancelExpertButton_Click"/>
                    </StackPanel>
                </Grid>
                <!-- 扫描计划预览 -->
                <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="4" Padding="10" BorderBrush="#E0E0E0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="🎯 目标数量: " FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock Name="TargetCountPreviewText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#3498DB"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="🔌 端口数量: " FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock Name="PortCountPreviewText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#E67E22"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="⏱️ 预计耗时: " FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock Name="EstimatedTimePreviewText" Text="0秒" FontSize="12" FontWeight="Bold" Foreground="#27AE60"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                            <TextBlock Text="📊 总扫描数: " FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock Name="TotalScansPreviewText" Text="0" FontSize="12" FontWeight="Bold" Foreground="#9B59B6"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
