<Window x:Class="NetSecurityScanner.Views.EmailConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="📧 邮件配置" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- 标题 -->
        <Border Grid.Row="0" Background="#3498DB" CornerRadius="4" Padding="15" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="📧 SMTP邮件配置" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="配置邮件服务器以接收扫描通知" FontSize="12" Foreground="#D6EAF8" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <!-- 配置表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- SMTP服务器 -->
                <Label Content="SMTP服务器地址：" FontWeight="SemiBold"/>
                <TextBox Name="SmtpServerTextBox" Height="30" Margin="0,0,0,15"/>
                
                <!-- SMTP端口 -->
                <Label Content="SMTP端口：" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBox Name="SmtpPortTextBox" Width="100" Height="30" Text="587"/>
                    <CheckBox Name="EnableSslCheckBox" Content="启用SSL/TLS加密" IsChecked="True" 
                              VerticalAlignment="Center" Margin="20,0,0,0"/>
                </StackPanel>
                
                <!-- 发件人邮箱 -->
                <Label Content="发件人邮箱：" FontWeight="SemiBold"/>
                <TextBox Name="FromEmailTextBox" Height="30" Margin="0,0,0,15"/>
                
                <!-- 发件人名称 -->
                <Label Content="发件人名称：" FontWeight="SemiBold"/>
                <TextBox Name="FromNameTextBox" Height="30" Margin="0,0,0,15" Text="网络安全扫描器"/>
                
                <!-- 用户名 -->
                <Label Content="SMTP用户名：" FontWeight="SemiBold"/>
                <TextBox Name="UsernameTextBox" Height="30" Margin="0,0,0,15"/>
                
                <!-- 密码 -->
                <Label Content="SMTP密码/授权码：" FontWeight="SemiBold"/>
                <PasswordBox Name="PasswordBox" Height="30" Margin="0,0,0,15"/>
                
                <!-- 测试收件人 -->
                <Label Content="测试收件人邮箱：" FontWeight="SemiBold"/>
                <TextBox Name="TestRecipientTextBox" Height="30" Margin="0,0,0,15"/>
                
                <!-- 常用配置模板 -->
                <Label Content="快速配置模板：" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <Button Content="QQ邮箱" Width="80" Height="30" Margin="0,0,10,0" 
                            Background="#3498DB" Foreground="White" Click="QQEmailTemplate_Click"/>
                    <Button Content="163邮箱" Width="80" Height="30" Margin="0,0,10,0" 
                            Background="#E74C3C" Foreground="White" Click="NeteaseEmailTemplate_Click"/>
                    <Button Content="Gmail" Width="80" Height="30" Margin="0,0,10,0" 
                            Background="#27AE60" Foreground="White" Click="GmailTemplate_Click"/>
                    <Button Content="Outlook" Width="80" Height="30" 
                            Background="#9B59B6" Foreground="White" Click="OutlookTemplate_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        
        <!-- 底部按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Name="TestConnectionButton" Content="🧪 测试连接" Width="120" Height="40" 
                    Margin="5" Background="#F39C12" Foreground="White" FontWeight="Bold" Click="TestConnectionButton_Click"/>
            <Button Name="SaveConfigButton" Content="💾 保存配置" Width="120" Height="40" 
                    Margin="5" Background="#27AE60" Foreground="White" FontWeight="Bold" Click="SaveConfigButton_Click"/>
            <Button Name="CancelButton" Content="❌ 取消" Width="100" Height="40" 
                    Margin="5" Background="#95A5A6" Foreground="White" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
