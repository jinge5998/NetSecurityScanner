                                                Height="400"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 端口分析 -->
            <TabItem Header="🔌 端口分析">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
