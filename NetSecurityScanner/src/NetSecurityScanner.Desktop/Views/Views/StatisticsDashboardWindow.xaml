                                          Width="150"
                                          Height="28"
                                          SelectionChanged="ComparePeriodComboBox_SelectionChanged">
                                    <ComboBoxItem Content="与上一周期"
                                            IsSelected="True"/>
                                    <ComboBoxItem Content="与上一月同期"/>
                                    <ComboBoxItem Content="与上一季度同期"/>
                                    <ComboBoxItem Content="与去年同月"/>
                                    <ComboBoxItem Content="无对比"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 时间维度统计卡片 -->
