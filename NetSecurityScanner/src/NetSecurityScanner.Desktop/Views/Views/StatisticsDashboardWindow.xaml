                            <TextBlock Text="最常见开放端口TOP20"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,10"/>
                            <lvc:CartesianChart Name="PortChart"
                                                Height="400"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="8"
                            Margin="10,0,0,0"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <StackPanel Margin="15">
                            <TextBlock Text="服务类型分布"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,10"/>
