                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 时间粒度选择器 -->
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="8"
                            Margin="0,0,0,10"
                            Padding="15"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                                <TextBlock Text="时间粒度: "
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Margin="0,0,10,0"
                                           VerticalAlignment="Center"/>
                                <ComboBox Name="TimeGranularityComboBox"
                                          Width="100"
                                          Height="28"
                                          SelectionChanged="TimeGranularityComboBox_SelectionChanged">
                                    <ComboBoxItem Content="按日"
                                            IsSelected="True"/>
                                    <ComboBoxItem Content="按周"/>
                                    <ComboBoxItem Content="按月"/>
                                    <ComboBoxItem Content="按季度"/>
                                    <ComboBoxItem Content="按年"/>
                                </ComboBox>
