<Window x:Class="NetSecurityScanner.Views.StatisticsDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="📊 扫描统计仪表板"
        Height="850"
        Width="1200"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F7FA">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题区域 -->
        <Border Grid.Row="0"
                CornerRadius="8"
                Margin="0,0,0,15">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0"
                                     EndPoint="1,0">
                    <GradientStop Color="#9B59B6"
                                  Offset="0"/>
                    <GradientStop Color="#3498DB"
                                  Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="25,15">
                <StackPanel>
                    <TextBlock Text="📊 扫描统计仪表板"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="可视化展示扫描数据统计、安全趋势和漏洞分析"
                               FontSize="13"
                               Foreground="#E8DAEF"
                               Margin="0,8,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button Name="RefreshButton"
                            Content="🔄 刷新数据"
                            Width="100"
                            Height="32"
                            Margin="0,0,8,0"
                            Background="White"
                            Foreground="#9B59B6"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="RefreshButton_Click"
                            Cursor="Hand"/>
                    <Button Name="ExportButton"
                            Content="📊 导出数据"
                            Width="100"
                            Height="32"
                            Background="#27AE60"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="ExportButton_Click"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 统计卡片 -->
        <Grid Grid.Row="1"
              Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    CornerRadius="8"
                    Margin="0,0,8,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#3498DB"
                                      Offset="0"/>
                        <GradientStop Color="#2980B9"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="15">
                    <TextBlock Text="🔍 总扫描次数"
                               Foreground="#D5E8F7"
                               FontSize="12"/>
                    <TextBlock Name="TotalScansTextBlock"
                               Text="0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,5,0,0"/>
                    <TextBlock Name="AvgScansPerDayTextBlock"
                               Text="0 次/天"
                               Foreground="#D5E8F7"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    CornerRadius="8"
                    Margin="4,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#E74C3C"
                                      Offset="0"/>
                        <GradientStop Color="#C0392B"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="15">
                    <TextBlock Text="⚠️ 总漏洞数"
                               Foreground="#FADBD8"
                               FontSize="12"/>
                    <TextBlock Name="TotalVulnsTextBlock"
                               Text="0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,5,0,0"/>
                    <TextBlock Name="VulnsPerScanTextBlock"
                               Text="0 个/次"
                               Foreground="#FADBD8"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    CornerRadius="8"
                    Margin="4,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#E67E22"
                                      Offset="0"/>
                        <GradientStop Color="#D35400"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="15">
                    <TextBlock Text="🔴 严重/高危"
                               Foreground="#FAE5D3"
                               FontSize="12"/>
                    <TextBlock Name="CriticalVulnsTextBlock"
                               Text="0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,5,0,0"/>
                    <TextBlock Name="CriticalPercentTextBlock"
                               Text="0%"
                               Foreground="#FAE5D3"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    CornerRadius="8"
                    Margin="4,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#27AE60"
                                      Offset="0"/>
                        <GradientStop Color="#229954"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="15">
                    <TextBlock Text="🟢 开放端口"
                               Foreground="#D5F5E3"
                               FontSize="12"/>
                    <TextBlock Name="TotalPortsTextBlock"
                               Text="0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,5,0,0"/>
                    <TextBlock Name="AvgPortsPerScanTextBlock"
                               Text="0 个/次"
                               Foreground="#D5F5E3"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    CornerRadius="8"
                    Margin="4,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#8E44AD"
                                      Offset="0"/>
                        <GradientStop Color="#7D3C98"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="15">
                    <TextBlock Text="🎯 扫描目标"
                               Foreground="#E8DAEF"
                               FontSize="12"/>
                    <TextBlock Name="TotalTargetsTextBlock"
                               Text="0"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,5,0,0"/>
                    <TextBlock Name="UniqueTargetsTextBlock"
                               Text="0 个唯一"
                               Foreground="#E8DAEF"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="5"
                    CornerRadius="8"
                    Margin="8,0,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#1ABC9C"
                                      Offset="0"/>
                        <GradientStop Color="#16A085"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="15">
                    <TextBlock Text="📅 统计周期"
                               Foreground="#D1F2EB"
                               FontSize="12"/>
                    <TextBlock Name="TimeRangeTextBlock"
                               Text="-"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,5,0,0"/>
                    <TextBlock Name="DaysCountTextBlock"
                               Text="0 天"
                               Foreground="#D1F2EB"
                               FontSize="11"
                               Margin="0,3,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 筛选和图表控制 -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="8"
                Margin="0,0,0,15"
                Padding="15"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="筛选: "
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                    <ComboBox Name="TimeRangeComboBox"
                              Width="110"
                              Height="28"
                              SelectionChanged="TimeRangeComboBox_SelectionChanged">
                        <ComboBoxItem Content="本周"
                                      IsSelected="True"/>
                        <ComboBoxItem Content="本月"/>
                        <ComboBoxItem Content="本季度"/>
                        <ComboBoxItem Content="本年度"/>
                        <ComboBoxItem Content="最近7天"/>
                        <ComboBoxItem Content="最近30天"/>
                        <ComboBoxItem Content="最近90天"/>
                        <ComboBoxItem Content="全部时间"/>
                    </ComboBox>
                    <TextBlock Text="从"
                               VerticalAlignment="Center"
                               Margin="10,0,5,0"
                               FontSize="12"/>
                    <DatePicker Name="CustomStartDatePicker"
                                Width="110"
                                Height="28"
                                SelectedDateChanged="CustomDatePicker_SelectedDateChanged"/>
                    <TextBlock Text="到"
                               VerticalAlignment="Center"
                               Margin="10,0,5,0"
                               FontSize="12"/>
                    <DatePicker Name="CustomEndDatePicker"
                                Width="110"
                                Height="28"
                                SelectedDateChanged="CustomDatePicker_SelectedDateChanged"/>
                    <Button Name="ApplyCustomDateBtn"
                            Content="应用"
                            Width="50"
                            Height="28"
                            Margin="8,0,0,0"
                            Click="ApplyCustomDateBtn_Click"
                            Background="#3498DB"
                            Foreground="White"
                            BorderThickness="0"/>
                    <ComboBox Name="RiskFilterComboBox"
                              Width="100"
                              Height="28"
                              Margin="15,0,0,0"
                              SelectionChanged="RiskFilterComboBox_SelectionChanged">
                        <ComboBoxItem Content="全部风险"
                                      IsSelected="True"/>
                        <ComboBoxItem Content="严重"/>
                        <ComboBoxItem Content="高危"/>
                        <ComboBoxItem Content="中危"/>
                        <ComboBoxItem Content="低危"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="趋势粒度: "
                               FontSize="12"
                               Foreground="#7F8C8D"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>
                    <RadioButton Name="GranularityDay"
                                 Content="按天"
                                 GroupName="TrendGranularity"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Checked="GranularityRadioButton_Changed"/>
                    <RadioButton Name="GranularityWeek"
                                 Content="按周"
                                 GroupName="TrendGranularity"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Checked="GranularityRadioButton_Changed"/>
                    <RadioButton Name="GranularityMonth"
                                 Content="按月"
                                 GroupName="TrendGranularity"
                                 IsChecked="True"
                                 Margin="0,0,10,0"
                                 VerticalAlignment="Center"
                                 Checked="GranularityRadioButton_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox Name="AutoRefreshCheckBox"
                              Content="自动刷新"
                              Margin="0,0,15,0"
                              VerticalAlignment="Center"
                              Checked="AutoRefreshCheckBox_Changed"
                              Unchecked="AutoRefreshCheckBox_Changed"/>
                    <TextBlock Name="LastUpdateTimeTextBlock"
                               FontSize="12"
                               Foreground="#7F8C8D"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 多周期统计对比卡片 -->
        <Grid Grid.Row="3"
              Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 本周统计 -->
            <Border Grid.Column="0"
                    CornerRadius="8"
                    Margin="0,0,6,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#3498DB"
                                      Offset="0"/>
                        <GradientStop Color="#2980B9"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="12">
                    <TextBlock Text="📆 本周扫描"
                               Foreground="#D5E8F7"
                               FontSize="11"/>
                    <TextBlock Name="WeekScanCountText"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,3,0,0"/>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,2,0,0">
                        <TextBlock Name="WeekScanChangeText"
                                   Text="--"
                                   Foreground="#D5E8F7"
                                   FontSize="10"/>
                    </StackPanel>
                    <TextBlock Text="漏洞: "
                               Name="WeekVulnLabel"
                               Foreground="#D5E8F7"
                               FontSize="10"
                               Margin="0,5,0,0"/>
                    <TextBlock Name="WeekVulnCountText"
                               Text="0"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- 本月统计 -->
            <Border Grid.Column="1"
                    CornerRadius="8"
                    Margin="3,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#9B59B6"
                                      Offset="0"/>
                        <GradientStop Color="#8E44AD"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="12">
                    <TextBlock Text="📅 本月扫描"
                               Foreground="#E8DAEF"
                               FontSize="11"/>
                    <TextBlock Name="MonthScanCountText"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,3,0,0"/>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,2,0,0">
                        <TextBlock Name="MonthScanChangeText"
                                   Text="--"
                                   Foreground="#E8DAEF"
                                   FontSize="10"/>
                    </StackPanel>
                    <TextBlock Text="漏洞: "
                               Name="MonthVulnLabel"
                               Foreground="#E8DAEF"
                               FontSize="10"
                               Margin="0,5,0,0"/>
                    <TextBlock Name="MonthVulnCountText"
                               Text="0"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- 本季度统计 -->
            <Border Grid.Column="2"
                    CornerRadius="8"
                    Margin="3,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#E74C3C"
                                      Offset="0"/>
                        <GradientStop Color="#C0392B"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="12">
                    <TextBlock Text="📊 本季度扫描"
                               Foreground="#FADBD8"
                               FontSize="11"/>
                    <TextBlock Name="QuarterScanCountText"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,3,0,0"/>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,2,0,0">
                        <TextBlock Name="QuarterScanChangeText"
                                   Text="--"
                                   Foreground="#FADBD8"
                                   FontSize="10"/>
                    </StackPanel>
                    <TextBlock Text="漏洞: "
                               Name="QuarterVulnLabel"
                               Foreground="#FADBD8"
                               FontSize="10"
                               Margin="0,5,0,0"/>
                    <TextBlock Name="QuarterVulnCountText"
                               Text="0"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- 本年度统计 -->
            <Border Grid.Column="3"
                    CornerRadius="8"
                    Margin="6,0,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0"
                                         EndPoint="1,1">
                        <GradientStop Color="#F39C12"
                                      Offset="0"/>
                        <GradientStop Color="#D68910"
                                      Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Margin="12">
                    <TextBlock Text="🗓️ 本年度扫描"
                               Foreground="#FDEBD0"
                               FontSize="11"/>
                    <TextBlock Name="YearScanCountText"
                               Text="0"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,3,0,0"/>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,2,0,0">
                        <TextBlock Name="YearScanChangeText"
                                   Text="--"
                                   Foreground="#FDEBD0"
                                   FontSize="10"/>
                    </StackPanel>
                    <TextBlock Text="漏洞: "
                               Name="YearVulnLabel"
                               Foreground="#FDEBD0"
                               FontSize="10"
                               Margin="0,5,0,0"/>
                    <TextBlock Name="YearVulnCountText"
                               Text="0"
                               Foreground="White"
                               FontSize="14"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 详细统计 -->
        <TabControl Grid.Row="4"
                    Background="Transparent"
                    BorderThickness="0">
            <!-- 风险分布 -->
            <TabItem Header="🎯 风险分布">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <StackPanel Margin="15">
                            <TextBlock Text="风险等级分布"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,10"/>
                            <lvc:PieChart Name="RiskPieChart"
                                          Height="280"
                                          LegendPosition="Bottom"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="8"
                            Margin="5,0"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <StackPanel Margin="15">
                            <TextBlock Text="漏洞趋势(柱状图)"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,10"/>
                            <lvc:CartesianChart Name="VulnBarChart"
                                                Height="280"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Background="White"
                            CornerRadius="8"
                            Margin="10,0,0,0"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <StackPanel Margin="15">
                            <TextBlock Text="风险等级明细"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,10"/>
                            <StackPanel Name="RiskDistributionPanel">
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 扫描趋势 -->
            <TabItem Header="📈 扫描趋势">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="White"
                            CornerRadius="8"
                            Margin="0,0,0,10"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <StackPanel Margin="15">
                            <TextBlock Text="扫描活动趋势"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,10"/>
                            <lvc:CartesianChart Name="ScanTrendChart"
                                                Height="250"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1"
                            Background="White"
                            CornerRadius="8"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <StackPanel Margin="15">
                            <TextBlock Text="每日扫描统计明细"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,10"/>
                            <DataGrid Name="ScanTrendDataGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal"
                                      AlternatingRowBackground="#F8F9FA"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      HeadersVisibility="Column"
                                      MaxHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="日期"
                                                        Binding="{Binding Date}"
                                                        Width="100"/>
                                    <DataGridTextColumn Header="扫描次数"
                                                        Binding="{Binding ScanCount}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="开放端口"
                                                        Binding="{Binding PortCount}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="漏洞总数"
                                                        Binding="{Binding VulnerabilityCount}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="严重"
                                                        Binding="{Binding CriticalCount}"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="高危"
                                                        Binding="{Binding HighCount}"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="中危"
                                                        Binding="{Binding MediumCount}"
                                                        Width="70"/>
                                    <DataGridTextColumn Header="低危"
                                                        Binding="{Binding LowCount}"
                                                        Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TOP漏洞 -->
            <TabItem Header="⚠️ TOP漏洞">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="8"
                            Margin="0,0,10,0"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <StackPanel Margin="15">
                            <TextBlock Text="最常见的漏洞TOP15"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="#2C3E50"
                                       Margin="0,0,0,10"/>
                            <DataGrid Name="TopVulnerabilitiesDataGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal"
                                      AlternatingRowBackground="#F8F9FA"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      HeadersVisibility="Column"
                                      MaxHeight="400">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="排名"
                                                        Binding="{Binding Rank}"
                                                        Width="50"/>
                                    <DataGridTextColumn Header="漏洞名称"
                                                        Binding="{Binding Name}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="CVE编号"
                                                        Binding="{Binding CveId}"
                                                        Width="130"/>
                                    <DataGridTextColumn Header="出现次数"
                                                        Binding="{Binding Count}"
                                                        Width="80"/>
                                    <DataGridTextColumn Header="风险等级"
                                                        Binding="{Binding RiskLevel}"
                                                        Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1"
