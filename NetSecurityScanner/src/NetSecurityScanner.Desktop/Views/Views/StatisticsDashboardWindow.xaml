                                          MaxHeight="400">
                                <StackPanel Name="ServiceDistributionPanel">
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 扫描历史 -->
            <TabItem Header="📋 扫描历史">
                <Border Background="White"
                        CornerRadius="8"
                        Margin="10"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                    <StackPanel Margin="15">
                        <TextBlock Text="所有扫描记录"
                                   FontWeight="Bold"
                                   FontSize="14"
                                   Foreground="#2C3E50"
                                   Margin="0,0,0,10"/>
                        <DataGrid Name="ScanHistoryDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F8F9FA"
                                  IsReadOnly="True"
                                  SelectionMode="Extended"
                                  HeadersVisibility="Column"
                                  MouseDoubleClick="ScanHistoryDataGrid_MouseDoubleClick"
                                  MaxHeight="500">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="扫描时间"
                                                    Binding="{Binding ScanTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="目标"
                                                    Binding="{Binding TargetIp}"
                                                    Width="150"/>
                                <DataGridTextColumn Header="扫描类型"
                                                    Binding="{Binding ScanType}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="开放端口"
                                                    Binding="{Binding OpenPortsCount}"
                                                    Width="80"/>
                                <DataGridTextColumn Header="漏洞数"
                                                    Binding="{Binding VulnerabilitiesCount}"
                                                    Width="80"/>
                                <DataGridTextColumn Header="风险等级"
                                                    Binding="{Binding RiskLevel}"
                                                    Width="80"/>
                                <DataGridTextColumn Header="扫描ID"
                                                    Binding="{Binding ScanId}"
                                                    Width="200"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </TabItem>

            <!-- 时间维度分析 -->
