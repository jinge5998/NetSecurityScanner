<Window x:Class="NetSecurityScanner.Views.AgentSecurityScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent安全扫描"
        Width="1300"
        Height="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="StyledGroupBox"
                TargetType="GroupBox">
            <Setter Property="Background"
                    Value="#FFFFFF"/>
            <Setter Property="BorderBrush"
                    Value="#BDC3C7"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="5"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Border Background="#3498DB"
                                Padding="8,4"
                                CornerRadius="4,4,0,0">
                            <TextBlock Text="{Binding}"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    FontSize="12"/>
                        </Border>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid单元格样式 -->
        <Style x:Key="DataGridCellStyle"
                TargetType="DataGridCell">
            <Setter Property="Padding"
                    Value="8,5"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
        </Style>

        <!-- DataGrid表头样式 -->
        <Style x:Key="DataGridColumnHeaderStyle"
                TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="#2C3E50"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontWeight"
                    Value="Bold"/>
            <Setter Property="Padding"
                    Value="10,8"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>
        </Style>

        <!-- 风险卡片样式 - Critical -->
        <Style x:Key="RiskCardCritical"
                TargetType="Border">
            <Setter Property="Background"
                    Value="#FDECEC"/>
            <Setter Property="CornerRadius"
                    Value="6"/>
            <Setter Property="BorderBrush"
                    Value="#E74C3C"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <!-- 风险卡片样式 - High -->
        <Style x:Key="RiskCardHigh"
                TargetType="Border">
            <Setter Property="Background"
                    Value="#FEF0E6"/>
            <Setter Property="CornerRadius"
                    Value="6"/>
            <Setter Property="BorderBrush"
                    Value="#E67E22"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <!-- 风险卡片样式 - Medium -->
        <Style x:Key="RiskCardMedium"
                TargetType="Border">
            <Setter Property="Background"
                    Value="#FFF8E1"/>
            <Setter Property="CornerRadius"
                    Value="6"/>
            <Setter Property="BorderBrush"
                    Value="#F39C12"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>

        <!-- 风险卡片样式 - Low -->
        <Style x:Key="RiskCardLow"
                TargetType="Border">
            <Setter Property="Background"
                    Value="#E8F5E9"/>
            <Setter Property="CornerRadius"
                    Value="6"/>
            <Setter Property="BorderBrush"
                    Value="#27AE60"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题区域 -->
        <Border Grid.Row="0"
                Background="#2C3E50"
                CornerRadius="8"
                Padding="20,15"
                Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="🔒 Agent安全扫描器"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="White"/>
                <TextBlock Text="AI智能体全生命周期安全检测 · 三阶段扫描引擎"
                        FontSize="13"
                        Foreground="#BDC3C7"
                        Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- 目标输入区域 -->
        <GroupBox Grid.Row="1"
                Header="目标输入区"
                Style="{StaticResource StyledGroupBox}"
                Margin="0,0,0,10"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 目标模式选择 -->
                <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,10">
                    <RadioButton x:Name="FileModeRadio"
                            Content="文件"
                            IsChecked="True"
                            GroupName="TargetMode"
                            Margin="0,0,15,0"
                            FontWeight="SemiBold"/>
                    <RadioButton x:Name="DirectoryModeRadio"
                            Content="目录"
                            GroupName="TargetMode"
                            Margin="0,0,15,0"
                            FontWeight="SemiBold"/>
                    <RadioButton x:Name="ConfigModeRadio"
                            Content="配置导入"
                            GroupName="TargetMode"
                            Margin="0,0,15,0"
                            FontWeight="SemiBold"/>
                    <RadioButton x:Name="TextModeRadio"
                            Content="文本粘贴"
                            GroupName="TargetMode"
                            FontWeight="SemiBold"/>
                </StackPanel>

                <!-- 目标路径输入 -->
                <Grid Grid.Row="1"
                        Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TargetPathTextBox"
                            Grid.Column="0"
                            Padding="8,10"
                            FontSize="13"
                             Text="请输入目标路径或粘贴内容..."
                            Foreground="Gray"
                             AcceptsReturn="True"
                            TextWrapping="Wrap"
                            MaxHeight="80"
                             VerticalScrollBarVisibility="Auto"
                             GotFocus="TargetPathTextBox_GotFocus"
                            LostFocus="TargetPathTextBox_LostFocus"/>
                    <Button x:Name="BrowseButton"
                            Grid.Column="1"
                            Content="浏览"
                            Padding="25,10"
                            Margin="10,0,0,0"
                            Click="Browse_Click"
                            Background="#3498DB"
                            Foreground="White"
                            FontWeight="Bold"/>
                </Grid>

                <!-- 目标配置选项 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="0,0,30,0">
                        <TextBlock Text="目标类型:"
                                VerticalAlignment="Center"
                                Foreground="#7F8C8D"
                                Margin="0,0,8,0"
                                FontWeight="SemiBold"/>
                        <ComboBox x:Name="TargetTypeComboBox"
                                Width="150"
                                Padding="5"
                                FontSize="12">
                            <ComboBoxItem Content="自动识别"
                                    IsSelected="True"/>
                            <ComboBoxItem Content="Python Agent"/>
                            <ComboBoxItem Content="JavaScript Agent"/>
                            <ComboBoxItem Content="LangChain Agent"/>
                            <ComboBoxItem Content="AutoGen Agent"/>
                            <ComboBoxItem Content="Custom Agent"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                        <TextBlock Text="深度:"
                                VerticalAlignment="Center"
                                Foreground="#7F8C8D"
                                Margin="0,0,8,0"
                                FontWeight="SemiBold"/>
                        <ComboBox x:Name="ScanDepthComboBox"
                                Width="150"
                                Padding="5"
                                FontSize="12">
                            <ComboBoxItem Content="标准扫描"
                                    IsSelected="True"/>
                            <ComboBoxItem Content="快速扫描"/>
                            <ComboBoxItem Content="深度扫描"/>
                            <ComboBoxItem Content="全面扫描"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- 扫描配置区域 -->
        <GroupBox Grid.Row="2"
                Header="扫描配置区"
                Style="{StaticResource StyledGroupBox}"
                Margin="0,0,0,10"
                Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 扫描模块选择 -->
                <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Margin="0,0,0,12">
                    <CheckBox x:Name="StaticAnalysisCheck"
                            Content="静态分析"
                            IsChecked="True"
                            Margin="0,0,20,0"
                            FontWeight="SemiBold"
                            Foreground="#2C3E50"/>
                    <CheckBox x:Name="IntentAnalysisCheck"
                            Content="意图研判"
                            IsChecked="True"
                            Margin="0,0,20,0"
                            FontWeight="SemiBold"
                            Foreground="#2C3E50"/>
                    <CheckBox x:Name="BehaviorSandboxCheck"
                            Content="行为沙箱"
                            IsChecked="True"
                            Margin="0,0,20,0"
                            FontWeight="SemiBold"
                            Foreground="#2C3E50"/>
                    <CheckBox x:Name="DependencyCheck"
                            Content="依赖检查"
                            IsChecked="True"
                            FontWeight="SemiBold"
                            Foreground="#2C3E50"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Row="1"
                        Orientation="Horizontal">
                    <Button x:Name="StartScanButton"
                            Content="▶ 开始扫描"
                            Padding="30,12"
                            Click="StartScan_Click"
                            Background="#27AE60"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"/>
                    <Button x:Name="StopScanButton"
                            Content="⏹ 停止"
                            Padding="25,12"
                            Margin="15,0,0,0"
                            Click="StopScan_Click"
                            IsEnabled="False"
                            Background="#E74C3C"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"/>
                    <Button x:Name="ExportReportButton"
                            Content="📋 导出报告 ▼"
                            Padding="25,12"
                            Margin="15,0,0,0"
                            Click="ExportReport_Click"
                            IsEnabled="False"
                            Background="#3498DB"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 进度条区域 -->
        <Border Grid.Row="3"
                Background="#F8F9FA"
                BorderBrush="#E9ECEF"
                BorderThickness="1"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,10">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ScanStatusText"
                            Text="状态: 就绪"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="#2C3E50"/>
                    <TextBlock x:Name="ScanProgressText"
                            Text="0%"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Foreground="#27AE60"
                            FontSize="14"/>
                </Grid>
                <ProgressBar x:Name="ScanProgressBar"
                        Height="25"
                        Minimum="0"
                        Maximum="100"
                        Value="0"
                             Foreground="#27AE60"
                        Background="#E9ECEF"/>

                <!-- 统计信息 -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TotalFoundText"
                            Text="已发现: 0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="#2C3E50"
                            Margin="0,0,15,0"/>
                    <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,0,15,0">
                        <Ellipse Width="10"
                                Height="10"
                                Fill="#C0392B"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="超危:"
                                VerticalAlignment="Center"
                                Margin="0,0,3,0"/>
                        <TextBlock x:Name="CriticalCountText"
                                Text="0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="#C0392B"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Margin="0,0,15,0">
                        <Ellipse Width="10"
                                Height="10"
                                Fill="#E67E22"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="高危:"
                                VerticalAlignment="Center"
                                Margin="0,0,3,0"/>
                        <TextBlock x:Name="HighCountText"
                                Text="0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="#E67E22"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            Margin="0,0,15,0">
                        <Ellipse Width="10"
                                Height="10"
                                Fill="#F39C12"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="中危:"
                                VerticalAlignment="Center"
                                Margin="0,0,3,0"/>
                        <TextBlock x:Name="MediumCountText"
                                Text="0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="#F39C12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4"
                            Orientation="Horizontal"
                            Margin="0,0,15,0">
                        <Ellipse Width="10"
                                Height="10"
                                Fill="#27AE60"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"/>
                        <TextBlock Text="低危:"
                                VerticalAlignment="Center"
                                Margin="0,0,3,0"/>
                        <TextBlock x:Name="LowCountText"
                                Text="0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="#27AE60"/>
                    </StackPanel>
                    <TextBlock x:Name="CurrentPhaseText"
                            Text=""
                            Grid.Column="6"
                            VerticalAlignment="Center"
                            FontStyle="Italic"
                            Foreground="#7F8C8D"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Tab结果展示区域 -->
        <TabControl Grid.Row="4"
                x:Name="ResultTab"
                SelectionChanged="ResultTab_SelectionChanged">

            <!-- Tab 1: 概览仪表盘 -->
            <TabItem Header="概览">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：六层攻击面热力图 -->
                        <Border Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                BorderBrush="#BDC3C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="White"
                                Margin="0,0,10,0">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0"
                                        Text="六层攻击面热力图"
                                        FontWeight="Bold"
                                        FontSize="14"
                                        Foreground="#2C3E50"
                                        Margin="0,0,0,15"/>
                                <StackPanel Grid.Row="1">
                                    <!-- 攻击面层 -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                Text="提示词注入层"
                                                FontSize="11"
                                                VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1"
                                                Height="18"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="0"
                                                x:Name="LayerPromptInjection"
                                                Foreground="#E74C3C"/>
                                        <TextBlock Grid.Column="2"
                                                x:Name="LayerPromptCount1"
                                                Text="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Bold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                Text="角色劫持层"
                                                FontSize="11"
                                                VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1"
                                                Height="18"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="0"
                                                x:Name="LayerRoleHijack"
                                                Foreground="#E67E22"/>
                                        <TextBlock Grid.Column="2"
                                                x:Name="LayerPromptCount2"
                                                Text="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Bold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                Text="上下文操纵层"
                                                FontSize="11"
                                                VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1"
                                                Height="18"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="0"
                                                x:Name="LayerContextManipulation"
                                                Foreground="#F39C12"/>
                                        <TextBlock Grid.Column="2"
                                                x:Name="LayerPromptCount3"
                                                Text="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Bold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                Text="工具滥用层"
                                                FontSize="11"
                                                VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1"
                                                Height="18"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="0"
                                                x:Name="LayerToolAbuse"
                                                Foreground="#3498DB"/>
                                        <TextBlock Grid.Column="2"
                                                x:Name="LayerPromptCount4"
                                                Text="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Bold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                Text="数据泄露层"
                                                FontSize="11"
                                                VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1"
                                                Height="18"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="0"
                                                x:Name="LayerDataLeakage"
                                                Foreground="#9B59B6"/>
                                        <TextBlock Grid.Column="2"
                                                x:Name="LayerPromptCount5"
                                                Text="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Bold"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                Text="供应链攻击层"
                                                FontSize="11"
                                                VerticalAlignment="Center"/>
                                        <ProgressBar Grid.Column="1"
                                                Height="18"
                                                Minimum="0"
                                                Maximum="100"
                                                Value="0"
                                                x:Name="LayerSupplyChain"
                                                Foreground="#1ABC9C"/>
                                        <TextBlock Grid.Column="2"
                                                x:Name="LayerPromptCount6"
                                                Text="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Bold"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 右侧上部：风险统计卡片网格 -->
                        <Grid Grid.Row="0"
                                Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 总漏洞数 -->
                            <Border Grid.Column="0"
                                    Grid.Row="0"
                                    Background="#EBF5FB"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,8,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="总漏洞数"
                                            FontSize="12"
                                            Foreground="#2980B9"
                                            HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DashboardTotalVulns"
                                            Text="0"
                                            FontSize="32"
                                            FontWeight="Bold"
                                            Foreground="#2C3E50"
                                            HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 超危数 -->
                            <Border Grid.Column="1"
                                    Grid.Row="0"
                                    Background="#FDECEC"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,8,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="超危 (Critical)"
                                            FontSize="12"
                                            Foreground="#C0392B"
                                            HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DashboardCriticalVulns"
                                            Text="0"
                                            FontSize="32"
                                            FontWeight="Bold"
                                            Foreground="#C0392B"
                                            HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 高危数 -->
                            <Border Grid.Column="2"
                                    Grid.Row="0"
                                    Background="#FEF0E6"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,0,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="高危 (High)"
                                            FontSize="12"
                                            Foreground="#E67E22"
                                            HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DashboardHighVulns"
                                            Text="0"
                                            FontSize="32"
                                            FontWeight="Bold"
                                            Foreground="#E67E22"
                                            HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 中危数 -->
                            <Border Grid.Column="0"
                                    Grid.Row="1"
                                    Background="#FFF8E1"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="中危 (Medium)"
                                            FontSize="12"
                                            Foreground="#F39C12"
                                            HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DashboardMediumVulns"
                                            Text="0"
                                            FontSize="32"
                                            FontWeight="Bold"
                                            Foreground="#F39C12"
                                            HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 低危数 -->
                            <Border Grid.Column="1"
                                    Grid.Row="1"
                                    Background="#E8F5E9"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,8,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="低危 (Low)"
                                            FontSize="12"
                                            Foreground="#27AE60"
                                            HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DashboardLowVulns"
                                            Text="0"
                                            FontSize="32"
                                            FontWeight="Bold"
                                            Foreground="#27AE60"
                                            HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- 安全评分 -->
                            <Border Grid.Column="2"
                                    Grid.Row="1"
                                    Background="#E8F8F5"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="安全评分"
                                            FontSize="12"
                                            Foreground="#16A085"
                                            HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="DashboardSecurityScore"
                                            Text="--"
                                            FontSize="28"
                                            FontWeight="Bold"
                                            Foreground="#16A085"
                                            HorizontalAlignment="Center"/>
                                    <TextBlock Text="(0-100)"
                                            FontSize="10"
                                            Foreground="#7F8C8D"
                                            HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 右侧下部：Top 10 问题列表 -->
                        <Border Grid.Row="1"
                                Grid.Column="1"
                                BorderBrush="#BDC3C7"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="White"
                                Margin="8,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="#ECF0F1"
                                        Padding="10,6"
                                        CornerRadius="6,6,0,0">
                                    <TextBlock Text="Top 10 最严重问题"
                                            FontWeight="Bold"
                                            FontSize="13"
                                            Foreground="#2C3E50"/>
                                </Border>
                                <ListBox x:Name="TopIssuesListBox"
                                        Grid.Row="1"
                                        BorderThickness="0"
                                        FontSize="12"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="5,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                        Text="{Binding Index}"
                                                        FontWeight="Bold"
                                                        Foreground="#7F8C8D"
                                                        VerticalAlignment="Top"/>
                                                <StackPanel Grid.Column="1"
                                                        Margin="5,0,0,0">
                                                    <TextBlock Text="{Binding Title}"
                                                            FontWeight="SemiBold"
                                                            TextTrimming="CharacterEllipsis"
                                                            MaxWidth="400"/>
                                                    <TextBlock Text="{Binding LevelText}"
                                                            FontSize="11"
                                                            Foreground="{Binding LevelColor}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- 底部：扫描摘要信息 -->
                        <Border Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Background="#F8F9FA"
                                BorderBrush="#E9ECEF"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        Margin="0,0,25,0">
                                    <TextBlock Text="目标路径:"
                                            Foreground="#7F8C8D"
                                            FontWeight="SemiBold"
                                            Margin="0,0,5,0"/>
                                    <TextBlock x:Name="SummaryTargetPath"
                                            Text="-"
                                            FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="0,0,25,0">
                                    <TextBlock Text="Agent类型:"
                                            Foreground="#7F8C8D"
                                            FontWeight="SemiBold"
                                            Margin="0,0,5,0"/>
                                    <TextBlock x:Name="SummaryAgentType"
                                            Text="-"
                                            FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Margin="0,0,25,0">
                                    <TextBlock Text="耗时:"
                                            Foreground="#7F8C8D"
                                            FontWeight="SemiBold"
                                            Margin="0,0,5,0"/>
                                    <TextBlock x:Name="SummaryDuration"
                                            Text="-"
                                            FontWeight="SemiBold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3"
                                        Orientation="Horizontal">
                                    <TextBlock Text="扫描时间:"
                                            Foreground="#7F8C8D"
                                            FontWeight="SemiBold"
                                            Margin="0,0,5,0"/>
                                    <TextBlock x:Name="SummaryScanTime"
                                            Text="-"
                                            FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 静态分析结果 -->
            <TabItem Header="静态分析">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 工具栏 -->
                    <Border Grid.Row="0"
                            Background="#F8F9FA"
                            BorderBrush="#E9ECEF"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="筛选:"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    FontWeight="SemiBold"/>
                            <ComboBox x:Name="StaticLevelFilter"
                                    Grid.Column="1"
                                    Width="110"
                                    Padding="5"
                                    FontSize="12">
                                <ComboBoxItem Content="全部等级"
                                        IsSelected="True"/>
                                <ComboBoxItem Content="Critical"/>
                                <ComboBoxItem Content="High"/>
                                <ComboBoxItem Content="Medium"/>
                                <ComboBoxItem Content="Low"/>
                                <ComboBoxItem Content="Info"/>
                            </ComboBox>
                            <ComboBox x:Name="StaticTypeFilter"
                                    Grid.Column="2"
                                    Width="150"
                                    Padding="5"
                                    FontSize="12"
                                    Margin="10,0,0,0">
                                <ComboBoxItem Content="全部类型"
                                        IsSelected="True"/>
                                <ComboBoxItem Content="硬编码密钥"/>
                                <ComboBoxItem Content="不安全API调用"/>
                                <ComboBoxItem Content="权限过度申请"/>
                                <ComboBoxItem Content="注入风险"/>
                                <ComboBoxItem Content="其他"/>
                            </ComboBox>
                            <TextBox x:Name="StaticSearchBox"
                                    Grid.Column="3"
                                    Width="250"
                                    Padding="6,8"
                                    FontSize="12"
                                     Text="搜索..."
                                    Foreground="Gray"
                                    Margin="10,0,0,0"
                                     GotFocus="SearchBox_GotFocus"
                                    LostFocus="SearchBox_LostFocus"/>
                            <TextBlock x:Name="StaticResultCount"
                                    Grid.Column="4"
                                    Text="结果: 0"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="#2C3E50"
                                    Margin="15,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid x:Name="StaticAnalysisDataGrid"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                              IsReadOnly="True"
                            AlternatingRowBackground="#F8F9FA"
                              GridLinesVisibility="Horizontal"
                            BorderThickness="1"
                            BorderBrush="#E9ECEF"
                              HeadersVisibility="Column"
                            CanUserAddRows="False"
                              CanUserDeleteRows="False"
                            CanUserResizeRows="False"
                              MouseDoubleClick="StaticAnalysisDataGrid_MouseDoubleClick">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                    BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell"
                                    BasedOn="{StaticResource DataGridCellStyle}"/>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="文件路径"
                                    Binding="{Binding FileLocation}"
                                    Width="*"/>
                            <DataGridTextColumn Header="行号"
                                    Binding="{Binding LineNumber}"
                                    Width="70"/>
                            <DataGridTextColumn Header="风险类型"
                                    Binding="{Binding Category}"
                                    Width="140"/>
                            <DataGridTextColumn Header="等级"
                                    Binding="{Binding RiskLevel}"
                                    Width="90"/>
                            <DataGridTextColumn Header="详情预览"
                                    Binding="{Binding Preview}"
                                    Width="300"/>
                            <DataGridTemplateColumn Header="操作"
                                    Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="查看"
                                                Padding="8,4"
                                                Background="#3498DB"
                                                Foreground="White"
                                                FontSize="11"
                                                Click="StaticViewDetail_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Tab 3: 意图研判结果 -->
            <TabItem Header="意图研判">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto">
                    <WrapPanel x:Name="IntentCardsPanel"
                            Margin="10"
                            ItemWidth="420"
                            MinWidth="400">
                        <!-- 动态生成风险卡片 -->
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: 行为检测结果 -->
            <TabItem Header="行为检测">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- DataGrid -->
                    <DataGrid x:Name="BehaviorDataGrid"
                            Grid.Row="0"
                            AutoGenerateColumns="False"
                              IsReadOnly="True"
                            AlternatingRowBackground="#F8F9FA"
                              GridLinesVisibility="Horizontal"
                            BorderThickness="1"
                            BorderBrush="#E9ECEF"
                              HeadersVisibility="Column"
                            CanUserAddRows="False"
                              CanUserDeleteRows="False"
                            CanUserResizeRows="False"
                              SelectionChanged="BehaviorDataGrid_SelectionChanged">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader"
                                    BasedOn="{StaticResource DataGridColumnHeaderStyle}"/>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell"
                                    BasedOn="{StaticResource DataGridCellStyle}"/>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="CVE编号"
                                    Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CveId}"
                                                Foreground="#3498DB"
                                                TextDecorations="Underline"
                                                   Cursor="Hand"
                                                MouseLeftButtonDown="CveId_MouseLeftButtonDown"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="漏洞标题"
                                    Binding="{Binding Title}"
                                    Width="*"/>
                            <DataGridTemplateColumn Header="CVSS评分"
                                    Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="35"/>
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0"
                                                    Height="16"
                                                    Minimum="0"
                                                    Maximum="10"
                                                    Value="{Binding CvssScore}"
                                                         Foreground="{Binding CvssColor}"
                                                    Background="#E9ECEF"/>
                                            <TextBlock Grid.Column="1"
                                                    Text="{Binding CvssScore}"
                                                    FontSize="11"
                                                    FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="危害等级"
                                    Binding="{Binding RiskLevel}"
                                    Width="90"/>
                            <DataGridTextColumn Header="影响组件"
                                    Binding="{Binding AffectedComponent}"
                                    Width="140"/>
                            <DataGridTextColumn Header="利用条件"
                                    Binding="{Binding Condition}"
                                    Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 详细信息面板 -->
                    <Border Grid.Row="1"
                            Background="#F8F9FA"
                            BorderBrush="#E9ECEF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,10,0,0"
                            Visibility="Collapsed"
                            x:Name="BehaviorDetailPanel">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                    x:Name="BehaviorDetailTitle"
                                    Text=""
                                    FontWeight="Bold"
                                    FontSize="14"
                                    Foreground="#2C3E50"
                                    Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1"
                                    x:Name="BehaviorDetailDesc"
                                    Text=""
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="#555"
                                    Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2"
                                    x:Name="BehaviorDetailFix"
                                    Text=""
                                    TextWrapping="Wrap"
                                    FontSize="12"
                                    Foreground="#27AE60"
                                    Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3"
                                    x:Name="BehaviorDetailRef"
                                    Text=""
                                    FontSize="11"
                                    Foreground="#3498DB"
                                    TextDecorations="Underline"
                                    Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Tab 5: 修复建议 -->
            <TabItem Header="修复建议">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 统计和操作栏 -->
                    <Border Grid.Row="0"
                            Background="#F8F9FA"
                            BorderBrush="#E9ECEF"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    Margin="0,0,25,0">
                                <TextBlock Text="待修复:"
                                        FontWeight="Bold"
                                        Foreground="#E74C3C"
                                        FontSize="13"/>
                                <TextBlock x:Name="RemediationPendingCount"
                                        Text="0"
                                        FontWeight="Bold"
                                        Foreground="#E74C3C"
                                        FontSize="13"
                                        Margin="5,0,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="0,0,25,0">
                                <TextBlock Text="已知晓:"
                                        FontWeight="Bold"
                                        Foreground="#95A5A6"
                                        FontSize="13"/>
                                <TextBlock x:Name="RemediationAcknowledgedCount"
                                        Text="0"
                                        FontWeight="Bold"
                                        Foreground="#95A5A6"
                                        FontSize="13"
                                        Margin="5,0,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="3"
                                    Content="一键导出修复清单"
                                    Padding="20,10"
                                    Background="#27AE60"
                                    Foreground="White"
                                    FontWeight="Bold"
                                    Click="ExportRemediationList_Click"/>
                        </Grid>
                    </Border>

                    <!-- 修复建议列表 -->
                    <ScrollViewer Grid.Row="1"
                            VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="RemediationListPanel">
                            <!-- 动态生成修复项 -->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 底部状态栏 -->
        <Border Grid.Row="5"
                Background="#F8F9FA"
                BorderBrush="#E9ECEF"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                        x:Name="StatusBarStatus"
                        Text="状态: 就绪"
                        FontWeight="SemiBold"
                        Foreground="#2C3E50"
                        Margin="0,0,25,0"/>
                <TextBlock Grid.Column="1"
                        x:Name="StatusBarDuration"
                        Text="扫描用时: --"
                        Foreground="#7F8C8D"
                        Margin="0,0,25,0"/>
                <TextBlock Grid.Column="2"
                        x:Name="StatusBarLastUpdate"
                        Text="最后更新: --"
                        Foreground="#7F8C8D"/>
            </Grid>
        </Border>
    </Grid>
</Window>