<Window x:Class="NetSecurityScanner.Desktop.Views.ComprehensiveScanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="开始综合扫描" Width="720" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <Border Grid.Row="0" CornerRadius="0,0,8,8" Padding="20,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2C3E50" Offset="0"/>
                    <GradientStop Color="#3498DB" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel>
                <TextBlock Text="🛡️ 综合扫描配置" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="配置目标与扫描参数，全面安全检测" FontSize="11" Foreground="#BDC3C7" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主体: 左右分栏 -->
        <Grid Grid.Row="1" Margin="16,12,16,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧: 配置项 -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,12,0">
                <StackPanel>
                    <!-- 目标 IP -->
                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Background="White">
                        <StackPanel>
                            <TextBlock Text="🎯 目标地址" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,6"/>
                            <TextBox x:Name="TargetIpTextBox" Text="127.0.0.1" FontSize="13" Padding="6,4" BorderBrush="#BDC3C7" BorderThickness="1"/>
                            <TextBlock x:Name="IpErrorTextBlock" Text="" FontSize="11" Foreground="#E74C3C" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <TextBlock Text="支持 IPv4（如 192.168.1.1）或域名（如 example.com）" FontSize="10" Foreground="#95A5A6" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 扫描预设 -->
                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Background="White">
                        <StackPanel>
                            <TextBlock Text="📋 扫描预设" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,6"/>
                            <ComboBox x:Name="PresetCombo" Height="30" FontSize="13" SelectionChanged="PresetCombo_SelectionChanged">
                                <ComboBoxItem Content="⚡ Quick  -  Top-100 常用端口" Tag="Quick" IsSelected="True"/>
                                <ComboBoxItem Content="🔧 Standard  -  1-1000（默认）" Tag="Standard"/>
                                <ComboBoxItem Content="🌊 Deep  -  1-65535 全端口" Tag="Deep"/>
                                <ComboBoxItem Content="🌐 Web  -  HTTP/HTTPS 服务" Tag="Web"/>
                                <ComboBoxItem Content="🗄 Database  -  数据库服务" Tag="Database"/>
                                <ComboBoxItem Content="✏ Custom  -  自定义端口" Tag="Custom"/>
                            </ComboBox>
                            <TextBlock x:Name="PresetHintText" Text="" FontSize="10" Foreground="#7F8C8D" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- 端口范围（仅 Custom 可编辑） -->
                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Background="White">
                        <StackPanel>
                            <TextBlock Text="🔌 端口范围" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,6"/>
                            <TextBox x:Name="PortRangeTextBox" Text="1-1000" FontSize="13" Padding="6,4" IsEnabled="False"
                                     BorderBrush="#BDC3C7" BorderThickness="1"/>
                            <TextBlock x:Name="PortErrorTextBlock" Text="" FontSize="11" Foreground="#E74C3C" Margin="0,4,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
                            <TextBlock Text="格式：1-1000 / 22,80,443 / 1-100,443,8080-8090" FontSize="10" Foreground="#95A5A6" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 扫描协议 + 高级选项 -->
                    <Border BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10" Background="White">
                        <StackPanel>
                            <TextBlock Text="📡 扫描协议" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="TcpCheckBox" IsChecked="True" Content="TCP" Margin="0,0,16,0" FontWeight="SemiBold"/>
                                <CheckBox x:Name="UdpCheckBox" IsChecked="True" Content="UDP" Margin="0,0,16,0" FontWeight="SemiBold"/>
                                <CheckBox x:Name="VulnScanCheckBox" IsChecked="True" Content="漏洞扫描" Margin="0,0,16,0"/>
                                <CheckBox x:Name="PluginScanCheckBox" IsChecked="True" Content="插件扫描"/>
                            </StackPanel>
                            <TextBlock x:Name="ProtocolErrorTextBlock" Text="" FontSize="11" Foreground="#E74C3C" Margin="0,4,0,0" Visibility="Collapsed"/>

                            <Border BorderBrush="#DDE1E7" BorderThickness="0,1,0,0" Margin="0,10,0,10"/>

                            <TextBlock Text="⚙ 高级选项" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="并发线程" FontSize="11" Foreground="#7F8C8D"/>
                                    <TextBox x:Name="ConcurrencyTextBox" Text="200" FontSize="12" Padding="4,3" BorderBrush="#BDC3C7"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0">
                                    <TextBlock Text="超时(秒)" FontSize="11" Foreground="#7F8C8D"/>
                                    <TextBox x:Name="TimeoutTextBox" Text="5" FontSize="12" Padding="4,3" BorderBrush="#BDC3C7"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                    <TextBlock Text="重试次数" FontSize="11" Foreground="#7F8C8D"/>
                                    <TextBox x:Name="RetryTextBox" Text="1" FontSize="12" Padding="4,3" BorderBrush="#BDC3C7"/>
                                </StackPanel>
                            </Grid>
                            <CheckBox x:Name="SaveHistoryCheckBox" IsChecked="True" Content="保存到历史记录" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 右侧: 实时预览 -->
            <Border Grid.Column="1" Background="White" BorderBrush="#DDE1E7" BorderThickness="1" CornerRadius="6" Padding="12">
                <StackPanel>
                    <TextBlock Text="📊 实时预览" FontWeight="Bold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,8"/>
                    <TextBlock x:Name="PreviewPortCountText" Text="1000 个端口" FontSize="12" Foreground="#2C3E50"/>
                    <TextBlock x:Name="PreviewDurationText" Text="预计耗时 ~25 秒" FontSize="11" Foreground="#7F8C8D" Margin="0,2,0,0"/>

                    <Border BorderBrush="#DDE1E7" BorderThickness="0,1,0,0" Margin="0,10,0,10"/>

                    <TextBlock Text="📜 最近同目标扫描" FontWeight="Bold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,6"/>
                    <TextBlock x:Name="LastHistoryText" Text="（暂无历史）" FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap"/>

                    <Border BorderBrush="#DDE1E7" BorderThickness="0,1,0,0" Margin="0,10,0,10"/>

                    <TextBlock Text="💡 提示" FontWeight="Bold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,6"/>
                    <TextBlock FontSize="10" Foreground="#7F8C8D" TextWrapping="Wrap" LineHeight="14">
                        <Run Text="• 选 Quick 跑得最快"/><LineBreak/>
                        <Run Text="• 选 Deep 会扫全部 65535 端口，建议提高并发数"/><LineBreak/>
                        <Run Text="• TCP+UDP 漏洞+插件 都勾选可获得最完整结果"/><LineBreak/>
                        <Run Text="• 自定义端口支持混合格式（1-100,443）"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部按钮 -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="20,12" Background="White">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StartButton" Content="🚀 开始扫描"
                        Click="StartButton_Click" Background="#27AE60" Foreground="White"
                        FontWeight="Bold" FontSize="13" Margin="0,0,10,0" Padding="18,8"/>
                <Button Content="取消" IsCancel="True"
                        Background="#95A5A6" Foreground="White" FontWeight="Bold" FontSize="13" Padding="18,8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
