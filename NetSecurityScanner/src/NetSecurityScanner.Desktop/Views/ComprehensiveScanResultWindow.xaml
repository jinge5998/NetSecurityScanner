<Window x:Class="NetSecurityScanner.Views.ComprehensiveScanResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🛡️ 综合扫描结果" Height="680" Width="980"
        WindowStartupLocation="CenterOwner"
        Background="#F5F6FA">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#16A085" Offset="0"/>
                    <GradientStop Color="#2C3E50" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleText" Text="综合扫描结果" FontSize="17" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="SubtitleText" Text="" FontSize="11" Foreground="#DDE1E7" Margin="0,4,0,0"/>
                </StackPanel>
                <Border x:Name="RiskBadge" Grid.Column="1" CornerRadius="12" Padding="14,6"
                        Background="#27AE60" VerticalAlignment="Center">
                    <TextBlock x:Name="RiskBadgeText" Text="无风险" Foreground="White" FontWeight="Bold" FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <!-- 5 个 Tab -->
        <Border Grid.Row="1" Background="White" BorderBrush="#DDE1E7" BorderThickness="1" CornerRadius="6">
            <TabControl x:Name="ResultTabControl" BorderThickness="0" Background="Transparent" Padding="8">
                <!-- Tab 1: 概览 -->
                <TabItem Header="📊 概览">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="OverviewPanel" Margin="12"/>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 2: 端口 -->
                <TabItem Header="🔌 端口">
                    <DataGrid x:Name="PortsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FA" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="端口" Binding="{Binding PortNumber}" Width="80"/>
                            <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="80"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="服务" Binding="{Binding Service}" Width="160"/>
                            <DataGridTextColumn Header="版本" Binding="{Binding ServiceVersion}" Width="160"/>
                            <DataGridTextColumn Header="响应耗时" Binding="{Binding ResponseTimeMs, StringFormat={}{0} ms}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Tab 3: 漏洞 -->
                <TabItem Header="🛡️ 漏洞">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,6">
                            <TextBlock Text="按风险筛选:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                            <ComboBox x:Name="VulnFilterCombo" Width="140" SelectionChanged="VulnFilterCombo_SelectionChanged">
                                <ComboBoxItem Content="全部" Tag="" IsSelected="True"/>
                                <ComboBoxItem Content="严重" Tag="严重"/>
                                <ComboBoxItem Content="高" Tag="高"/>
                                <ComboBoxItem Content="中" Tag="中"/>
                                <ComboBoxItem Content="低" Tag="低"/>
                            </ComboBox>
                            <TextBlock x:Name="VulnCountText" Text="" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#7F8C8D"/>
                        </StackPanel>
                        <DataGrid x:Name="VulnsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  AlternatingRowBackground="#F8F9FA" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding VulnerabilityName}" Width="180"/>
                                <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" Width="80"/>
                                <DataGridTextColumn Header="CVE" Binding="{Binding CVE}" Width="120"/>
                                <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="70"/>
                                <DataGridTextColumn Header="描述" Binding="{Binding Description}" Width="280"/>
                                <DataGridTextColumn Header="修复建议" Binding="{Binding Remediation}" Width="220"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <!-- Tab 4: 服务 -->
                <TabItem Header="🧬 服务">
                    <DataGrid x:Name="ServicesDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FA" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="服务名" Binding="{Binding Service}" Width="160"/>
                            <DataGridTextColumn Header="端口数" Binding="{Binding Count}" Width="80"/>
                            <DataGridTextColumn Header="端口列表" Binding="{Binding Ports}" Width="260"/>
                            <DataGridTextColumn Header="版本" Binding="{Binding Versions}" Width="320"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <!-- Tab 5: 插件 -->
                <TabItem Header="🧩 插件">
                    <DataGrid x:Name="PluginsDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal"
                              AlternatingRowBackground="#F8F9FA" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="插件名" Binding="{Binding PluginName}" Width="160"/>
                            <DataGridTextColumn Header="端口" Binding="{Binding Port}" Width="70"/>
                            <DataGridTextColumn Header="风险" Binding="{Binding RiskLevel}" Width="80"/>
                            <DataGridTextColumn Header="标题" Binding="{Binding Title}" Width="220"/>
                            <DataGridTextColumn Header="输出" Binding="{Binding Output}" Width="320"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- 底部工具栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ExportJsonButton" Content="📤 导出 JSON" Width="120" Height="32" Margin="4,0"
                    Background="#3498DB" Foreground="White" FontWeight="SemiBold" Click="ExportJsonButton_Click"/>
            <Button x:Name="ExportCsvButton" Content="📊 导出 CSV" Width="120" Height="32" Margin="4,0"
                    Background="#3498DB" Foreground="White" FontWeight="SemiBold" Click="ExportCsvButton_Click"/>
            <Button x:Name="CompareButton" Content="📈 对比历史" Width="120" Height="32" Margin="4,0"
                    Background="#9B59B6" Foreground="White" FontWeight="SemiBold" Click="CompareButton_Click"/>
            <Button x:Name="CopyMarkdownButton" Content="📋 复制 Markdown" Width="130" Height="32" Margin="4,0"
                    Background="#16A085" Foreground="White" FontWeight="SemiBold" Click="CopyMarkdownButton_Click"/>
            <Button x:Name="CloseButton" Content="❌ 关闭" Width="100" Height="32" Margin="4,0"
                    Background="#95A5A6" Foreground="White" FontWeight="SemiBold" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
