<Window x:Class="NetSecurityScanner.Views.BatchInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Name="MessageText" 
                  FontSize="14" Foreground="#2C3E50" 
                  Margin="0,0,0,10" TextWrapping="Wrap"/>

        <TextBox Grid.Row="1" Name="InputTextBox" 
                FontSize="13" Padding="8" 
                AcceptsReturn="True" TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                BorderBrush="#BDC3C7" BorderThickness="1"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" 
                   HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="OkButton" Content="确定" Click="Ok_Click" 
                   MinWidth="80" Margin="0,0,10,0" 
                   Background="#3498DB" Foreground="White"
                   BorderThickness="0" Padding="15,8" Cursor="Hand"/>
            <Button Name="CancelButton" Content="取消" Click="Cancel_Click" 
                   MinWidth="80" 
                   Background="#95A5A6" Foreground="White"
                   BorderThickness="0" Padding="15,8" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
