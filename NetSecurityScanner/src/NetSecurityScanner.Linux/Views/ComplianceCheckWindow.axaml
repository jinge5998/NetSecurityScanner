<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NetSecurityScanner.Views.ComplianceCheckWindow"
        Title="合规性检查" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0" Background="#2d3436" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="合规性检查" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="等保2.0 / CIS基线合规性检查" FontSize="13" Foreground="#b2bec3" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
        
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Grid.Column="0" Text="目标:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
            <TextBox Grid.Column="1" Name="TargetTextBox" Height="35" FontSize="14" Padding="10,5" 
                     Text="127.0.0.1"/>
            
            <ComboBox Grid.Column="2" Name="CheckTypeComboBox" Width="180" Height="35" Margin="10,0">
                <ComboBoxItem Content="全部检查" IsSelected="True"/>
                <ComboBoxItem Content="等保2.0"/>
                <ComboBoxItem Content="CIS基线"/>
            </ComboBox>
            
            <Button Grid.Column="3" Name="StartCheckButton" Content="开始检查" Width="120" Height="40" 
                    Background="#00b894" Foreground="White" FontWeight="Bold"/>
        </Grid>
        
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" BorderBrush="#dfe6e9" BorderThickness="1" CornerRadius="8" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="#f8f9fa" Padding="12" CornerRadius="8,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="检查结果" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Name="ResultCountTextBlock" Text="(0)" Margin="10,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                    
                    <DataGrid Grid.Row="1" Name="ResultsDataGrid" AutoGenerateColumns="False" 
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="检查ID" Binding="{Binding CheckId}" Width="100"/>
                            <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="检查项" Binding="{Binding Item}" Width="*"/>
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Background="#667eea" 
                        CornerRadius="8" Padding="20" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="合规评分" FontSize="14" Foreground="White" Opacity="0.9"/>
                        <TextBlock Name="ComplianceScoreText" Text="--" FontSize="48" FontWeight="Bold" 
                                   Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Name="ScoreDescriptionText" Text="未检查" FontSize="12" 
                                   Foreground="White" Opacity="0.8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Grid.Column="0" Background="#00b894" CornerRadius="8" 
                            Padding="15" Margin="0,0,5,5">
                        <StackPanel>
                            <TextBlock Text="通过" FontSize="12" Foreground="White" Opacity="0.9"/>
                            <TextBlock Name="PassCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Row="0" Grid.Column="1" Background="#e74c3c" CornerRadius="8" 
                            Padding="15" Margin="5,0,0,5">
                        <StackPanel>
                            <TextBlock Text="失败" FontSize="12" Foreground="White" Opacity="0.9"/>
                            <TextBlock Name="FailCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Row="1" Grid.Column="0" Background="#f39c12" CornerRadius="8" 
                            Padding="15" Margin="0,5,5,0">
                        <StackPanel>
                            <TextBlock Text="警告" FontSize="12" Foreground="White" Opacity="0.9"/>
                            <TextBlock Name="WarningCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    
                    <Border Grid.Row="1" Grid.Column="1" Background="#95a5a6" CornerRadius="8" 
                            Padding="15" Margin="5,5,0,0">
                        <StackPanel>
                            <TextBlock Text="不适用" FontSize="12" Foreground="White" Opacity="0.9"/>
                            <TextBlock Name="NaCountText" Text="0" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <Border Grid.Row="2" BorderBrush="#dfe6e9" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Name="DetailPanel" Margin="15">
                            <TextBlock Text="请点击检查项查看详情" 
                                       HorizontalAlignment="Center" Foreground="#b2bec3" 
                                       FontSize="14" Margin="20"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,15,0,0">
            <TextBlock Name="StatusTextBlock" Text="就绪" VerticalAlignment="Center" Foreground="Gray"/>
            <ProgressBar Name="CheckProgressBar" Width="300" Height="20" Margin="20,0" IsVisible="False"/>
            <Button Name="ExportReportButton" Content="导出报告" Width="120" Height="35" 
                    Margin="5" Background="#74b9ff" Foreground="White" IsEnabled="False"/>
            <Button Name="CloseButton" Content="关闭" Width="100" Height="35" 
                    Margin="5"/>
        </StackPanel>
    </Grid>
</Window>