<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <RootNamespace>Tools.DeepTest</RootNamespace>
    <AssemblyName>DeepTest</AssemblyName>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);NETSDK1138;NU1701;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\NetSecurityScanner\src\NetSecurityScanner.Core\NetSecurityScanner.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\NetSecurityScanner\src\NetSecurityScanner.Core\Data\StaticVulnerabilityDatabase.json"
          Link="Data\StaticVulnerabilityDatabase.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
