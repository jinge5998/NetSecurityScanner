<Window x:Class="NetSecurityScanner.LicenseGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="授权码生成器 - NetSecurityScanner"
        Width="600" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="授权码生成器" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <TabControl Grid.Row="1">
            <!-- Tab 1: 生成授权码 -->
            <TabItem Header="生成授权码">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <GroupBox Header="生成配置" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="授权类型：" Width="80" VerticalAlignment="Center"/>
                                    <ComboBox Name="LicenseTypeComboBox" Width="200" SelectedIndex="0">
                                        <ComboBoxItem Content="试用版（5分钟）" Tag="TRIAL"/>
                                        <ComboBoxItem Content="1年期授权" Tag="YEAR1"/>
                                        <ComboBoxItem Content="2年期授权" Tag="YEAR2"/>
                                        <ComboBoxItem Content="永久授权" Tag="PERMANENT"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="机器码：" Width="80" VerticalAlignment="Center"/>
                                    <TextBox Name="MachineIdTextBox" Width="280" ToolTip="从主程序复制机器码粘贴到此处"/>
                                    <Button Name="PasteMachineIdButton" Content="📋 粘贴" Width="60" Height="22" Margin="5,0,0,0"
                                            Background="#9B59B6" Foreground="White" FontSize="10" Click="PasteMachineIdButton_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="生成数量：" Width="80" VerticalAlignment="Center"/>
                                    <TextBox Name="CountTextBox" Width="80" Text="1" VerticalAlignment="Center"/>
                                    <TextBlock Text="（1-100）" Foreground="#888" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Name="GenerateButton" Content="生成授权码" Width="120" Height="32" Background="#3498DB" Foreground="White" FontWeight="Bold" Click="GenerateButton_Click" Margin="0,0,10,0"/>
                            <Button Name="ExportButton" Content="导出到文件" Width="120" Height="32" Background="#27AE60" Foreground="White" Click="ExportButton_Click" Margin="0,0,10,0"/>
                            <Button Name="ClearButton" Content="清空" Width="80" Height="32" Click="ClearButton_Click"/>
                        </StackPanel>

                        <GroupBox Header="生成结果">
                            <TextBox Name="ResultTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="180" Background="#FAFAFA"/>
                        </GroupBox>

                        <TextBlock Name="StatusTextBlock" Text="就绪" FontSize="11" Foreground="#888" Margin="0,5,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 2: 批量发放 -->
            <TabItem Header="批量发放">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <GroupBox Header="批量配置" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="授权类型：" Width="80" VerticalAlignment="Center"/>
                                    <ComboBox Name="BatchLicenseTypeComboBox" Width="200" SelectedIndex="1">
                                        <ComboBoxItem Content="试用版（5分钟）" Tag="TRIAL"/>
                                        <ComboBoxItem Content="1年期授权" Tag="YEAR1"/>
                                        <ComboBoxItem Content="2年期授权" Tag="YEAR2"/>
                                        <ComboBoxItem Content="永久授权" Tag="PERMANENT"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="机器码列表（每行一个）" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBox Name="BatchMachineIdTextBox" Height="120" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                         ToolTip="每行输入一个机器码"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Name="ImportFileButton" Content="导入文件" Width="100" Height="28"
                                            Background="#9B59B6" Foreground="White" Click="ImportFileButton_Click" Margin="0,0,10,0"/>
                                    <Button Name="BatchPasteButton" Content="📋 粘贴" Width="70" Height="28"
                                            Background="#9B59B6" Foreground="White" Click="BatchPasteButton_Click" Margin="5,0,0,0"/>
                                    <TextBlock Text="支持txt文件，每行一个机器码" FontSize="10" Foreground="#888" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Name="BatchGenerateButton" Content="批量生成" Width="120" Height="32"
                                    Background="#E67E22" Foreground="White" FontWeight="Bold"
                                    Click="BatchGenerateButton_Click" Margin="0,0,10,0"/>
                            <Button Name="BatchExportButton" Content="导出结果" Width="100" Height="32"
                                    Background="#27AE60" Foreground="White" Click="BatchExportButton_Click" Margin="0,0,10,0"/>
                            <Button Name="BatchClearButton" Content="清空" Width="80" Height="32" Click="BatchClearButton_Click"/>
                        </StackPanel>

                        <GroupBox Header="批量生成结果">
                            <TextBox Name="BatchResultTextBox" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" Height="180" Background="#FAFAFA"/>
                        </GroupBox>

                        <TextBlock Name="BatchStatusTextBlock" Text="就绪" FontSize="11" Foreground="#888" Margin="0,5,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: 发放记录 -->
            <TabItem Header="发放记录">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="搜索机器码：" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox Name="SearchMachineIdTextBox" Width="200" Height="25" Margin="0,0,10,0"/>
                        <Button Name="SearchRecordButton" Content="搜索" Width="70" Height="28"
                                Background="#3498DB" Foreground="White" Click="SearchRecordButton_Click" Margin="0,0,10,0"/>
                        <Button Name="RefreshRecordButton" Content="刷新" Width="70" Height="28"
                                Click="RefreshRecordButton_Click" Margin="0,0,10,0"/>
                        <Button Name="DeleteRecordButton" Content="删除选中" Width="80" Height="28"
                                Background="#E74C3C" Foreground="White" Click="DeleteRecordButton_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="2" Name="RecordDataGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Extended"
                              AlternatingRowBackground="#F0F0F0" FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="机器码" Binding="{Binding MachineId}" Width="150"/>
                            <DataGridTextColumn Header="授权码" Binding="{Binding LicenseCode}" Width="200"/>
                            <DataGridTextColumn Header="授权类型" Binding="{Binding LicenseTypeDisplay}" Width="100"/>
                            <DataGridTextColumn Header="发放时间" Binding="{Binding IssuedTime, StringFormat='yyyy-MM-dd HH:mm:ss'}" Width="150"/>
                            <DataGridTextColumn Header="到期时间" Binding="{Binding ExpiryDisplay}" Width="150"/>
                            <DataGridTextColumn Header="备注" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="3" Name="RecordStatusTextBlock" Text="就绪" FontSize="11" Foreground="#888" Margin="0,5,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
